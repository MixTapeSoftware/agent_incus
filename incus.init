#!/bin/bash
set -euo pipefail

# init-incus-claude
# Creates an Incus container with Claude Code and a copy of your workspace.
#
# Default image: Ubuntu 24.04. Override with --image.

# ---------------------------------------------------------------------------
# Colors
# ---------------------------------------------------------------------------
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

# ---------------------------------------------------------------------------
# Logging helpers
# ---------------------------------------------------------------------------
log()  { echo -e "${GREEN}[+]${NC} $1"; }
warn() { echo -e "${YELLOW}[!]${NC} $1"; }
error(){ echo -e "${RED}[ERROR]${NC} $1" >&2; exit 1; }

# ---------------------------------------------------------------------------
# Usage
# ---------------------------------------------------------------------------
usage() {
  cat << EOF
Usage: $(basename "$0") [OPTIONS] <container-name>

Create an Incus container with a copy of a host directory as its workspace.
Default image is Ubuntu 24.04. Shows an interactive TUI to select plugins.

Options:
  -p, --path PATH           Host directory to copy in (default: current directory)
  -f, --from TEMPLATE       Launch from a saved template (shorthand for --image incus-init/TEMPLATE)
  -i, --image IMAGE         Base image override (default: ubuntu/24.04)
  -t, --template            Save container as a reusable local template (empty workspace)
  --colima-cpus N           Colima VM CPUs (default: 4, macOS only)
  --colima-memory N         Colima VM memory in GB (default: 8, macOS only)
  --colima-disk N           Colima VM disk in GB (default: 100, macOS only)
  --vm                      Provision a KVM virtual machine instead of a container
  --no-copy                 Start with an empty workspace instead of copying the host directory
  --vm-disk SIZE            VM root disk size (default: 20GiB)
  --vm-memory SIZE          VM memory (default: 4GiB)
  --vm-cpus N               VM vCPUs (default: 4)
  --ack-env                 Acknowledge .env files in the workspace (skip prompt)
  --no-proxy                Do not create a credential proxy for this container
  --proxy                   Create a credential proxy (the default)
  --no-tui                  Skip interactive plugin selector, use defaults
  --dry-run                 Show what would be done without doing it
  -h, --help                Show this help

Plugins are defined in the plugins/ directory (or ~/.local/share/agent_incus/plugins/
for user plugins). Some provide CLI flags
(e.g. --1pass, --gh-token, --entire) to pre-select them without the TUI.
Drop a new .sh file in plugins/ (or ~/.local/share/agent_incus/plugins/) to add your own.
EOF
  exit 1
}

# ---------------------------------------------------------------------------
# Packages — grouped by purpose for readability
# ---------------------------------------------------------------------------

# --- Ubuntu/Debian (apt) ---
APT_CORE="bash curl git wget sudo unzip tmux zsh jq"
APT_BUILD="build-essential pkg-config autoconf automake bison cmake re2c"
APT_DEVLIBS="libssl-dev libncurses-dev libreadline-dev zlib1g-dev libbz2-dev libsqlite3-dev libffi-dev liblzma-dev libyaml-dev libxml2-dev libxslt1-dev libcurl4-openssl-dev libonig-dev libzip-dev libpng-dev libjpeg-dev libfreetype6-dev libgd-dev unixodbc-dev libpq-dev"
APT_RUNTIME="gpg ca-certificates psmisc fontconfig fzf bat inotify-tools python3 python3-dev python3-pip python3-venv nodejs npm postgresql-client default-mysql-client redis-tools"

# ---------------------------------------------------------------------------
# Dependency checks
# ---------------------------------------------------------------------------
require_commands() {
  local missing=()
  for cmd in "$@"; do
    command -v "$cmd" >/dev/null 2>&1 || missing+=("$cmd")
  done
  if [[ ${#missing[@]} -gt 0 ]]; then
    error "Missing required commands: ${missing[*]}"
  fi
}

# ---------------------------------------------------------------------------
# Container readiness polling (replaces fragile sleep)
# ---------------------------------------------------------------------------
wait_for_container() {
  local name="$1" timeout="${2:-30}" elapsed=0
  local ready=0
  while [[ $elapsed -lt $timeout ]]; do
    if incus exec "$name" -- true >/dev/null 2>&1; then
      ready=1
      break
    fi
    sleep 1
    elapsed=$((elapsed + 1))
  done
  if [[ $ready -eq 0 ]]; then
    error "Container $name not ready after ${timeout}s"
  fi
  return 0
}

# Wait for networking inside the container (can lag behind boot/restart)
wait_for_network() {
  local name="$1" timeout="${2:-30}" elapsed=0
  log "Waiting for container networking..."
  local ready=0
  while [[ $elapsed -lt $timeout ]]; do
    if incus exec "$name" -- sh -c "getent hosts github.com >/dev/null 2>&1"; then
      ready=1
      break
    fi
    sleep 2
    elapsed=$((elapsed + 2))
  done
  if [[ $ready -eq 0 ]]; then
    error "Container $name has no network after ${timeout}s"
  fi
  return 0
}

# ---------------------------------------------------------------------------
# Exit trap — revoke build-time sudo, offer to delete the container on failure
# ---------------------------------------------------------------------------
BUILD_SUDO_GRANTED=0

# The user gets passwordless sudo while plugins install. Take it back.
revoke_build_sudo() {
  [[ "$BUILD_SUDO_GRANTED" == "1" ]] || return 0
  incus exec "$CONTAINER_NAME" -- rm -f "/etc/sudoers.d/$HOST_USER" </dev/null || return 1
  BUILD_SUDO_GRANTED=0
}

# An EXIT trap, not ERR: error() calls exit directly, which ERR never sees.
cleanup_on_exit() {
  local rc=$? reply="" owned="" attached="" entries=""
  trap - EXIT INT TERM HUP
  set +e
  if [[ -n "${CONTAINER_NAME:-}" ]] && incus info "$CONTAINER_NAME" >/dev/null 2>&1; then
    # Before the prompt: the container may be kept, or the prompt never answered.
    revoke_build_sudo || \
      warn "Could not revoke build-time sudo in '$CONTAINER_NAME'. Delete it: incus delete --force $CONTAINER_NAME"
    # A template build that failed after moving the Tailscale state out. A
    # failure is reported below, with the case where Incus cannot be reached.
    restore_tailscale_state || true
    if [[ $rc -ne 0 ]]; then
      echo ""
      warn "Script failed. Container '$CONTAINER_NAME' was partially created."
      # No answer (stdin closed) keeps the container: never delete unasked.
      read -rp "Delete it? [Y/n] " reply || reply="n"
      if [[ ! "$reply" =~ ^[Nn]$ ]]; then
        owned="$(incus config get "$CONTAINER_NAME" user.incs.owned-proxy 2>/dev/null)"
        attached="$(proxy_attached_to "$CONTAINER_NAME")"
        entries="$(proxy_entry_names "$CONTAINER_NAME")"
        if incus delete --force "$CONTAINER_NAME"; then
          log "Deleted $CONTAINER_NAME"
          proxy_after_delete "$CONTAINER_NAME" "$attached" "$entries"
          proxy_delete_owned "$CONTAINER_NAME" "$owned" || \
            warn "Could not remove owned proxy '$owned'. Clean up with: incs proxy delete $owned"
        else
          warn "Could not delete '$CONTAINER_NAME'; its proxy was kept"
        fi
      else
        warn "Container left in place. Clean up manually with: incs -d $CONTAINER_NAME"
      fi
    fi
  fi
  # Never leave the host copy of a node key unmentioned, even when Incus could
  # not be asked about the container at all.
  if [[ -n "${TS_STATE_BACKUP:-}" && -f "$TS_STATE_BACKUP" ]]; then
    warn "Tailscale state for '${CONTAINER_NAME:-}' is in $TS_STATE_BACKUP (it holds the node key: keep it private, or delete it).
  To restore it (start the container first if it is stopped: incus start ${CONTAINER_NAME:-}):
    incus exec ${CONTAINER_NAME:-} -- tar -C /var/lib -xf - < $TS_STATE_BACKUP"
  fi
  exit "$rc"
}

# ---------------------------------------------------------------------------
# Defaults
# ---------------------------------------------------------------------------
WORKSPACE_PATH="$PWD"
CONTAINER_WORKSPACE="/workspace"
BASE_IMAGE="images:ubuntu/24.04"
CONTAINER_NAME=""
DRY_RUN=0
NO_TUI=0
SKIP_CREDENTIAL_PROXY=0
SAVE_TEMPLATE=0
TS_STATE_BACKUP=""
ACK_ENV=0
IS_VM=0
NO_COPY=0
VM_OPT_SET=0
VM_DISK="20GiB"
VM_MEMORY="4GiB"
VM_CPUS="4"
READY_TIMEOUT=30

# ---------------------------------------------------------------------------
# Plugin discovery — reads built-in plugins/*.sh plus user plugins from
# ${XDG_DATA_HOME:-~/.local/share}/agent_incus/plugins/*.sh
# ---------------------------------------------------------------------------
SCRIPT_DIR="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")" && pwd)"
BUILTIN_PLUGINS_DIR="$SCRIPT_DIR/plugins"
USER_PLUGINS_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/agent_incus/plugins"

# Parallel arrays (bash 3.2 compatible — macOS /bin/bash has no associative arrays)
_P_ID=() _P_NAME=() _P_DESC=() _P_FILE=() _P_SELECTED=()
_P_FLAGS=() _P_FLAG_IDS=()   # parallel: _P_FLAGS[i] -> _P_FLAG_IDS[i]
PLUGIN_COUNT=0

# Find the slot index for a plugin ID; prints index or returns 1.
_plugin_slot() {
  local target="$1" i
  for ((i=0; i<PLUGIN_COUNT; i++)); do
    [[ "${_P_ID[$i]}" == "$target" ]] && { echo "$i"; return 0; }
  done
  return 1
}

selected_get() {
  local slot
  slot=$(_plugin_slot "$1") || { echo 0; return; }
  echo "${_P_SELECTED[$slot]:-0}"
}

selected_set() {
  local slot
  slot=$(_plugin_slot "$1") || return 1
  _P_SELECTED[$slot]="$2"
}

flag_to_id() {
  local target="$1" i
  for ((i=0; i<${#_P_FLAGS[@]}; i++)); do
    [[ "${_P_FLAGS[$i]}" == "$target" ]] && { echo "${_P_FLAG_IDS[$i]}"; return 0; }
  done
  return 1
}

# Discover built-in plugins first, then user plugins. On PLUGIN_ID collision
# the user plugin overrides (logged). Final order is sorted A-Z by PLUGIN_NAME
# below — drives both TUI display and install order.
for _dir in "$BUILTIN_PLUGINS_DIR" "$USER_PLUGINS_DIR"; do
  [[ -d "$_dir" ]] || continue
  for _f in "$_dir"/*.sh; do
    [[ -f "$_f" ]] || continue
    _meta=$(bash -c '
      PLUGIN_ID="" PLUGIN_NAME="" PLUGIN_DESC="" PLUGIN_DEFAULT=0
      PLUGIN_CLI_FLAGS="" PLUGIN_NEEDS_PROMPT=0 PLUGIN_RUN_ON_LAUNCH=0
      source "$1" 2>/dev/null
      printf "%s\n%s\n%s\n%s\n%s\n%s\n%s\n" \
        "$PLUGIN_ID" "$PLUGIN_NAME" "$PLUGIN_DESC" "$PLUGIN_DEFAULT" \
        "$PLUGIN_CLI_FLAGS" "$PLUGIN_NEEDS_PROMPT" "$PLUGIN_RUN_ON_LAUNCH"
    ' _ "$_f")

    IFS=$'\n' read -d '' -r _pid _pname _pdesc _pdefault _pcli _pprompt _plaunch <<< "$_meta" || true
    [[ -z "$_pid" ]] && continue

    if _existing=$(_plugin_slot "$_pid"); then
      echo "[!] Plugin '$_pid' from $_f overrides ${_P_FILE[$_existing]}" >&2
      _P_NAME[$_existing]="$_pname"
      _P_DESC[$_existing]="$_pdesc"
      _P_FILE[$_existing]="$_f"
      _P_SELECTED[$_existing]="${_pdefault:-0}"
      for _flag in $_pcli; do
        _P_FLAGS+=("$_flag")
        _P_FLAG_IDS+=("$_pid")
      done
      continue
    fi

    _i=$PLUGIN_COUNT
    _P_ID[$_i]="$_pid"
    _P_NAME[$_i]="$_pname"
    _P_DESC[$_i]="$_pdesc"
    _P_FILE[$_i]="$_f"
    _P_SELECTED[$_i]="${_pdefault:-0}"

    for _flag in $_pcli; do
      _P_FLAGS+=("$_flag")
      _P_FLAG_IDS+=("$_pid")
    done

    PLUGIN_COUNT=$((_i + 1))
  done
done
unset _dir _f _meta _i _pid _pname _pdesc _pdefault _pcli _pprompt _plaunch _flag _existing

# Sort plugins by PLUGIN_NAME, case-insensitive A-Z (stable).
if (( PLUGIN_COUNT > 1 )); then
  _sort_lines=""
  for ((_i=0; _i<PLUGIN_COUNT; _i++)); do
    _sort_lines+="${_P_NAME[$_i]}"$'\t'"$_i"$'\n'
  done
  _new_ID=() _new_NAME=() _new_DESC=() _new_FILE=() _new_SELECTED=()
  while IFS=$'\t' read -r _name _slot; do
    _new_ID+=("${_P_ID[$_slot]}")
    _new_NAME+=("${_P_NAME[$_slot]}")
    _new_DESC+=("${_P_DESC[$_slot]}")
    _new_FILE+=("${_P_FILE[$_slot]}")
    _new_SELECTED+=("${_P_SELECTED[$_slot]}")
  done < <(printf '%s' "$_sort_lines" | sort -f -s -t$'\t' -k1,1)
  _P_ID=("${_new_ID[@]}")
  _P_NAME=("${_new_NAME[@]}")
  _P_DESC=("${_new_DESC[@]}")
  _P_FILE=("${_new_FILE[@]}")
  _P_SELECTED=("${_new_SELECTED[@]}")
  unset _new_ID _new_NAME _new_DESC _new_FILE _new_SELECTED _sort_lines _name _slot _i
fi

# Build the PLUGINS array the TUI expects (id:name:desc:default)
PLUGINS=()
for ((_i=0; _i<PLUGIN_COUNT; _i++)); do
  PLUGINS+=("${_P_ID[$_i]}:${_P_NAME[$_i]}:${_P_DESC[$_i]}:${_P_SELECTED[$_i]}")
done
unset _i

# ---------------------------------------------------------------------------
# TUI plugin selector
# ---------------------------------------------------------------------------
show_tui() {
  local count=${#PLUGINS[@]}
  local cursor=0
  local key seq marker id name desc default

  tput civis 2>/dev/null || true
  trap 'tput cnorm 2>/dev/null || true' RETURN

  while true; do
    printf '\033[2J\033[H'
    echo -e "${GREEN}+------------------------------------------------------+${NC}"
    echo -e "${GREEN}|${NC}  Select plugins to install                           ${GREEN}|${NC}"
    echo -e "${GREEN}+------------------------------------------------------+${NC}"
    echo -e "${GREEN}|${NC}  Up/Down or j/k: navigate   Space: toggle   Enter: go${GREEN}|${NC}"
    echo -e "${GREEN}|${NC}  q: quit                                             ${GREEN}|${NC}"
    echo -e "${GREEN}+------------------------------------------------------+${NC}"
    echo ""

    for ((i=0; i<count; i++)); do
      IFS=: read -r id name desc default <<< "${PLUGINS[$i]}"
      marker="[ ]"
      [[ "${_P_SELECTED[$i]}" == "1" ]] && marker="[x]"

      if [[ $i -eq $cursor ]]; then
        printf "  \033[7m %s %-24s %s \033[0m\n" "$marker" "$name" "$desc"
      else
        printf "   %s %-24s %s\n" "$marker" "$name" "$desc"
      fi
    done

    echo ""

    IFS= read -rsn1 key

    case "$key" in
      $'\x1b')
        IFS= read -rsn2 -t 1 seq || continue
        case "$seq" in
          '[A') cursor=$(( (cursor - 1 + count) % count )) ;;
          '[B') cursor=$(( (cursor + 1) % count )) ;;
        esac
        ;;
      'k') cursor=$(( (cursor - 1 + count) % count )) ;;
      'j') cursor=$(( (cursor + 1) % count )) ;;
      ' ')
        if [[ "${_P_SELECTED[$cursor]}" == "1" ]]; then
          _P_SELECTED[$cursor]=0
        else
          _P_SELECTED[$cursor]=1
        fi
        ;;
      ''|$'\n') break ;;
      'q')
        tput cnorm 2>/dev/null || true
        echo "Aborted."
        exit 1
        ;;
    esac
  done

  tput cnorm 2>/dev/null || true
  printf '\033[2J\033[H'
}

# ---------------------------------------------------------------------------
# Core install functions (not plugins)
# ---------------------------------------------------------------------------
install_ohmyzsh() {
  log "Installing Oh My Zsh..."
  incus exec "$CONTAINER_NAME" -- su - "$HOST_USER" -c 'bash -s' <<'ZSHEOF'
  set -e
  sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended

  sed -i 's/^ZSH_THEME=".*"/ZSH_THEME="dpoggi"/' ~/.zshrc

  # Add [incus] prefix to prompt
  cat >> ~/.zshrc <<'RCBLOCK'

# [incus] prompt prefix
PROMPT="%{$fg[cyan]%}[incus]%{$reset_color%} ${PROMPT%»*}%{$reset_color%}"$'\n'"» "
RCBLOCK

  # Plugins
  git clone https://github.com/zsh-users/zsh-autosuggestions \
    ${ZSH_CUSTOM:-~/.oh-my-zsh/custom}/plugins/zsh-autosuggestions
  sed -i 's/^plugins=(git)/plugins=(git zsh-autosuggestions)/' ~/.zshrc
ZSHEOF
}


# ---------------------------------------------------------------------------
# Component dispatch helpers
# ---------------------------------------------------------------------------
# Source a plugin file and call its functions. We iterate _P_FILE
# (sorted A-Z by PLUGIN_NAME during discovery) so install order matches the
# TUI display order and is identical across hosts.
#
# Sourced plugin files do not overwrite metadata vars or functions they don't
# declare, so without an explicit reset, values leak from one plugin to the
# next (e.g. PLUGIN_NEEDS_PROMPT=1 and plugin_prompt from 1pass would carry
# over to a later plugin that selected without one).
_reset_plugin_state() {
  PLUGIN_ID="" PLUGIN_NAME="" PLUGIN_DESC="" PLUGIN_DEFAULT=0
  PLUGIN_CLI_FLAGS="" PLUGIN_NEEDS_PROMPT=0 PLUGIN_RUN_ON_LAUNCH=0
  PLUGIN_REQUIRES=""
  unset -f plugin_prompt plugin_is_installed plugin_install plugin_on_launch 2>/dev/null || true
}

_run_plugin_prompts() {
  local i
  for ((i=0; i<PLUGIN_COUNT; i++)); do
    _reset_plugin_state
    source "${_P_FILE[$i]}"
    [[ "$(selected_get "$PLUGIN_ID")" != "1" ]] && continue
    [[ "${PLUGIN_NEEDS_PROMPT:-0}" != "1" ]] && continue
    plugin_prompt
  done
}

# Run a plugin hook in a subshell so one plugin's failure can't kill the whole
# build. Under plain set -e, a failing plugin_install aborted the script and
# silently skipped every plugin sorted after it — e.g. a Playwright install
# failure meant Claude Code, GitHub Auth, and Tailscale never ran. The subshell
# re-enables set -e so the plugin itself still stops at its first error; the
# parent records the failure and moves on. Failures are listed in the summary.
FAILED_PLUGIN_NAMES=()
_run_plugin_hook() {
  local hook="$1" rc=0
  set +e
  ( set -e; "$hook" )
  rc=$?
  set -e
  if [[ $rc -ne 0 ]]; then
    warn "$PLUGIN_NAME: $hook failed (exit $rc) — continuing with remaining plugins"
    FAILED_PLUGIN_NAMES+=("$PLUGIN_NAME")
  fi
}

_plugin_failed() {
  local n
  for n in ${FAILED_PLUGIN_NAMES[@]+"${FAILED_PLUGIN_NAMES[@]}"}; do
    [[ "$n" == "$1" ]] && return 0
  done
  return 1
}

_run_plugin_installs() {
  local from_template="$1"
  local i
  for ((i=0; i<PLUGIN_COUNT; i++)); do
    _reset_plugin_state
    source "${_P_FILE[$i]}"
    [[ "$(selected_get "$PLUGIN_ID")" != "1" ]] && continue

    if [[ "$from_template" == "1" ]]; then
      # Template launch dispatch:
      #   not installed                     -> plugin_install (added on top of template)
      #   installed + NEEDS_PROMPT=1        -> plugin_install (re-apply prompted token/config)
      #   installed + RUN_ON_LAUNCH=1       -> plugin_on_launch (symlinks/config hooks)
      #   otherwise                         -> skip (already baked in)
      local _installed=0
      if declare -F plugin_is_installed >/dev/null && plugin_is_installed; then
        _installed=1
      fi
      if [[ "$_installed" == "0" ]]; then
        _run_plugin_hook plugin_install
      elif [[ "${PLUGIN_NEEDS_PROMPT:-0}" == "1" ]]; then
        _run_plugin_hook plugin_install
      elif [[ "${PLUGIN_RUN_ON_LAUNCH:-0}" == "1" ]] && declare -F plugin_on_launch >/dev/null; then
        _run_plugin_hook plugin_on_launch
      fi
    else
      # Fresh install
      if declare -F plugin_is_installed >/dev/null && plugin_is_installed; then
        log "$PLUGIN_NAME already installed, skipping"
        continue
      fi
      _run_plugin_hook plugin_install
    fi
  done
}

# Tailscale keeps the node key, and the certificates `tailscale serve` obtained
# for the node, under /var/lib/tailscale. Baked into a template, every launch
# would come up as this machine with its tailnet access. So the directory is
# moved out to a private file while the image is published, then put back.
stash_tailscale_state() {
  # An exec error must not read as "no state": that would publish the key.
  local state
  state="$(incus exec "$CONTAINER_NAME" -- sh -c 'test -d /var/lib/tailscale && echo yes || echo no' </dev/null)" || state=""
  case "$state" in
    no)  return 0 ;;
    yes) ;;
    *)   error "Could not check $CONTAINER_NAME for Tailscale state. No template saved: it might carry the node key." ;;
  esac
  log "Removing the Tailscale node identity from the image..."
  # A tailscaled still running could write the state back before publish. Only
  # an explicit inactive/failed counts: a query that fails proves nothing.
  incus exec "$CONTAINER_NAME" -- systemctl stop tailscaled 2>/dev/null </dev/null || true
  local ts
  ts="$(incus exec "$CONTAINER_NAME" -- systemctl is-active tailscaled 2>/dev/null </dev/null)" || true
  [[ "$ts" == "inactive" || "$ts" == "failed" ]] || \
    error "Could not stop tailscaled in $CONTAINER_NAME (state: ${ts:-unknown}). No template saved: it could write the node key back."
  TS_STATE_BACKUP="$(mktemp "${XDG_RUNTIME_DIR:-/tmp}/incs-tailscale.XXXXXX")"
  incus exec "$CONTAINER_NAME" -- tar -C /var/lib -cf - tailscale > "$TS_STATE_BACKUP"
  incus exec "$CONTAINER_NAME" -- rm -rf /var/lib/tailscale
}

# Idempotent: nothing stashed, or already restored, is a success.
restore_tailscale_state() {
  [[ -n "${TS_STATE_BACKUP:-}" && -f "$TS_STATE_BACKUP" ]] || return 0
  # From the exit trap, publish or start may have failed with the container
  # stopped. Start it and wait, without error(): that would exit the trap.
  local status elapsed=0
  status="$(incus list "^${CONTAINER_NAME}$" --format csv --columns s 2>/dev/null)"
  if [[ "$status" != "RUNNING" ]]; then
    incus start "$CONTAINER_NAME" >/dev/null 2>&1 || return 1
  fi
  until incus exec "$CONTAINER_NAME" -- true </dev/null >/dev/null 2>&1; do
    (( elapsed++ < ${READY_TIMEOUT:-30} )) || return 1
    sleep 1
  done
  # tailscaled came back up at boot with a fresh, logged-out state; replace it.
  # If it keeps running it can overwrite the restored state, so it must stop.
  incus exec "$CONTAINER_NAME" -- systemctl stop tailscaled 2>/dev/null </dev/null || true
  local ts
  ts="$(incus exec "$CONTAINER_NAME" -- systemctl is-active tailscaled 2>/dev/null </dev/null)" || true
  [[ "$ts" == "inactive" || "$ts" == "failed" ]] || return 1
  incus exec "$CONTAINER_NAME" -- tar -C /var/lib -xf - < "$TS_STATE_BACKUP" || return 1
  # The state is back in place, so the host copy of the node key can go. This
  # runs under || (errexit off), so a failed delete is checked here: keep the
  # path so the exit trap reports the file, and return failure.
  local kept=0
  if rm -f "$TS_STATE_BACKUP"; then TS_STATE_BACKUP=""; else kept=1; fi
  incus exec "$CONTAINER_NAME" -- systemctl start tailscaled </dev/null || \
    warn "Tailscale state is restored in $CONTAINER_NAME, but tailscaled did not start. Start it: incus exec $CONTAINER_NAME -- systemctl start tailscaled"
  return "$kept"
}

# ---------------------------------------------------------------------------
# Copy the workspace in. The host directory is copied once and never mounted:
# nothing the container writes reaches the host, which sees only the work that
# leaves through git.
# ---------------------------------------------------------------------------
copy_workspace() {
  local present existing=""
  # A template built before templates were emptied carries a workspace owned
  # by whoever built it. If our UID differs those files are unwritable (git
  # commit fails on .git/index.lock), so re-own them rather than error. Files
  # in a workspace that did not come from a template are a mistake: stop.
  # An exec error must not read as "empty": files could be copied over.
  present="$(incus exec "$CONTAINER_NAME" -- sh -c "test -d '$CONTAINER_WORKSPACE' && echo yes || echo no" </dev/null)" || present=""
  case "$present" in
    no)  ;;
    yes) existing="$(incus exec "$CONTAINER_NAME" -- ls -A "$CONTAINER_WORKSPACE" </dev/null)" || \
           error "Could not list $CONTAINER_WORKSPACE in $CONTAINER_NAME" ;;
    *)   error "Could not check $CONTAINER_WORKSPACE in $CONTAINER_NAME" ;;
  esac
  if [[ -n "$existing" ]]; then
    [[ "$FROM_BASE_IMAGE" == "1" ]] || \
      error "$CONTAINER_WORKSPACE is not empty inside the container: $BASE_IMAGE already has files there."
    log "Reusing workspace from template; re-owning to $HOST_USER..."
  else
    incus exec "$CONTAINER_NAME" -- mkdir -p "$CONTAINER_WORKSPACE" </dev/null
    # The working tree as it is on disk, .git and uncommitted work included.
    # Extracted as the container's root (--no-same-owner), then handed to the
    # user. Template builds and --no-copy start empty.
    if [[ "$SAVE_TEMPLATE" != "1" && "$NO_COPY" != "1" ]]; then
      log "Copying $WORKSPACE_PATH into $CONTAINER_WORKSPACE (includes .git)..."
      tar -C "$WORKSPACE_PATH" -cf - . \
        | incus exec "$CONTAINER_NAME" -- tar --no-same-owner -C "$CONTAINER_WORKSPACE" -xf -
    fi
  fi
  incus exec "$CONTAINER_NAME" -- chown -R "$HOST_USER:$HOST_USER" "$CONTAINER_WORKSPACE" </dev/null
  # Git refuses a repository it considers someone else's ("dubious ownership").
  incus exec "$CONTAINER_NAME" -- su - "$HOST_USER" -c \
    "git config --global --add safe.directory '$CONTAINER_WORKSPACE' 2>/dev/null || true"
}

save_template() {
  local alias="incus-init/$CONTAINER_NAME"
  log "Saving as local template: $alias (stored in local Incus image store)"

  # Read /etc/hosts before changing anything: its proxy lines must not reach
  # the image, so a template is not saved if they cannot be found.
  local hosts_file saved_hosts
  hosts_file="$(incus file pull -q "$CONTAINER_NAME/etc/hosts" - 2>/dev/null)" || \
    error "Could not read /etc/hosts in $CONTAINER_NAME. No template saved: it might send hosts to a credential proxy."

  # Save token lines from .zshenv, then strip them so they don't leak into the
  # image. Lines written by a credential proxy attach (marked "# incs-proxy")
  # go too: a placeholder and proxy address belong to one container, and a
  # container launched from the template must not inherit them.
  local saved_tokens
  saved_tokens=$(incus exec "$CONTAINER_NAME" -- su - "$HOST_USER" -c \
    "grep -E '^export (GH_TOKEN|OP_SERVICE_ACCOUNT_TOKEN)=|# incs-proxy(:[a-z0-9-]+)?\$' ~/.zshenv 2>/dev/null || true")

  log "Scrubbing secrets from image..."
  incus exec "$CONTAINER_NAME" -- su - "$HOST_USER" -c \
    "sed -E -i '/^export OP_SERVICE_ACCOUNT_TOKEN=/d; /^export GH_TOKEN=/d; /# incs-proxy(:[a-z0-9-]+)?\$/d' ~/.zshenv 2>/dev/null || true"

  # The same goes for the /etc/hosts lines an attach adds: they send API hosts
  # to one proxy's address.
  saved_hosts="$(grep -E ' # incs-proxy:[a-z0-9-]+$' <<< "$hosts_file" || true)"
  if [[ -n "$saved_hosts" ]]; then
    { grep -vE ' # incs-proxy:[a-z0-9-]+$' <<< "$hosts_file" || true; } \
      | incus file push -q --uid 0 --gid 0 --mode 0644 - "$CONTAINER_NAME/etc/hosts"
  fi

  # Empty the workspace before publishing. A template is a reusable *provisioned
  # base* (packages, mise, shell, tools) — not a frozen copy of one repo. Baking
  # the copy in also drags the builder's UID into every future container, where
  # it surfaces as the overflow UID 65534 (nobody). Leaving /workspace empty lets
  # each launch populate it fresh, owned by the launching user. The guard keeps a
  # misresolved CONTAINER_WORKSPACE from ever expanding to `rm -rf /`.
  if [[ -n "$CONTAINER_WORKSPACE" && "$CONTAINER_WORKSPACE" != "/" ]]; then
    log "Emptying workspace so the template stays a clean base..."
    incus exec "$CONTAINER_NAME" -- rm -rf "$CONTAINER_WORKSPACE"
  fi

  stash_tailscale_state

  log "Stopping container for snapshot..."
  incus stop "$CONTAINER_NAME"
  incus publish "$CONTAINER_NAME" --alias "$alias"
  log "Starting container back up..."
  incus start "$CONTAINER_NAME"
  wait_for_container "$CONTAINER_NAME" "$READY_TIMEOUT"

  restore_tailscale_state || error "Could not restore the Tailscale state in $CONTAINER_NAME from $TS_STATE_BACKUP"

  # Restore saved tokens to the running container
  if [[ -n "$saved_tokens" ]]; then
    incus exec "$CONTAINER_NAME" -- su - "$HOST_USER" -c "cat >> ~/.zshenv <<'TOKENS'
$saved_tokens
TOKENS"
  fi
  if [[ -n "$saved_hosts" ]]; then
    { incus file pull -q "$CONTAINER_NAME/etc/hosts" -; printf '%s\n' "$saved_hosts"; } \
      | incus file push -q --uid 0 --gid 0 --mode 0644 - "$CONTAINER_NAME/etc/hosts"
  fi

  wait_for_network "$CONTAINER_NAME" "$READY_TIMEOUT"
  log "Saved template: $alias"
  echo "  Reuse with: $(basename "$0") --from $CONTAINER_NAME <new-name>"
}

# ---------------------------------------------------------------------------
# Parse arguments
# ---------------------------------------------------------------------------
while [[ $# -gt 0 ]]; do
  case "$1" in
    -p|--path)       [[ $# -lt 2 ]] && error "$1 requires an argument"; WORKSPACE_PATH="$2"; shift 2 ;;
    -f|--from)       [[ $# -lt 2 ]] && error "$1 requires an argument"; BASE_IMAGE="incus-init/$2"; shift 2 ;;
    -i|--image)      [[ $# -lt 2 ]] && error "$1 requires an argument"; BASE_IMAGE="$2"; shift 2 ;;
    -t|--template) SAVE_TEMPLATE=1; shift ;;
    --colima-cpus)   [[ $# -lt 2 ]] && error "$1 requires an argument"; COLIMA_CPUS="$2"; shift 2 ;;
    --colima-memory) [[ $# -lt 2 ]] && error "$1 requires an argument"; COLIMA_MEMORY="$2"; shift 2 ;;
    --colima-disk)   [[ $# -lt 2 ]] && error "$1 requires an argument"; COLIMA_DISK="$2"; shift 2 ;;
    --vm)            IS_VM=1; shift ;;
    --no-copy)       NO_COPY=1; shift ;;
    --vm-disk)       [[ $# -lt 2 ]] && error "$1 requires an argument"; VM_DISK="$2"; VM_OPT_SET=1; shift 2 ;;
    --vm-memory)     [[ $# -lt 2 ]] && error "$1 requires an argument"; VM_MEMORY="$2"; VM_OPT_SET=1; shift 2 ;;
    --vm-cpus)       [[ $# -lt 2 ]] && error "$1 requires an argument"; VM_CPUS="$2"; VM_OPT_SET=1; shift 2 ;;
    --ack-env)       ACK_ENV=1; shift ;;
    --no-tui)        NO_TUI=1; shift ;;
    --no-proxy)      SKIP_CREDENTIAL_PROXY=1; shift ;;
    --proxy)         SKIP_CREDENTIAL_PROXY=0; shift ;;
    --dry-run)       DRY_RUN=1; shift ;;
    -h|--help)       usage ;;
    -*)
      # Check if it's a plugin CLI flag
      if _flag_id=$(flag_to_id "$1"); then
        selected_set "$_flag_id" 1
        shift
      else
        error "Unknown option: $1"
      fi
      ;;
    *)               CONTAINER_NAME="$1"; shift ;;
  esac
done

# ---------------------------------------------------------------------------
# macOS pre-flight (noop on Linux)
# ---------------------------------------------------------------------------
source "$SCRIPT_DIR/incus.macos.setup"
source "$SCRIPT_DIR/incus.envscan"
# read_secret / read_value, for plugin prompts that take pasted values.
source "$SCRIPT_DIR/incus.prompt"
# shellcheck source=incus.profile
source "$SCRIPT_DIR/incus.profile"
# shellcheck source=incus.proxy
source "$SCRIPT_DIR/incus.proxy"

# ---------------------------------------------------------------------------
# Validate
# ---------------------------------------------------------------------------
require_commands incus curl sudo realpath

[[ -z "$CONTAINER_NAME" ]] && { warn "Container name required"; echo ""; usage; }
[[ ! "$CONTAINER_NAME" =~ ^[a-zA-Z][a-zA-Z0-9-]*$ ]] && error "Invalid container name: must start with a letter, only letters/digits/hyphens"
incus info "$CONTAINER_NAME" >/dev/null 2>&1 && error "Container '$CONTAINER_NAME' already exists"

if [[ "$SKIP_CREDENTIAL_PROXY" == "0" ]]; then
  [[ ${#CONTAINER_NAME} -le 57 ]] || error "Container name is too long for a -proxy suffix; shorten it or use --no-proxy"
  proxy_instance_exists "$CONTAINER_NAME-proxy" && \
    error "Instance '$CONTAINER_NAME-proxy' already exists; choose another container name or use --no-proxy"
fi

# VM flag validation. VM-only options are meaningless for containers: warn and
# ignore rather than error, so an errant flag never blocks a build.
if [[ "$IS_VM" == "1" ]]; then
  [[ "$VM_CPUS" =~ ^[1-9][0-9]*$ ]] || error "--vm-cpus must be a positive integer (got: $VM_CPUS)"
  READY_TIMEOUT=90
elif [[ "$VM_OPT_SET" == "1" ]]; then
  warn "VM options (--vm-disk/--vm-memory/--vm-cpus) are ignored without --vm"
fi

HOST_USER="$(whoami)"
HOST_UID="$(id -u)"
HOST_GID="$(id -g)"

# ---------------------------------------------------------------------------
# Resolve the workspace path and warn about .env files: they are copied in with
# everything else. Template builds and --no-copy start empty, so nothing is
# exposed and the host path is never used.
# ---------------------------------------------------------------------------
ENV_FILES_LIST=""
if [[ "$SAVE_TEMPLATE" != "1" && "$NO_COPY" != "1" ]]; then
  WORKSPACE_PATH="${WORKSPACE_PATH/#\~/$HOME}"
  WORKSPACE_PATH="$(realpath "$WORKSPACE_PATH")"
  [[ ! -d "$WORKSPACE_PATH" ]] && error "Directory not found: $WORKSPACE_PATH"

  ENV_FILES_LIST="$(detect_env_files "$WORKSPACE_PATH")"
  if [[ -n "$ENV_FILES_LIST" ]]; then
    echo ""
    while IFS= read -r _line; do
      echo -e "${YELLOW}${_line}${NC}" >&2
    done < <(printf '%s\n' "$ENV_FILES_LIST" | format_env_warning_lines "$WORKSPACE_PATH")
    confirm_env_acknowledgement "$ACK_ENV"
  fi
fi

# ---------------------------------------------------------------------------
# TUI plugin selector
# ---------------------------------------------------------------------------
if [[ "$NO_TUI" == "0" ]]; then
  show_tui
fi

# Resolve plugin requirements. A selected plugin may declare
# PLUGIN_REQUIRES="<id> <id>..."; those plugins are auto-selected here — after
# all user selection input (CLI flags + TUI) but before the prompt loop, so a
# required plugin's own prompt still fires. Resolution is single-level: a
# required plugin's own requirements are not chased.
for ((_i=0; _i<PLUGIN_COUNT; _i++)); do
  [[ "${_P_SELECTED[$_i]}" == "1" ]] || continue
  _reset_plugin_state
  source "${_P_FILE[$_i]}"
  for _req in $PLUGIN_REQUIRES; do
    [[ "$(selected_get "$_req")" == "1" ]] && continue
    if selected_set "$_req" 1; then
      log "Auto-selected '$_req' (required by ${_P_NAME[$_i]})"
    else
      warn "${_P_NAME[$_i]} requires unknown plugin '$_req' — ignored"
    fi
  done
done
unset _req

# Echo the final selection before acting on it. In the TUI, space toggles and
# Enter launches — a mis-keyed toggle otherwise fails silently: the plugin's
# prompt and install just never happen, with nothing on screen to say why.
_sel_names=""
for ((_i=0; _i<PLUGIN_COUNT; _i++)); do
  [[ "${_P_SELECTED[$_i]}" == "1" ]] && _sel_names+="${_sel_names:+, }${_P_NAME[$_i]}"
done
log "Plugins selected: ${_sel_names:-none}"
unset _i _sel_names

# ---------------------------------------------------------------------------
# Component prompts — called once, after TUI decision
# ---------------------------------------------------------------------------
_run_plugin_prompts

# ---------------------------------------------------------------------------
# Dry-run summary
# ---------------------------------------------------------------------------
if [[ "$DRY_RUN" == "1" ]]; then
  echo ""
  echo "========================================"
  echo "DRY RUN — nothing will be created"
  echo "========================================"
  echo "Container:   $CONTAINER_NAME"
  echo "Image:       $BASE_IMAGE"
  echo "User:        $HOST_USER (UID:$HOST_UID GID:$HOST_GID)"
  if [[ "$IS_VM" == "1" ]]; then
    echo "Type:        VM (disk=$VM_DISK memory=$VM_MEMORY cpus=$VM_CPUS)"
  else
    echo "Type:        container"
  fi
  if [[ "$SAVE_TEMPLATE" == "1" ]]; then
    echo "Workspace:   empty (template base)"
  elif [[ "$NO_COPY" == "1" ]]; then
    echo "Workspace:   empty $CONTAINER_WORKSPACE (--no-copy)"
  else
    echo "Workspace:   copy $WORKSPACE_PATH into $CONTAINER_WORKSPACE (incl .git)"
  fi
  if [[ -n "$ENV_FILES_LIST" ]]; then
    _env_count="$(printf '%s\n' "$ENV_FILES_LIST" | wc -l | tr -d ' ')"
    echo ".env files exposed: $_env_count"
    _shown=0
    while IFS= read -r _envpath; do
      if (( _shown >= 20 )); then
        echo "  …and $(( _env_count - 20 )) more"
        break
      fi
      echo "  ${_envpath#$WORKSPACE_PATH/}"
      _shown=$(( _shown + 1 ))
    done <<< "$ENV_FILES_LIST"
  fi
  echo ""
  echo "Selected plugins:"
  for entry in "${PLUGINS[@]}"; do
    IFS=: read -r id name desc default <<< "$entry"
    if [[ "$(selected_get "$id")" == "1" ]]; then
      echo "  [x] $name"
    else
      echo "  [ ] $name"
    fi
  done
  echo ""
  if [[ "$SKIP_CREDENTIAL_PROXY" == "1" ]]; then
    echo "Proxy:       none"
  elif [[ "$(selected_get gh-auth)" == "1" ]]; then
    echo "Proxy:       $CONTAINER_NAME-proxy (github, from GitHub Auth)"
  else
    echo "Proxy:       $CONTAINER_NAME-proxy (empty)"
  fi
  echo "Template:    $( [[ "$SAVE_TEMPLATE" == "1" ]] && echo "incus-init/$CONTAINER_NAME" || echo no )"
  echo "========================================"
  exit 0
fi

# ---------------------------------------------------------------------------
# From here on, real work — set up cleanup trap
# ---------------------------------------------------------------------------
trap cleanup_on_exit EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

ensure_profile

# ---------------------------------------------------------------------------
# Detect if launching from a local base image (skip provisioning)
# ---------------------------------------------------------------------------
FROM_BASE_IMAGE=0
if [[ "$BASE_IMAGE" != images:* ]]; then
  FROM_BASE_IMAGE=1
  if ! incus image info "$BASE_IMAGE" &>/dev/null; then
    error "Template image '$BASE_IMAGE' not found. Run 'incus image list' to see available templates."
  fi
  # Local templates are single-type: a VM template can't launch as a container
  # and vice-versa. Catch the mismatch here with a clear message instead of
  # letting Incus emit a cryptic error mid-launch.
  _img_type="$(incus image info "$BASE_IMAGE" 2>/dev/null | awk -F': ' '/^Type:/{print $2; exit}')"
  if [[ "$IS_VM" == "1" && "$_img_type" == "container" ]]; then
    error "Template '$BASE_IMAGE' is a container image; drop --vm or rebuild it with --vm."
  elif [[ "$IS_VM" == "0" && "$_img_type" == "virtual-machine" ]]; then
    error "Template '$BASE_IMAGE' is a VM image; add --vm to launch it."
  fi
  log "Using local template: $BASE_IMAGE"
fi

# ---------------------------------------------------------------------------
# Create container
# ---------------------------------------------------------------------------
log "Creating container: $CONTAINER_NAME ($(basename "$BASE_IMAGE"))"
if [[ "$IS_VM" == "1" ]]; then
  incus launch "$BASE_IMAGE" "$CONTAINER_NAME" --vm \
    -c limits.memory="$VM_MEMORY" \
    -c limits.cpu="$VM_CPUS" \
    -d root,size="$VM_DISK"
else
  incus launch "$BASE_IMAGE" "$CONTAINER_NAME" -p default -p "$AGENT_PROFILE"
fi
incus config set "$CONTAINER_NAME" user.managed-by=agent-incus

wait_for_container "$CONTAINER_NAME" "$READY_TIMEOUT"
wait_for_network "$CONTAINER_NAME" "$READY_TIMEOUT"

# Ownership belongs to this instance, including launches from a template.
if [[ -n "$(incus config get "$CONTAINER_NAME" user.incs.owned-proxy)" ]]; then
  incus config unset "$CONTAINER_NAME" user.incs.owned-proxy
fi
if [[ "$SKIP_CREDENTIAL_PROXY" == "0" ]]; then
  proxy_create_owned "$CONTAINER_NAME"
fi

# ---------------------------------------------------------------------------
# Provision (skipped when launching from a local base image)
# ---------------------------------------------------------------------------
if [[ "$FROM_BASE_IMAGE" == "0" ]]; then

  # --- Install packages ---
  log "Installing packages..."
  incus exec "$CONTAINER_NAME" -- sh -es <<PACKAGES
    export DEBIAN_FRONTEND=noninteractive
    apt-get update -y
    apt-get install -y $APT_CORE $APT_BUILD $APT_DEVLIBS $APT_RUNTIME
    apt-get clean && rm -rf /var/lib/apt/lists/*

    # Extra repos (mise + GitHub CLI)
    install -dm 755 /etc/apt/keyrings
    curl -fsSL https://mise.jdx.dev/gpg-key.pub | gpg --dearmor -o /etc/apt/keyrings/mise-archive-keyring.gpg
    echo "deb [signed-by=/etc/apt/keyrings/mise-archive-keyring.gpg] https://mise.jdx.dev/deb stable main" | tee /etc/apt/sources.list.d/mise.list
    curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
      | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg 2>/dev/null
    chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg
    echo "deb [arch=\$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
      > /etc/apt/sources.list.d/github-cli.list
    apt-get update -y
    apt-get install -y mise gh
PACKAGES

fi  # end FROM_BASE_IMAGE == 0

# ---------------------------------------------------------------------------
# Create user (always — base image may have been built by a different user)
# ---------------------------------------------------------------------------
log "Creating user $HOST_USER..."
BUILD_SUDO_GRANTED=1
incus exec "$CONTAINER_NAME" -- sh -c "
  # Skip creation if user already exists with correct UID
  if ! (id $HOST_USER >/dev/null 2>&1 && [ \"\$(id -u $HOST_USER)\" = \"$HOST_UID\" ]); then
    ZSH_PATH=\$(command -v zsh || echo /bin/bash)

    # Remove conflicting UID/GID owners
    EXISTING_USER=\$(getent passwd $HOST_UID | cut -d: -f1 || true)
    EXISTING_GROUP=\$(getent group $HOST_GID | cut -d: -f1 || true)

    if [ -n \"\$EXISTING_USER\" ] && [ \"\$EXISTING_USER\" != \"$HOST_USER\" ]; then
      userdel -r \"\$EXISTING_USER\" 2>/dev/null || userdel \"\$EXISTING_USER\" 2>/dev/null || true
    fi
    if [ -n \"\$EXISTING_GROUP\" ] && [ \"\$EXISTING_GROUP\" != \"$HOST_USER\" ]; then
      groupdel \"\$EXISTING_GROUP\" 2>/dev/null || true
    fi

    groupadd -g $HOST_GID $HOST_USER 2>/dev/null || true
    useradd -m -u $HOST_UID -g $HOST_GID -s \"\$ZSH_PATH\" $HOST_USER || exit 1
  fi

  id $HOST_USER >/dev/null 2>&1 || { echo 'User creation failed' >&2; exit 1; }

  # Group-gated sudo: the user is not a member of _sudo. incus.shell adds the
  # group to a single session when asked (--with-sudo).
  groupadd -f _sudo
  echo '%_sudo ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/_sudo
  chmod 0440 /etc/sudoers.d/_sudo

  # Grant user-level sudo for the build (plugins need it). Removed after
  # plugin installs, and by the exit trap if the build stops early.
  echo '$HOST_USER ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/$HOST_USER
  chmod 0440 /etc/sudoers.d/$HOST_USER
"

# ---------------------------------------------------------------------------
# Disable mise's gix-based git cloner. gix trips on some asdf plugin repos
# (notably asdf-php) with "Failed to update references to their new position
# to match their remote locations" and fails any mise install run by the
# user later. System git handles the same clones fine.
# ---------------------------------------------------------------------------
log "Configuring mise to use system git (gix=false)..."
incus exec "$CONTAINER_NAME" -- su - "$HOST_USER" -c 'bash -s' <<'MISECFG'
  set -e
  mkdir -p "$HOME/.config/mise"
  cfg="$HOME/.config/mise/config.toml"
  if [[ ! -f "$cfg" ]] || ! grep -q '^\[settings\]' "$cfg"; then
    printf '[settings]\ngix = false\n' >> "$cfg"
  elif ! grep -qE '^gix *= *false' "$cfg"; then
    # [settings] exists but no gix=false line — append under the section
    awk '
      /^\[settings\]/ { print; print "gix = false"; next }
      { print }
    ' "$cfg" > "$cfg.new" && mv "$cfg.new" "$cfg"
  fi
MISECFG

# ---------------------------------------------------------------------------
# Copy the workspace in
# ---------------------------------------------------------------------------
copy_workspace

# Final readiness check
wait_for_container "$CONTAINER_NAME" "$READY_TIMEOUT"
incus exec "$CONTAINER_NAME" -- id "$HOST_USER" >/dev/null 2>&1 \
  || error "User $HOST_USER does not exist. User creation may have failed."

wait_for_network "$CONTAINER_NAME" "$READY_TIMEOUT"

# ---------------------------------------------------------------------------
# Shell setup (skipped when launching from a local base image)
# ---------------------------------------------------------------------------
if [[ "$FROM_BASE_IMAGE" == "0" ]]; then

  log "Configuring zsh..."
  incus exec "$CONTAINER_NAME" -- su - "$HOST_USER" -c 'bash -s' <<'ZSHEOF'
    set -e

    # Auto-cd to /workspace on login
    touch ~/.zshrc
    cat >> ~/.zprofile <<'WORKSPACE'
if [[ -d /workspace ]]; then
    cd /workspace
fi
WORKSPACE
ZSHEOF

  # Install Oh My Zsh — must run before appending to .zshrc since
  # the installer replaces .zshrc with its own template
  install_ohmyzsh

  # Append mise activation and PATH after Oh My Zsh has written its .zshrc
  incus exec "$CONTAINER_NAME" -- su - "$HOST_USER" -c 'bash -s' <<'ZSHEOF'
    set -e
    echo 'eval "$(mise activate zsh)"' >> ~/.zshrc
    echo 'export PATH="$HOME/.local/bin:$PATH"' >> ~/.zshrc
ZSHEOF

fi  # end FROM_BASE_IMAGE == 0

# ---------------------------------------------------------------------------
# Install selected plugins
# ---------------------------------------------------------------------------
_run_plugin_installs "$FROM_BASE_IMAGE"

# Revoke build-time sudo now that plugins are done
log "Revoking build-time sudo..."
revoke_build_sudo || error "Could not revoke build-time sudo"

# Run mise install if the workspace has a config. Skipped for template builds
# and --no-copy: the workspace starts empty, so the host's mise config never
# reached it.
if [[ "$SAVE_TEMPLATE" != "1" && "$NO_COPY" != "1" ]] && [[ -f "$WORKSPACE_PATH/mise.toml" || -f "$WORKSPACE_PATH/.mise.toml" || -f "$WORKSPACE_PATH/.tool-versions" ]]; then
  log "Trusting workspace mise config..."
  incus exec "$CONTAINER_NAME" -- su - "$HOST_USER" -c "cd '$CONTAINER_WORKSPACE' && mise trust"

  # Pre-clone asdf plugins with system git before `mise install`.
  # mise's built-in gix cloner trips on some plugin repos (e.g. asdf-php)
  # with "Failed to update references to their new position to match their
  # remote locations". `mise settings set gix false` does not reliably disable
  # gix in current mise releases, so we sidestep the clone entirely: if the
  # plugin dir already exists, mise skips its own clone.
  log "Pre-cloning mise plugins via system git (gix workaround)..."
  incus exec "$CONTAINER_NAME" -- su - "$HOST_USER" -c 'bash -s' <<'PRECLONE'
    set -e
    tools=$(python3 - <<'PY'
import os, re
tools = set()
for f in ("mise.toml", ".mise.toml"):
    p = f"/workspace/{f}"
    if not os.path.exists(p):
        continue
    in_tools = False
    with open(p) as fh:
        for line in fh:
            s = line.strip()
            m = re.match(r'^\[([A-Za-z0-9_.-]+)\]', s)
            if m:
                sect = m.group(1)
                in_tools = (sect == "tools")
                if sect.startswith("tools."):
                    tools.add(sect[6:])
                continue
            if not in_tools or not s or s.startswith("#"):
                continue
            km = re.match(r'^"?([A-Za-z0-9_-]+)"?\s*=', s)
            if km:
                tools.add(km.group(1))
p = "/workspace/.tool-versions"
if os.path.exists(p):
    with open(p) as fh:
        for line in fh:
            s = line.strip()
            if s and not s.startswith("#"):
                tools.add(s.split()[0])
for t in sorted(tools):
    print(t)
PY
)
    # Tools mise ships as core/builtin plugins — no asdf clone needed.
    core="bun deno elixir erlang go golang java node nodejs python python3 ruby rust zig"
    plugins_dir="$HOME/.local/share/mise/plugins"
    mkdir -p "$plugins_dir"
    for tool in $tools; do
      case " $core " in *" $tool "*) continue ;; esac
      [[ -d "$plugins_dir/$tool" ]] && continue
      url="https://github.com/mise-plugins/asdf-$tool.git"
      if git clone --quiet --depth 1 "$url" "$plugins_dir/$tool" 2>/dev/null; then
        echo "  pre-cloned: $tool"
      else
        rm -rf "$plugins_dir/$tool"
        echo "  no asdf-$tool plugin on mise-plugins; letting mise resolve"
      fi
    done
PRECLONE

  log "Running mise install for workspace..."
  # Non-fatal: a broken tool version in the workspace config shouldn't nuke an
  # otherwise-complete instance (plugins and env are already applied by now).
  incus exec "$CONTAINER_NAME" -- su - "$HOST_USER" -c "cd '$CONTAINER_WORKSPACE' && mise install" || \
    warn "mise install failed — fix tool versions and rerun 'mise install' inside the instance"
fi

# Expose mise shims to non-interactive shells (e.g. Claude Code's Bash tool)
# by symlinking them into ~/.local/bin, which is on the default PATH.
# mise activation in .zshrc only covers interactive zsh; without this,
# `incus exec ... bash -c '...'` falls through to system binaries.
log "Syncing mise shims into ~/.local/bin..."
incus exec "$CONTAINER_NAME" -- su - "$HOST_USER" -c '
  shims="$HOME/.local/share/mise/shims"
  if [[ -d "$shims" ]]; then
    mkdir -p "$HOME/.local/bin"
    for shim in "$shims"/*; do
      [[ -e "$shim" ]] || continue
      ln -sf "$shim" "$HOME/.local/bin/$(basename "$shim")"
    done
  fi
'


# ---------------------------------------------------------------------------
# Disable cleanup trap on success
# ---------------------------------------------------------------------------
trap - EXIT INT TERM HUP

# ---------------------------------------------------------------------------
# Done
# ---------------------------------------------------------------------------
if [[ ${#FAILED_PLUGIN_NAMES[@]} -gt 0 ]]; then
  warn "Some plugins FAILED: ${FAILED_PLUGIN_NAMES[*]}"
else
  log "Container ready!"
fi
echo ""
echo "========================================"
echo "Container:   $CONTAINER_NAME"
echo "Image:       $BASE_IMAGE"
if [[ "$SKIP_CREDENTIAL_PROXY" == "1" ]]; then
  echo "Proxy:       none"
else
  _svcs="$(proxy_services "$CONTAINER_NAME" | sed -E 's/=[A-Za-z0-9_]+//g')"
  echo "Proxy:       $CONTAINER_NAME-proxy (${_svcs:-empty})"
fi
echo "User:        $HOST_USER (UID:$HOST_UID GID:$HOST_GID)"
if [[ "$IS_VM" == "1" ]]; then
  echo "Type:        VM (disk=$VM_DISK memory=$VM_MEMORY cpus=$VM_CPUS)"
else
  echo "Type:        container"
fi
if [[ "$SAVE_TEMPLATE" == "1" ]]; then
  echo "Workspace:   empty (template base)"
elif [[ "$NO_COPY" == "1" ]]; then
  echo "Workspace:   empty $CONTAINER_WORKSPACE (--no-copy)"
else
  echo "Workspace:   copy of $WORKSPACE_PATH in $CONTAINER_WORKSPACE (incl .git)"
fi
# Env var names (never values) that made it into the instance config — answers
# "did the token take?" at a glance after a long build.
_env_keys="$(incus config show "$CONTAINER_NAME" 2>/dev/null \
  | awk '/^  environment\./{k=$1; sub(/^environment\./,"",k); sub(/:$/,"",k); print k}' \
  | tr '\n' ' ')"
echo "Env vars:    ${_env_keys:-none}"
unset _env_keys
echo ""
echo "Installed:"
for entry in "${PLUGINS[@]}"; do
  IFS=: read -r id name desc default <<< "$entry"
  if [[ "$(selected_get "$id")" == "1" ]]; then
    if _plugin_failed "$name"; then
      echo "  ✗ $name (FAILED — see warnings above)"
    else
      echo "  ✓ $name"
    fi
  fi
done
echo "========================================"
echo ""
echo "Shell in:"
echo "  incs $CONTAINER_NAME"
echo ""
if [[ "$(selected_get claude-code)" == "1" ]]; then
echo "Start Claude Code:"
echo "  incs -s $CONTAINER_NAME 'cd $CONTAINER_WORKSPACE && claude'"
fi

# ---------------------------------------------------------------------------
# Publish as local image (optional)
# ---------------------------------------------------------------------------
if [[ "$SAVE_TEMPLATE" == "1" ]]; then
  save_template
fi
