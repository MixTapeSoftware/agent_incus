#!/usr/bin/env bash
set -euo pipefail

# Resolve symlinks: install_shortcuts links bxn into ~/.local/bin, and sibling
# scripts must be found next to the real file, not next to the link. macOS 12
# and earlier have no realpath, so fall back to following the links by hand.
_boxen_resolve() {
  if command -v realpath >/dev/null 2>&1; then realpath "$1"; return; fi
  local p="$1" link
  while [[ -L "$p" ]]; do
    link="$(readlink "$p")"
    case "$link" in /*) p="$link" ;; *) p="$(dirname "$p")/$link" ;; esac
  done
  echo "$p"
}
SCRIPT_DIR="$(cd "$(dirname "$(_boxen_resolve "${BASH_SOURCE[0]}")")" && pwd)"
# shellcheck source=boxen.prompt
source "$SCRIPT_DIR/boxen.prompt"

GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

log()   { echo -e "${GREEN}[+]${NC} $1"; }
error() { echo -e "${RED}[ERROR]${NC} $1" >&2; exit 1; }
# shellcheck source=boxen.names
source "$SCRIPT_DIR/boxen.names"

# A command's container from what was typed: bxn web finds chad-claude-web
# (boxen.names). Replaces the first argument that isn't a flag; the result is
# in RARGS. RESOLVE_STRICT=1 refuses a name that also matches numbered
# copies instead of taking the one without a number, for bxn rm.
resolve_container_arg() {
  local a found=0 c strict=""
  [[ "${RESOLVE_STRICT:-0}" != 1 ]] || strict="--strict"
  RARGS=()
  for a in "$@"; do
    if [[ $found == 0 && "$a" != -* ]]; then
      c="$(names_resolve $strict "$a")" || exit 1
      a="$c"
      found=1
    fi
    RARGS+=("$a")
  done
}

BOXEN_STATE_DIR="$HOME/.local/state/boxen"
BOXEN_LOG_DIR="${BOXEN_LOG_DIR:-$BOXEN_STATE_DIR/logs}"
BOXEN_STATUS_FILE="$BOXEN_STATE_DIR/last-update"

usage() {
  cat <<'EOF'
Usage: bxn [command] [args...]

Commands:
  (no command)                   Live status view on a terminal, this help otherwise
  <container>                    Shell into container (default)
  -s, shell [--with-sudo] <container> [cmd]
                                 Shell into container (--with-sudo grants temporary sudo)
  -c, create <project> [args...] Create a container named HANDLE-AGENT-PROJECT,
                                 with one agent (or a shell); numbered -1, -2
                                 when the name is taken (bxn create -h)
  -c, create <project> <github-url>
                                 The same, with a clone of the repository as
                                 its workspace, not a copy of this directory
  handle [<new>]                 Show or change your handle, the first part of
                                 every container name
  -n, net <container> [ports...] Manage port proxies
  egress <command> [args...]     Which internet hosts a container may reach
                                 (bxn egress -h)
  serve <container> [<port>[:<target>] | --off <port>]
                                 Tailscale serve mappings, set from the host:
                                 list them, map tailnet HTTPS <port> to the
                                 app's <target> (default: the same), or remove
  -e, env <container> <VAR>      Set env variable (prompts silently, paste-friendly)
  rm <container>                 Force delete a container
  -k, kill <container>           Stop a container
  -ka, kill-all                  Stop all boxen containers
  -u, update <container>         Update packages in a container
  -ua, update-all                Update packages in all boxen containers
  status [--once]                Live view of all instances: state, CPU, memory, disk,
                                 IPv4; j/k or arrows select, space starts/stops,
                                 S force-stops (also one whose stop is stuck),
                                 D deletes (asks first), tab or enter shows
                                 details; h/l switch to an allowlisted
                                 container's Network and Rules tabs
  doctor                         Check what would stop bxn creating or starting
                                 containers, and what was left half done
  plugins [show|update|set ...]  Where the optional plugins come from: this
                                 repository's, or a repository or directory of
                                 your own in their place (bxn plugins -h)
  new-plugin <slug> [opts]       Generate a new plugin file from a template
  -h, help                       Show this help

Cron:
  cron install [HOUR]            Install nightly update cron (default: 19)
  cron remove                    Remove the update cron
  cron status                    Show current cron schedule

A <container> can be the full name or just its project (or AGENT-PROJECT)
when you have one container for it: bxn web opens chad-claude-web.

Examples:
  bxn                                       Live status view (same as bxn status)
  bxn your-container                        Shell into your-container
  bxn -s your-container                     Shell into your-container (explicit)
  bxn -s your-container mix test            Run a command in your-container
  bxn -c your-container                     Create your-container
  bxn -c your-container --from base-dev     Create your-container from template
  bxn create web https://github.com/OWNER/REPO
                                            Create a container for web with that
                                            repository cloned into its workspace
  bxn -n your-container 4000 3241           Proxy ports 4000 and 3241
  bxn -n your-container 4000:8080           Host 4000 -> container 8080
  bxn -n your-container -b 10.0.0.5 4000   Bind to a specific IP (e.g. Tailscale)
  bxn -n your-container -H host.ts.net 4000 Bind to the IP resolved from an FQDN
  bxn -n your-container -l                  List proxies on your-container
  bxn -e your-container OPENAI_API_KEY      Set env var in your-container (prompts silently)
  bxn rm your-container                     Delete your-container
  bxn -k your-container                     Stop your-container
  bxn -ka                       Stop all boxen containers
  bxn -u your-container                     Update packages in your-container
  bxn -ua                       Update all boxen containers
  bxn status                    Live status; space starts/stops the selected row, S force-stops it
  bxn status --once             Print the status table once
