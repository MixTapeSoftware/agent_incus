#!/usr/bin/env bash
set -euo pipefail

# incs.egress
# `incs egress`: which internet hosts each container may reach. Each
# container's traffic goes through its own proxy in an egress container
# (incus.egress), and its network card lets it reach nothing else.

_incs_resolve() {
  if command -v realpath >/dev/null 2>&1; then realpath "$1"; return; fi
  local p="$1" link
  while [[ -L "$p" ]]; do
    link="$(readlink "$p")"
    case "$link" in /*) p="$link" ;; *) p="$(dirname "$p")/$link" ;; esac
  done
  echo "$p"
}
SCRIPT_DIR="$(cd "$(dirname "$(_incs_resolve "${BASH_SOURCE[0]}")")" && pwd)"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'
log()  { echo -e "${GREEN}[+]${NC} $1" >&2; }
warn() { echo -e "${YELLOW}[!]${NC} $1" >&2; }
error(){ echo -e "${RED}[ERROR]${NC} $1" >&2; exit 1; }

# shellcheck source=incus.net
source "$SCRIPT_DIR/incus.net"
# shellcheck source=incus.egress
source "$SCRIPT_DIR/incus.egress"

usage() {
  cat <<'EOF'
Usage: incs egress <command> [args...]

  ls [<container>]                     Each container's mode and proxy; with a
                                       name, its hosts and where each comes from
  log <container> [--since TIME] [--raw]
                                       What it tried to reach (default: last hour)
  allow <container> <host>...          Let it reach these hosts too
  allow --all <host>...                Add to your baseline, for every container
  rm <container> <host>...             Take hosts off its own list
  rm --all <host>...                   Take hosts off your baseline additions
  mode <container> enforce|report|off [--egress-container NAME]
                                       enforce: only listed hosts. report: all
                                       public web traffic, logging what enforce
                                       would block. off: no allowlist.
  refresh [<container>|--all]          Finish an interrupted change, apply a
                                       baseline update after you review it

Hosts are hostnames for ports 80 and 443: lowercase, punycode, a wildcard only
as a leading "*.". Allowing a host keeps open connections; anything that
narrows access ends the container's open connections through its proxy, and
turning the allowlist on for an open container restarts it.
  --yes     answer yes to --all and baseline prompts
  --force   allow even when six older proxies are still draining (ends the
            oldest one's connections)
EOF
  exit "${1:-0}"
}

YES=0
FORCE=""
confirm() {
  local reply=""
  [[ "$YES" == "1" ]] && return 0
  [[ -t 0 ]] || error "$1 Pass --yes to confirm without a prompt."
  read -rp "$1 [y/N] " reply || reply=""
  [[ "$reply" =~ ^[Yy]$ ]]
}

need_container() {
  local c="$1"
  [[ -n "$c" ]] || usage 1
  incus info "$c" &>/dev/null || error "Container not found: $c"
}

# Containers with an allowlist proxy.
allowlisted() {
  local c
  for c in $(incus list user.managed-by=agent-incus --format csv --columns n 2>/dev/null); do
    [[ -n "$(incus config get "$c" user.incs.egress.container 2>/dev/null)" ]] && echo "$c"
  done
  return 0
}

# Gives a container on the isolated bridge its proxy, with open policy rules
# unchanged until a mode says otherwise.
attach() {
  local c="$1" group="$2" egress
  [[ "$(incus config get "$c" user.incs.role 2>/dev/null)" != "egress" ]] || error "$c is an egress container"
  [[ "$(incus config get "$c" user.incs.net 2>/dev/null)" == "isolated" ]] ||
    error "$c is on the default bridge, so its traffic can't be confined. Recreate it with incs -i (new instances join $INCS_NET)."
  egress="$(incus config get "$c" user.incs.egress.container 2>/dev/null)"
  if [[ -n "$egress" ]]; then
    [[ -z "$group" || "$(egress_name "$group")" == "$egress" ]] ||
      error "$c already uses $egress. Moving it isn't supported yet."
    return 0
  fi
  egress="$(egress_name "$group")"
  net_preflight
  ensure_net
  egress_ensure "$egress"
  egress_register "$c" "$egress"
  if ! egress_running "$c"; then
    incus start "$c" >/dev/null || error "Could not start $c"
  fi
  wait_running "$c"
  egress_write_proxy_env "$c"
}

wait_running() {
  local n=0
  until incus exec "$1" -- true </dev/null >/dev/null 2>&1; do
    (( n++ < 60 )) || error "$1 didn't come up"
    sleep 1
  done
}

say_result() {
  case "$2" in
    unchanged) log "$1: no change" ;;
    widened) log "$1: allowed; open connections keep running" ;;
    tightened) log "$1: narrowed; its open connections through the proxy ended" ;;
    locked) log "$1: locked; it restarted on a new address, so no old connection survives" ;;
    *) log "$1: $2" ;;
  esac
}

converge_one() {
  local c="$1" r
  r="$(egress_converge "$c" "$FORCE")" || { warn "$c: the change didn't go through"; return 1; }
  say_result "$c" "$r"
}

cmd_mode() {
  local c="${1:-}" mode="${2:-}" group=""
  shift 2 || usage 1
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --egress-container) [[ $# -ge 2 ]] || usage 1; group="$2"; shift 2 ;;
      *) usage 1 ;;
    esac
  done
  need_container "$c"
  case "$mode" in enforce | report | off) ;; *) usage 1 ;; esac
  incs_lock
  attach "$c" "$group"
  incus config set "$c" "user.incs.egress=$mode" >/dev/null
  converge_one "$c" || { incs_unlock; return 1; }
  incs_unlock
}

# Usage: edit_hosts add|rm <container> <host>...
edit_hosts() {
  local op="$1" c="$2" h list="" out=() keep
  shift 2
  [[ $# -gt 0 ]] || usage 1
  for h in "$@"; do
    out+=("$(egress_host "$h")") || error "Not a hostname incs accepts: $h"
  done
  list="$(egress_split "$(incus config get "$c" user.incs.egress.allow 2>/dev/null)")"
  if [[ "$op" == add ]]; then
    list="$(printf '%s\n' "$list" "${out[@]}" | sed '/^$/d' | LC_ALL=C sort -u)"
  else
    for h in "${out[@]}"; do
      grep -qxF -- "$h" <<< "$list" || warn "$h isn't on $c's own list"
      list="$(grep -vxF -- "$h" <<< "$list" || true)"
    done
  fi
  keep="$(printf '%s\n' "$list" | sed '/^$/d' | tr '\n' ',' | sed 's/,$//')"
  incus config set "$c" "user.incs.egress.allow=$keep" >/dev/null
  if [[ "$op" == rm ]]; then
    for h in "${out[@]}"; do
      if egress_hosts "$c" | grep -qxF -- "$h"; then
        warn "$h is still allowed for $c by $(host_source "$c" "$h")"
      fi
    done
  fi
}

# Each host a container may reach, a tab, and where it comes from.
hosts_with_sources() {
  local c="$1"
  egress_ensure_approved
  {
    egress_read_hosts "$EGRESS_APPROVED" | sed 's/$/	baseline/'
    egress_read_hosts "$EGRESS_USER_HOSTS" | sed 's/$/	your additions/'
    egress_split "$(incus config get "$c" user.incs.egress.plugin-allow 2>/dev/null)" | sed 's/$/	plugins/'
    egress_split "$(incus config get "$c" user.incs.egress.allow 2>/dev/null)" | sed "s/\$/\t$c/"
  } | awk -F'\t' '!($1 in s) { order[++n] = $1; s[$1] = $2; next } { s[$1] = s[$1] ", " $2 }
                   END { for (i = 1; i <= n; i++) print order[i] "\t" s[order[i]] }' | LC_ALL=C sort
}

host_source() {
  local from
  from="$(hosts_with_sources "$1" | awk -F'\t' -v h="$2" '$1 == h { print $2 }')"
  echo "${from:--}"
}

cmd_allow_rm() {
  local op="$1" c
  shift
  if [[ "${1:-}" == "--all" ]]; then
    shift
    all_hosts "$op" "$@"
    return
  fi
  c="${1:-}"; shift || true
  need_container "$c"
  incs_lock
  attach "$c" ""
  edit_hosts "$op" "$c" "$@"
  converge_one "$c" || { incs_unlock; return 1; }
  incs_unlock
}

# --all changes your baseline additions, then every allowlisted container.
all_hosts() {
  local op="$1" h out=() list cs c failed=""
  shift
  [[ $# -gt 0 ]] || usage 1
  for h in "$@"; do out+=("$(egress_host "$h")") || error "Not a hostname incs accepts: $h"; done
  cs="$(allowlisted | tr '\n' ' ')"
  if [[ "$op" == add ]]; then
    confirm "Allow ${out[*]} for every container (${cs:-none yet})?" || error "Nothing changed"
  else
    confirm "Remove ${out[*]} from your baseline additions? Open connections through the proxy end for: ${cs:-none}." || error "Nothing changed"
  fi
  incs_lock
  mkdir -p "$INCS_CONFIG_DIR"
  list="$(egress_read_hosts "$EGRESS_USER_HOSTS")"
  if [[ "$op" == add ]]; then
    list="$(printf '%s\n' "$list" "${out[@]}" | sed '/^$/d' | LC_ALL=C sort -u)"
  else
    for h in "${out[@]}"; do
      grep -qxF -- "$h" <<< "$list" ||
        warn "$h isn't in your additions. Hosts in the approved baseline stay; incs egress refresh reviews it."
      list="$(grep -vxF -- "$h" <<< "$list" || true)"
    done
  fi
  { echo "# Your additions to the egress baseline, for every container. Managed by incs egress allow/rm --all."
    printf '%s\n' "$list" | sed '/^$/d'; } > "$EGRESS_USER_HOSTS.new"
  mv "$EGRESS_USER_HOSTS.new" "$EGRESS_USER_HOSTS"
  for c in $cs; do converge_one "$c" || failed="$failed $c"; done
  incs_unlock
  [[ -z "$failed" ]] || error "Changes did not finish for:$failed. Retry: incs egress refresh --all"
}

cmd_ls() {
  local c="${1:-}" egress mode active port h
  if [[ -n "$c" ]]; then
    need_container "$c"
    egress="$(incus config get "$c" user.incs.egress.container 2>/dev/null)"
    [[ -n "$egress" ]] || { echo "$c: no allowlist (set one with: incs egress mode $c enforce)"; return 0; }
    status_line "$c"
    echo ""
    printf '%-50s  %s\n' HOST FROM
    hosts_with_sources "$c" | awk -F'\t' '{ printf "%-50s  %s\n", $1, $2 }'
    return 0
  fi
  printf '%-28s %-8s %-18s %-22s %s\n' CONTAINER MODE ACTIVE PROXY NOTES
  for c in $(allowlisted); do status_line "$c"; done
  ufw_note
}

# One line: name, desired mode, active state, proxy and anything to fix.
status_line() {
  local c="$1" egress mode active port notes="" st
  egress="$(incus config get "$c" user.incs.egress.container)"
  mode="$(incus config get "$c" user.incs.egress 2>/dev/null)"; mode="${mode:-enforce}"
  active="$(incus config get "$c" user.incs.egress.active 2>/dev/null)"
  port="$(incus config get "$c" user.incs.egress.port 2>/dev/null)"
  [[ -n "$(egress_transition "$c")" ]] && notes+="change interrupted: incs egress refresh $c; "
  if [[ "${active%%:*}" != "$mode" ]]; then
    notes+="wants $mode: incs egress refresh $c; "
  elif [[ "${active#*:}" != "$(egress_hosts "$c" | egress_policy_id "$mode")" ]]; then
    notes+="hosts changed since applied: incs egress refresh $c; "
  fi
  if [[ "$mode" != off ]] && ! egress_nic_is_restricted "$c"; then notes+="card not locked; "; fi
  if egress_running "$egress"; then
    st="$(egress_ctl "$egress" status "$c" </dev/null 2>/dev/null)" || st=""
    [[ "$(cut -f6 <<< "$st")" == "yes" ]] || notes+="no proxy listening; "
    local draining
    draining="$(cut -f7 <<< "$st" | wc -w | tr -d ' ')"
    (( draining > 1 )) && notes+="$((draining - 1)) older proxies draining; "
  else
    notes+="$egress is stopped: no internet; "
  fi
  [[ -n "$(incus config get "$c" user.incs.egress.plugin-allow 2>/dev/null | grep -F '*.tailscale.com' || true)" ]] &&
    notes+="Tailscale: not confined against a determined agent; "
  printf '%-28s %-8s %-18s %-22s %s\n' "$c" "$mode" "${active:--}" "$egress:$port" "${notes%; }"
}

# ufw can drop the bridge's DHCP and forwarding; incs added rules once.
ufw_note() {
  [[ "$(uname -s)" == "Linux" ]] && command -v ufw >/dev/null 2>&1 || return 0
  grep -q '^ENABLED=yes' "$INCS_UFW_CONF" 2>/dev/null || return 0
  [[ "$(incus network get "$INCS_NET" user.incs.ufw 2>/dev/null)" == "1" ]] && return 0
  echo ""
  warn "ufw is on, but incs hasn't added its rules for $INCS_NET:
  sudo ufw allow in on $INCS_NET to any port 67 proto udp
  sudo ufw route allow in on $INCS_NET"
}

cmd_log() {
  local c="${1:-}" since="-1h" raw=0 egress
  shift || true
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --since) [[ $# -ge 2 ]] || usage 1; since="$2"; shift 2 ;;
      --raw) raw=1; shift ;;
      *) usage 1 ;;
    esac
  done
  need_container "$c"
  egress="$(incus config get "$c" user.incs.egress.container 2>/dev/null)"
  [[ -n "$egress" ]] || error "$c has no allowlist"
  egress_running "$egress" || error "$egress is stopped"
  if [[ "$raw" == 1 ]]; then
    printf 'TIME\tHOST\tPORT\tDECISION\tREASON\tGEN\n'
    egress_ctl "$egress" log "$c" "$since" </dev/null
    return
  fi
  # One row per host, port and decision: hits and the last attempt. Blocked
  # first, so what to allow is at the top.
  egress_ctl "$egress" log "$c" "$since" </dev/null | awk -F'\t' '
    { k = $2 "\t" $3 "\t" $4; n[k]++; last[k] = $1 }
    END { for (k in n) { split(k, f, "\t"); r = (f[3] == "blocked") ? 0 : (f[3] == "would-block") ? 1 : 2
                         print r "\t" k "\t" n[k] "\t" last[k] } }' |
    sort -t$'\t' -k1,1n -k5,5nr |
    awk -F'\t' 'BEGIN { printf "%-50s %-6s %-12s %6s  %s\n", "HOST", "PORT", "DECISION", "HITS", "LAST" }
      { printf "%-50s %-6s %-12s %6s  %s\n", $2, $3, $4, $5, $6 }'
  echo ""
  echo "Allow a host: incs egress allow $c <host>"
}

cmd_refresh() {
  local target="${1:-}" cs c failed=""
  egress_ensure_approved
  if ! cmp -s <(egress_read_hosts "$EGRESS_SHIPPED") <(egress_read_hosts "$EGRESS_APPROVED"); then
    echo "The shipped egress baseline differs from the one you approved:"
    { diff <(egress_read_hosts "$EGRESS_APPROVED") <(egress_read_hosts "$EGRESS_SHIPPED") || true; } |
      sed -n 's/^> /  + /p; s/^< /  - /p'
    if confirm "Approve the shipped baseline? Removed hosts end open connections through the proxy."; then
      cp "$EGRESS_SHIPPED" "$EGRESS_APPROVED.new" && mv "$EGRESS_APPROVED.new" "$EGRESS_APPROVED"
      log "Approved the new baseline"
      [[ -n "$target" ]] || target=--all
    else
      warn "Kept the baseline you approved"
    fi
  fi
  case "$target" in
    "") return 0 ;;
    --all) cs="$(allowlisted)" ;;
    *) need_container "$target"; cs="$target" ;;
  esac
  incs_lock
  for c in $cs; do
    [[ -n "$(incus config get "$c" user.incs.egress.container 2>/dev/null)" ]] || { warn "$c has no allowlist"; continue; }
    converge_one "$c" || failed="$failed $c"
  done
  incs_unlock
  [[ -z "$failed" ]] || error "Changes did not finish for:$failed. Retry: incs egress refresh --all"
}

args=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --yes) YES=1 ;;
    --force) FORCE=--force ;;
    -h | --help) usage 0 ;;
    *) args+=("$1") ;;
  esac
  shift
done
set -- ${args[@]+"${args[@]}"}
[[ $# -gt 0 ]] || usage 1
cmd="$1"; shift
case "$cmd" in
  ls) cmd_ls "$@" ;;
  log) cmd_log "$@" ;;
  allow) cmd_allow_rm add "$@" ;;
  rm) cmd_allow_rm rm "$@" ;;
  mode) cmd_mode "$@" ;;
  refresh) cmd_refresh "$@" ;;
  *) usage 1 ;;
esac
