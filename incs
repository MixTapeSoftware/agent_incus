#!/usr/bin/env bash
set -euo pipefail

# Resolve symlinks: install_shortcuts links incs into ~/.local/bin, and sibling
# scripts must be found next to the real file, not next to the link. macOS 12
# and earlier have no realpath, so fall back to following the links by hand.
_incs_resolve() {
  if command -v realpath >/dev/null 2>&1; then realpath "$1"; return; fi
  local p="$1" link
  while [[ -L "$p" ]]; do
    link="$(readlink "$p")"
    case "$link" in /*) p="$link" ;; *) p="$(dirname "$p")/$link" ;; esac
  done
  echo "$p"
}
SCRIPT_DIR="$(cd "$(dirname "$(_incs_resolve "${BASH_SOURCE[0]}")")" && pwd)"
# shellcheck source=incus.prompt
source "$SCRIPT_DIR/incus.prompt"

GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

log()   { echo -e "${GREEN}[+]${NC} $1"; }
error() { echo -e "${RED}[ERROR]${NC} $1" >&2; exit 1; }

INCS_STATE_DIR="$HOME/.local/state/incs"
INCS_LOG_DIR="${INCS_LOG_DIR:-$INCS_STATE_DIR/logs}"
INCS_STATUS_FILE="$INCS_STATE_DIR/last-update"

usage() {
  cat <<'EOF'
Usage: incs [command] [args...]

Commands:
  (no command)                   Live status view on a terminal, this help otherwise
  <container>                    Shell into container (default)
  -s, shell [--with-sudo] <container> [cmd]
                                 Shell into container (--with-sudo grants temporary sudo)
  -i, init [args...]             Create/provision a new container
  -n, net <container> [ports...] Manage port proxies
  egress <command> [args...]     Which internet hosts a container may reach
                                 (incs egress -h)
  serve <container> [<port>[:<target>] | --off <port>]
                                 Tailscale serve mappings, set from the host:
                                 list them, map tailnet HTTPS <port> to the
                                 app's <target> (default: the same), or remove
  -e, env <container> <VAR>      Set env variable (prompts silently, paste-friendly)
  -d, delete <container>          Force delete a container
  -k, kill <container>           Stop a container
  -ka, kill-all                  Stop all agent-incus containers
  -u, update <container>         Update packages in a container
  -ua, update-all                Update packages in all agent-incus containers
  status [--once]                Live view of all instances: state, CPU, memory, disk,
                                 IPv4; j/k or arrows select, space starts/stops,
                                 tab or enter shows details; h/l switch to an
                                 allowlisted container's Network and Rules tabs
  new-plugin <slug> [opts]       Generate a new plugin file from a template
  -h, help                       Show this help

Cron:
  cron install [HOUR]            Install nightly update cron (default: 19)
  cron remove                    Remove the update cron
  cron status                    Show current cron schedule

Examples:
  incs                                       Live status view (same as incs status)
  incs your-container                        Shell into your-container
  incs -s your-container                     Shell into your-container (explicit)
  incs -s your-container mix test            Run a command in your-container
  incs -i your-container --from base-dev     Init your-container from template
  incs -n your-container 4000 3241           Proxy ports 4000 and 3241
  incs -n your-container 4000:8080           Host 4000 -> container 8080
  incs -n your-container -b 10.0.0.5 4000   Bind to a specific IP (e.g. Tailscale)
  incs -n your-container -H host.ts.net 4000 Bind to the IP resolved from an FQDN
  incs -n your-container -l                  List proxies on your-container
  incs -e your-container OPENAI_API_KEY      Set env var in your-container (prompts silently)
  incs -d your-container                     Delete your-container
  incs -k your-container                     Stop your-container
  incs -ka                       Stop all agent-incus containers
  incs -u your-container                     Update packages in your-container
  incs -ua                       Update all agent-incus containers
  incs status                    Live status; space starts/stops the selected row
  incs status --once             Print the status table once
  incs cron install              Install 7pm daily update cron
  incs cron install 3            Install 3am daily update cron
EOF
  exit 0
}

# A lockdown that didn't finish keeps the container stopped until it does
# (incs egress refresh). Nothing in incs starts it before then.
behind_barrier() {
  local t
  t="$(incus config get "$1" user.incs.egress.transition 2>/dev/null)" || return 0
  [[ -n "$t" && "$t" != "none" ]]
}

is_debian() {
  local container="$1"
  incus exec "$container" -- sh -c 'test -f /etc/debian_version' </dev/null &>/dev/null
}

ensure_log_dir() {
  mkdir -p "$INCS_LOG_DIR"
}

write_status() {
  local status="$1"
  local details="${2:-}"
  mkdir -p "$(dirname "$INCS_STATUS_FILE")"
  cat > "$INCS_STATUS_FILE" <<STATUSEOF
status=$status
date=$(date '+%Y-%m-%d %H:%M')
details=$details
STATUSEOF
}

cmd_update() {
  local container="$1"
  local logfile="${2:-}"
  if [[ -n "$logfile" ]]; then
    echo "=== $container $(date) ===" >> "$logfile"
    incus exec "$container" -- sh -c '
      export DEBIAN_FRONTEND=noninteractive
      apt-get update -qq && apt-get upgrade -y
    ' </dev/null >> "$logfile" 2>&1 || {
      echo "  ⚠️  Failed to update $container" >&2
      return 1
    }
  else
    incus exec "$container" -- sh -c '
      export DEBIAN_FRONTEND=noninteractive
      apt-get update -qq && apt-get upgrade -y
    ' </dev/null || {
      echo "  ⚠️  Failed to update $container" >&2
      return 1
    }
  fi
  log "Updated $container"
}

cmd_update_all() {
  local containers
  containers=$(incus list user.managed-by=agent-incus --format csv --columns ns 2>/dev/null) || {
    error "Failed to list containers"
  }
  if [[ -z "$containers" ]]; then
    echo "No incus-init managed containers found"
    return
  fi

  ensure_log_dir
  local failed=()
  local logfile="$INCS_LOG_DIR/update-$(date +%Y%m%d-%H%M%S).log"

  while IFS=, read -r name status; do
    local was_running=0
    if [[ "$status" == "RUNNING" ]]; then
      was_running=1
    elif behind_barrier "$name"; then
      echo "  ⚠️  Skipping $name: it's partway through turning its allowlist on. Finish it: incs egress refresh $name" >&2
      failed+=("$name")
      continue
    else
      log "Starting $name..."
      incus start "$name"
      # Wait for container to be ready
      local attempts=0
      while true; do
        if timeout 5 incus exec "$name" -- true </dev/null &>/dev/null; then
          break
        fi
        sleep 1
        attempts=$((attempts + 1))
        if [[ $attempts -ge 30 ]]; then
          echo "  ⚠️  Timed out waiting for $name" >&2
          failed+=("$name")
          continue 2
        fi
      done
    fi
    if ! is_debian "$name"; then
      echo "  ⚠️  WARNING: $name is tagged as agent-incus but is not Debian/Ubuntu — skipping update"
      [[ "$was_running" == "0" ]] && incus stop "$name"
      continue
    fi
    log "Updating $name..."
    if ! cmd_update "$name" "$logfile"; then
      failed+=("$name")
    fi
    # Only stop containers that were stopped before we started
    if [[ "$was_running" == "0" ]]; then
      log "Stopping $name..."
      incus stop "$name"
    fi
  done < <(echo "$containers")

  echo ""
  if [[ ${#failed[@]} -gt 0 ]]; then
    echo "⚠️  Failed: ${failed[*]}"
    echo "   See $logfile for details"
    write_status "failed" "${failed[*]}"
  else
    rm -f "$logfile"
    log "All containers updated successfully"
    write_status "ok"
  fi
}

# ---------------------------------------------------------------------------
# Set an environment variable in a container without echoing it to the screen.
# Writes both `incus config set environment.VAR=...` (for incus exec sessions)
# and `export VAR=...` into ~/.zshenv (for `su -` login shells). Any prior
# entry for the same var in ~/.zshenv is removed first so re-setting replaces.
# ---------------------------------------------------------------------------
cmd_set_env() {
  local container="${1:-}"
  local var_name="${2:-}"

  [[ -z "$container" || -z "$var_name" ]] && \
    error "Usage: incs -e <container> <VAR_NAME>"

  [[ "$var_name" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || \
    error "Invalid variable name: $var_name"

  incus info "$container" &>/dev/null || \
    error "Container not found: $container"

  local status
  status=$(incus list "^${container}$" --format csv --columns s 2>/dev/null)
  if [[ "$status" != "RUNNING" ]]; then
    behind_barrier "$container" &&
      error "$container is partway through turning its allowlist on, so it stays stopped. Finish it: incs egress refresh $container"
    log "Starting $container..."
    incus start "$container"
    local attempts=0
    while ! timeout 5 incus exec "$container" -- true </dev/null &>/dev/null; do
      sleep 1
      attempts=$((attempts + 1))
      if [[ $attempts -ge 30 ]]; then
        error "Timed out waiting for $container"
      fi
    done
  fi

  local value
  read_secret value "Enter value for $var_name (input hidden, paste ok): "
  [[ -z "$value" ]] && error "Value required"

  incus config set "$container" "environment.$var_name=$value"

  local host_user export_line
  host_user="$(id -un)"
  printf -v export_line 'export %s=%q\n' "$var_name" "$value"

  printf '%s' "$export_line" | incus exec "$container" -- \
    su - "$host_user" -s /bin/sh -c '
      touch ~/.zshenv
      sed -i "/^export '"$var_name"'=/d" ~/.zshenv
      cat >> ~/.zshenv
    '

  log "Set $var_name in $container"
}

# ---------------------------------------------------------------------------
# Status table. jq does the formatting; bash samples, pipes, and drives the
# interactive view.
# Input: `incus list --format json`. $prev = {t, cpu: {name: [ns, pid]}} from
# an earlier sample (for CPU %); $at = when the input was sampled, or null
# for now; $host = {cpus, mem} from the Incus resources API, either may be
# null; $color = bool; $sel = index of the row to highlight, or -1, counted
# in display order (ordered, from STATUS_ORDER_DEFS). Instances are grouped into Agent Incus
# instances and all others. CPU and memory are shown relative to the whole
# host. Keep the program free of single quotes — it lives in a single-quoted
# string.
# ---------------------------------------------------------------------------
STATUS_ORDER_DEFS='
def managed: .expanded_config["user.managed-by"] == "agent-incus";
def ordered: map(select(managed)) + map(select(managed | not));
'

STATUS_DEFS="$STATUS_ORDER_DEFS"'
def pad($w): if length < $w then . + (" " * ($w - length)) else . end;
def dp1: (. * 10 | round) as $d | "\($d / 10 | floor).\($d % 10)";
def human:
  [., 0] | until(.[0] < 1024 or .[1] == 4; [.[0] / 1024, .[1] + 1])
  | "\(.[0] | dp1)\(["B", "KiB", "MiB", "GiB", "TiB"][.[1]])";
def ipv4:
  [ (.state.network // {}) | to_entries[]
    | select(.key | (. == "lo" or startswith("docker") or startswith("br-") or startswith("veth")) | not)
    | .value.addresses[]?
    | select(.family == "inet" and .scope == "global") | .address ]
  | if length == 0 then "-" else join(", ") end;
def row($t):
  .state as $s | ($s.cpu.usage // null) as $u | ($prev.cpu[.name] // null) as $p
  | ([.expanded_devices // {} | .[] | select(.type == "disk" and .path == "/") | .size // empty] | first // null) as $quota
  | (.expanded_config // {}) as $c
  | { status, managed: managed,
      egress: (($c["user.incs.egress.container"] // "") != ""),
      emode: ($c["user.incs.egress"] // "enforce"),
      cells: [
        .name,
        (if .type == "virtual-machine" then "VM" else "CT" end),
        # Same pid in both samples, or the instance restarted in between.
        (if .status == "Running" and $host.cpus != null and $u != null and $p[0] != null and $p[1] == $s.pid
              and $u >= $p[0] and $t > $prev.t
           then "\(($u - $p[0]) / 1e9 / ($t - $prev.t) / $host.cpus * 100 | dp1)%" else "-" end),
        (if (.status == "Running" or .status == "Frozen") and ($s.memory.usage // 0) > 0
           then ($s.memory.usage | human) + (if $host.mem != null then " / " + ($host.mem | human) else "" end)
           else "-" end),
        (if ($s.disk.root.usage // 0) > 0
           then ($s.disk.root.usage | human) + (if $quota then " / " + $quota else "" end)
           else "-" end),
        ipv4 ] };
# Reset only the foreground so a highlighted row stays highlighted.
def dot:
  if .status == "Running" then (if $color then "\u001b[32m●\u001b[39m" else "●" end)
  elif .status == "Frozen" then (if $color then "\u001b[33m◐\u001b[39m" else "◐" end)
  else "○" end;
def fmt($w): [range(0; length) as $i | if $i < length - 1 then .[$i] | pad($w[$i]) else .[$i] end] | join("  ");

def line($w): dot + "  " + (.cells | fmt($w));
def group($title; $rows; $w):
  if ($rows | length) == 0 then empty else
    "", $title,
    ($rows[] | if .index == $sel then "\u001b[7m" + line($w) + "\u001b[27m" else line($w) end)
  end;
'

STATUS_JQ="$STATUS_DEFS"'
($at // now) as $t
| if length == 0 then "No instances found" else
    [ ordered | to_entries[] | (.value | row($t)) + {index: .key} ] as $rows
    | ["NAME", "TYPE", "CPU", "MEMORY", "DISK", "IPV4"] as $hdr
    | [range(0; $hdr | length) as $i | [$hdr[$i], $rows[].cells[$i]] | map(length) | max] as $w
    | "   " + ($hdr | fmt($w)),
      group("Agent Incus instances:"; [$rows[] | select(.managed)]; $w),
      group("Other Incus instances:"; [$rows[] | select(.managed | not)]; $w),
      "",
      "\([$rows[] | select(.status == "Running")] | length) of \($rows | length) running"
        + (if $host.cpus != null then ", host has \($host.cpus) CPUs" else "" end)
  end
'

# The two-panel view, as tagged lines for status_frame_panels:
#   L  a list row, padded to the panel width before any escape codes go in,
#      so the shell can put the details beside it by position
#   S  the index of the selected instance among the L rows
#   R  a details row for the selected instance
#   F  a footer row
# The selected row is reversed while the list has the keys, and bold while
# the details have them.
STATUS_PANELS_JQ="$STATUS_DEFS"'
def clip($n): if length > $n then .[0:$n - 1] + "…" else . end;
def when: if . == null or startswith("0001-") then "-" else .[0:16] | sub("T"; " ") end;
# The name of an allowlisted instance carries a two-character placeholder for its
# mark, swapped in after padding: a lock is two columns wide but one
# character long.
def lcells: [((.cells[0] | clip(30)) + (if .egress then " @@" else "" end)), .cells[2], (.cells[3] | split(" / ")[0])];
def mark: if .egress | not then "" elif .emode == "enforce" then "🔒" elif .emode == "report" then "🔓" else "  " end;
def egressinfo:
  .inst.expanded_config as $c
  | if ($c["user.incs.egress.container"] // "") == "" then [] else
      ($c["user.incs.egress"] // "enforce") as $m
      | ($c["user.incs.egress.active"] // "-") as $a
      | ($c["user.incs.egress.transition"] // "none") as $t
      | [ ["Egress", (if $m == "enforce" then "enforce: only listed hosts"
                      elif $m == "report" then "report: logging what enforce would block"
                      else "off: allowlist kept, not enforced" end)],
          ["Proxy", "\($c["user.incs.egress.container"]):\($c["user.incs.egress.port"] // "-")"] ]
        + (if $t != "none" then [["Attention", "change interrupted: incs egress refresh \(.inst.name)"]]
           elif ($a | split(":")[0]) != $m then [["Attention", "wants \($m), runs \($a | split(":")[0]): incs egress refresh \(.inst.name)"]]
           else [] end)
        + (if (($c["user.incs.egress.plugin-allow"] // "") | split(",") | index("*.tailscale.com")) != null
           then [["Tailscale", "not confined against a determined agent"]] else [] end)
    end;
def tabs($has):
  ["Info"] + (if $has then ["Network", "Rules"] else [] end)
  | to_entries
  | map(if (.value | ascii_downcase) == $tab
        then (if $focus == "info" then "\u001b[7m \(.value) \u001b[27m" else " \u001b[4m\(.value)\u001b[24m " end)
        else " \(.value) " end)
  | join(" ");
def info:
  . as $r | .inst as $i
  | [ ["State", $i.status],
      ["Type", (if $i.type == "virtual-machine" then "Virtual machine" else "Container" end)],
      ["CPU", $r.cells[2]],
      ["Memory", $r.cells[3]],
      ["Disk", $r.cells[4]],
      ["IPv4", $r.cells[5]],
      ["Image", ($i.config["image.description"] // "-")],
      ["Profiles", ($i.profiles // [] | if length == 0 then "-" else join(", ") end)],
      ["Created", ($i.created_at | when)],
      ["Last started", ($i.last_used_at | when)] ] + egressinfo
  # Values such as the image description come from image metadata. A newline
  # would forge a tagged row, and an escape sequence would reach the terminal.
  | .[] | (.[0] | pad(14)) + (.[1] | tostring | gsub("[[:cntrl:]]"; " "));

($at // now) as $t
| [ ordered | to_entries[] | (.value | row($t)) + {index: .key, inst: .value} ] as $rows
| if ($rows | length) == 0 then "L\tNo instances found", "S\t-1" else
    ["NAME", "CPU", "MEMORY"] as $hdr
    | [range(0; $hdr | length) as $i | [$hdr[$i], ($rows[] | lcells[$i])] | map(length) | max] as $w
    | ([3 + ($w | add) + 2 * ($w | length - 1), ("Agent Incus instances:" | length)] | max) as $lw
    | def lrow:
        mark as $mark
        | (dot + "  " + (lcells | fmt($w) | pad($lw - 3) | sub("@@"; $mark))) as $s
        | if $sel != .index then $s
          elif $focus == "list" then "\u001b[7m" + $s + "\u001b[27m"
          else "\u001b[1m" + $s + "\u001b[22m" end;
      def lgroup($title; $g):
        if ($g | length) == 0 then [] else
          [{text: ("" | pad($lw))}, {text: ($title | pad($lw))}]
          + [$g[] | {text: lrow, sel: (.index == $sel)}]
        end;
    ( [{text: ("   " + ($hdr | fmt($w)) | pad($lw))}]
      + lgroup("Agent Incus instances:"; [$rows[] | select(.managed)])
      + lgroup("Other Incus instances:"; [$rows[] | select(.managed | not)]) ) as $left
    | ($left[] | "L\t" + .text),
      "S\t\([$left | to_entries[] | select(.value.sel) | .key] | first // -1)",
      ( $rows[] | select(.index == $sel)
        | "R\t\u001b[1m" + .inst.name + "\u001b[22m",
          "R\t" + tabs(.egress),
          "R\t",
          (if $tab == "info" then "R\t" + info else empty end) ),
      "F\t",
      "F\t\([$rows[] | select(.status == "Running")] | length) of \($rows | length) running"
        + (if $host.cpus != null then ", host has \($host.cpus) CPUs" else "" end)
  end
'

# Cumulative CPU time and pid per running instance, stamped with the time.
STATUS_SAMPLE_JQ='{t: now, cpu: (map(select(.status == "Running") | {key: .name, value: [.state.cpu.usage, .state.pid]}) | from_entries)}'

# Host totals are the denominators for CPU and memory. Without them the CPU
# column reads "-" and memory shows usage alone.
status_host() {
  local host
  host=$(incus query /1.0/resources 2>/dev/null |
    jq -c '{cpus: ([.cpu.total | numbers | select(. > 0)] | first),
            mem: ([.memory.total | numbers | select(. > 0)] | first)}' 2>/dev/null) || host=""
  [[ -n "$host" ]] || host='{"cpus":null,"mem":null}'
  printf '%s\n' "$host"
}

# Usage: status_render <json> <prev> <at> <host> <color> <sel>
status_render() {
  jq -r --argjson prev "$2" --argjson at "$3" --argjson host "$4" \
    --argjson color "$5" --argjson sel "$6" "$STATUS_JQ" <<<"$1"
}

# Usage: status_render_panels <json> <prev> <at> <host> <color> <sel> <focus> [<tab>]
status_render_panels() {
  jq -r --argjson prev "$2" --argjson at "$3" --argjson host "$4" \
    --argjson color "$5" --argjson sel "$6" --arg focus "$7" --arg tab "${8:-info}" "$STATUS_PANELS_JQ" <<<"$1"
}

cmd_status() {
  command -v jq >/dev/null 2>&1 ||
    error "incs status needs jq (macOS 15+ ships it; Ubuntu: sudo apt install jq; Homebrew: brew install jq)"

  local once=false
  case "${1:-}" in
    "") ;;
    --once) once=true ;;
    *) error "Usage: incs status [--once]" ;;
  esac
  if [[ $once == false && -t 0 && -t 1 ]]; then
    status_interactive
    return
  fi

  local color=false prev host json
  if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then color=true; fi

  # CPU % = change in cumulative CPU time across two samples ~1s apart.
  prev=$(incus list --format json | jq -c "$STATUS_SAMPLE_JQ") ||
    error "Failed to list instances"
  if jq -e '.cpu | length > 0' <<<"$prev" >/dev/null; then sleep 1; fi

  host=$(status_host)
  json=$(incus list --format json) || error "Failed to list instances"
  status_render "$json" "$prev" null "$host" "$color" -1 || error "Failed to list instances"
}

# ---------------------------------------------------------------------------
# Interactive status: redraws about once a second. j/k or the arrow keys
# move the highlighted row, space starts or stops it, q quits. Start and
# stop run in the background so the view keeps refreshing; each job writes
# its exit code to <log>.rc when it finishes.
#
# A terminal at least STATUS_WIDE_COLS wide shows the instances on the left
# and the selected one's details on the right; tab moves the keys between
# them. A narrower one shows the table, and enter opens the details full
# screen until esc.
# ---------------------------------------------------------------------------
STATUS_TTY_SAVED=""
STATUS_TMP=""
STATUS_WIDE_COLS=100

status_tui_restore() {
  printf '\033[?7h\033[?25h\033[?1049l'
  if [[ -n "$STATUS_TTY_SAVED" ]]; then stty "$STATUS_TTY_SAVED" 2>/dev/null || true; fi
  if [[ -n "$STATUS_TMP" ]]; then rm -rf "$STATUS_TMP"; fi
}

# Usage: msg=$(status_note "$msg" <line>). Keeps the last three lines so
# results from jobs that finish close together all stay visible.
status_note() {
  printf '%s\n%s\n' "$1" "$2" | sed '/^$/d' | tail -n 3
}

# The status_frame_* helpers add rows to status_interactive's frame and move
# its scroll offsets, top (list) and rtop (details), reading its term_rows,
# msg_lines and sel.

# Fits the table to the terminal. The header row stays at the top and the
# footer at the bottom; the instance rows between them scroll to keep the
# highlighted row visible.
# Usage: status_frame_table <table>
status_frame_table() {
  local lines=() line n head=0 tail=0 body_len avail sel_line=-1 i
  while IFS= read -r line; do
    if [[ "$line" == $'\033[7m'* ]]; then sel_line=${#lines[@]}; fi
    lines+=("$line")
  done <<<"$1"
  n=${#lines[@]}
  if ((n >= 3 && sel_line >= 0)); then
    head=1   # column header
    tail=2   # blank line and running count
  fi
  for ((i = 0; i < head; i++)); do frame+=("${lines[$i]}"); done
  body_len=$((n - head - tail))
  avail=$((term_rows - head - tail - 2 - msg_lines))
  if ((avail < 1)); then avail=1; fi
  if ((sel == 0)); then top=0; fi
  if ((sel_line >= 0)); then
    if ((sel_line - head < top)); then top=$((sel_line - head)); fi
    if ((sel_line - head >= top + avail)); then top=$((sel_line - head - avail + 1)); fi
  fi
  if ((top > body_len - avail)); then top=$((body_len - avail)); fi
  if ((top < 0)); then top=0; fi
  for ((i = head + top; i < n - tail && i < head + top + avail; i++)); do frame+=("${lines[$i]}"); done
  for ((i = n - tail; i < n; i++)); do frame+=("${lines[$i]}"); done
}

# Lays out status_render_panels output: the list and the details side by
# side when wide is true, otherwise the details alone. The list's header row
# and the details' title and tab rows stay put; the rows under them scroll.
# Usage: status_frame_panels <tagged lines> <wide>
status_frame_panels() {
  local tagged="$1" wide="$2" line lefts=() rights=() foots=() sel_at=-1
  local height list_rows info_rows blank="" i j l r
  while IFS= read -r line; do
    case "${line%%$'\t'*}" in
      L) lefts+=("${line#*$'\t'}") ;;
      R) rights+=("${line#*$'\t'}") ;;
      F) foots+=("${line#*$'\t'}") ;;
      S) sel_at=${line#*$'\t'} ;;
    esac
  done <<<"$tagged"
  # Below the panels: the footer, a blank line, and the key help.
  height=$((term_rows - ${#foots[@]} - 2 - msg_lines))
  if ((height < 3)); then height=3; fi
  list_rows=$((height - 1))
  info_rows=$((height - 2))
  if ((sel == 0)); then top=0; fi
  if ((sel_at >= 1)); then
    if ((sel_at - 1 < top)); then top=$((sel_at - 1)); fi
    if ((sel_at - 1 >= top + list_rows)); then top=$((sel_at - list_rows)); fi
  fi
  if ((top > ${#lefts[@]} - 1 - list_rows)); then top=$((${#lefts[@]} - 1 - list_rows)); fi
  if ((top < 0)); then top=0; fi
  if ((rtop > ${#rights[@]} - 2 - info_rows)); then rtop=$((${#rights[@]} - 2 - info_rows)); fi
  if ((rtop < 0)); then rtop=0; fi
  # Every list row is already padded to the panel width.
  if ((${#lefts[@]} > 0)); then blank=$(printf '%*s' "${#lefts[0]}" ''); fi
  for ((i = 0; i < height; i++)); do
    r=""
    if ((i < 2)); then j=$i; else j=$((rtop + i)); fi
    if ((j < ${#rights[@]})); then r=${rights[$j]}; fi
    if [[ $wide == true ]]; then
      l=$blank
      if ((i == 0)); then j=0; else j=$((top + i)); fi
      if ((j < ${#lefts[@]})); then l=${lefts[$j]}; fi
      frame+=("$l │ $r")
    else
      frame+=("$r")
    fi
  done
  if ((${#foots[@]} > 0)); then frame+=("${foots[@]}"); fi
}

# Rows for the Network and Rules tabs, as "key<TAB>shown text": the key is
# the host an action applies to. Hostnames come from proxy logs and are
# treated as hostile: control characters are already replaced by the egress
# ctl, and they're clipped here and never run as shell.
# Usage: status_tab_rows <name> network|rules
status_tab_rows() {
  if [[ "$2" == network ]]; then
    "$SCRIPT_DIR/incs.egress" log "$1" --raw 2>/dev/null | tail -n +2 | awk -F'\t' '
      { gsub(/[[:cntrl:]]/, "?", $2); k = $2 "\t" $3 "\t" $4; n[k]++; last[k] = substr($1, 12, 8) }
      END { for (k in n) { split(k, f, "\t"); r = (f[3] == "blocked") ? 0 : (f[3] == "would-block") ? 1 : 2
                           print r "\t" n[k] "\t" f[1] "\t" sprintf("%-12s %5d  %-8s  %s:%s", f[3], n[k], last[k], substr(f[1], 1, 60), f[2]) } }' |
      sort -t$'\t' -k1,1n -k2,2nr | cut -f3-
  else
    "$SCRIPT_DIR/incs.egress" ls "$1" --tsv 2>/dev/null | awk -F'\t' '{ gsub(/[[:cntrl:]]/, "?", $1); gsub(/[[:cntrl:]]/, "?", $2); printf "%s\t%-44s %s\n", $1, substr($1, 1, 44), $2 }'
  fi
}

# Starts an egress change as a background job, like start and stop.
# Usage: status_egress_job <description> <incs egress args...>
status_egress_job() {
  local desc="$1"
  shift
  jobs=$((jobs + 1))
  log_file="$STATUS_TMP/$jobs"
  printf '%s\n' "$desc" >"$log_file.desc"
  (
    trap - EXIT INT TERM
    rc=0
    "$SCRIPT_DIR/incs.egress" "$@" </dev/null >"$log_file" 2>&1 || rc=$?
    echo "$rc" >"$log_file.tmp"
    mv "$log_file.tmp" "$log_file.rc"
  ) &
  pending+="egress"$'\t'"$name"$'\t'"$log_file"$'\n'
  msg=$(status_note "$msg" "$desc…")
  tab_at=0
}

status_interactive() {
  local color=true host json="[]" listed sample='{"t":0,"cpu":{}}' prev at=null
  local names=() states=() count=0 sel=0 sel_name="" hl i
  local pending="" still msg="" fetch=true last=-1 jobs=0
  local key rc rest line out table tagged keys name state verb log_file p_verb p_name p_log err
  local egs=() trans=() eg tr tab=info tabs_n=1 rsel=0 tab_rows=() tab_for="" tab_at=0 ask="" ask_args=() ask_desc="" r
  local frame=() size term_rows term_cols msg_lines wide focus=list top=0 rtop=0
  if [[ -n "${NO_COLOR:-}" ]]; then color=false; fi

  STATUS_TMP=$(mktemp -d)
  STATUS_TTY_SAVED=$(stty -g)
  trap status_tui_restore EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  stty -echo
  # Alternate screen, hidden cursor, and no line wrapping: a long line is
  # clipped at the right edge instead of pushing the frame down a row.
  printf '\033[?1049h\033[?25l\033[?7l'
  host=$(status_host)
  prev=$sample

  while :; do
    # Report start/stop jobs that have finished.
    if [[ -n "$pending" ]]; then
      still=""
      while IFS=$'\t' read -r p_verb p_name p_log; do
        [[ -n "$p_verb" ]] || continue
        if [[ ! -f "$p_log.rc" ]]; then
          still+="$p_verb"$'\t'"$p_name"$'\t'"$p_log"$'\n'
          continue
        fi
        if [[ "$p_verb" == egress ]]; then
          # The last line says what happened (incs egress logs one per change).
          # sed alone, so an empty log can't fail the pipeline (pipefail).
          err=$(sed -e $'s/\033\\[[0-9;]*m//g' -e '/^$/d' "$p_log" | tail -n 1 | tr -d '[:cntrl:]')
          if [[ "$(cat "$p_log.rc")" == 0 ]]; then line="${err#\[+\] }"; else line="Failed: $(head -n 1 "$p_log.desc"): ${err#\[ERROR\] }"; fi
          msg=$(status_note "$msg" "$line")
        elif [[ "$(cat "$p_log.rc")" == 0 ]]; then
          if [[ "$p_verb" == stop ]]; then line="Stopped $p_name"; else line="Started $p_name"; fi
          msg=$(status_note "$msg" "$line")
        else
          err=$(head -n 1 "$p_log")
          msg=$(status_note "$msg" "Failed to $p_verb $p_name: ${err#Error: }")
        fi
        fetch=true
      done <<<"$pending"
      pending=$still
    fi

    if [[ $fetch == true || $SECONDS -ne $last ]]; then
      if listed=$(incus list --format json 2>/dev/null); then
        json=$listed
        prev=$sample
        sample=$(jq -c "$STATUS_SAMPLE_JQ" <<<"$json")
        at=$(jq '.t' <<<"$sample")
        names=()
        states=()
        egs=()
        trans=()
        while IFS=$'\t' read -r name state eg tr; do
          [[ -n "$name" ]] || continue
          names+=("$name")
          states+=("$state")
          egs+=("$eg")
          trans+=("$tr")
        done <<<"$(jq -r "$STATUS_ORDER_DEFS"' ordered[] | [.name, .status,
          (.expanded_config["user.incs.egress.container"] // "-" | if . == "" then "-" else . end),
          (.expanded_config["user.incs.egress.transition"] // "none")] | @tsv' <<<"$json")"
        count=${#names[@]}
        # Keep the highlight on the same instance when the list changes.
        for ((i = 0; i < count; i++)); do
          if [[ "${names[$i]}" == "$sel_name" ]]; then sel=$i; fi
        done
      else
        msg=$(status_note "$msg" "Failed to list instances")
      fi
      last=$SECONDS
      fetch=false
    fi
    if ((sel >= count)); then sel=$((count - 1)); fi
    if ((sel < 0)); then sel=0; fi
    hl=-1
    if ((count > 0)); then
      hl=$sel
      sel_name=${names[$sel]}
    fi

    # Fit the frame to the terminal: the view, then the key help and any
    # messages at the bottom.
    size=$(stty size 2>/dev/null) || size=""
    term_rows=${size%% *}
    term_cols=${size##* }
    if ! [[ "$term_rows" =~ ^[0-9]+$ ]] || ((term_rows < 1)); then term_rows=24; fi
    if ! [[ "$term_cols" =~ ^[0-9]+$ ]]; then term_cols=0; fi
    wide=false
    if ((term_cols >= STATUS_WIDE_COLS)); then wide=true; fi
    if ((count == 0)); then focus=list; fi
    msg_lines=0
    if [[ -n "$msg" ]]; then msg_lines=$(printf '%s\n' "$msg" | wc -l); fi
    frame=()
    if [[ $wide == false && $focus == list ]]; then
      table=$(status_render "$json" "$prev" "$at" "$host" "$color" "$hl") || table="Failed to render status"
      status_frame_table "$table"
      keys="↑/↓ or j/k select · enter details · space start/stop · q quit"
    else
      tabs_n=1
      if ((count > 0)) && [[ "${egs[$sel]}" != "-" ]]; then tabs_n=3; fi
      if ((tabs_n == 1)); then tab=info; fi
      tagged=$(status_render_panels "$json" "$prev" "$at" "$host" "$color" "$hl" "$focus" "$tab") ||
        tagged=$'L\tFailed to render status'
      if [[ "$tab" != info ]]; then
        # Read only while the tab is open, at most every five seconds.
        if [[ "$tab_for" != "$sel_name/$tab" ]] || ((SECONDS - tab_at >= 5)); then
          tab_rows=()
          while IFS= read -r r; do [[ -n "$r" ]] && tab_rows+=("$r"); done <<<"$(status_tab_rows "$sel_name" "$tab")"
          if [[ "$tab_for" != "$sel_name/$tab" ]]; then rsel=0; fi
          tab_for="$sel_name/$tab"
          tab_at=$SECONDS
        fi
        if ((rsel >= ${#tab_rows[@]})); then rsel=$((${#tab_rows[@]} - 1)); fi
        if ((rsel < 0)); then rsel=0; fi
        if ((${#tab_rows[@]} == 0)); then
          if [[ "$tab" == network ]]; then tagged+=$'\nR\tNothing logged in the last hour.'; else tagged+=$'\nR\tNo hosts.'; fi
        else
          if [[ "$tab" == network ]]; then
            tagged+=$'\nR\tDECISION      HITS  LAST      HOST'
          else
            tagged+=$'\nR\tHOST                                         FROM'
          fi
          # Keep the cursor in view: the title, tab and header rows stay put.
          if ((rsel < rtop)); then rtop=$rsel; fi
          if ((rsel - rtop > term_rows - 10)); then rtop=$((rsel - term_rows + 10)); fi
          for ((i = 0; i < ${#tab_rows[@]}; i++)); do
            line=${tab_rows[$i]#*$'\t'}
            if ((i == rsel)) && [[ $focus == info ]]; then line=$'\033[7m'"$line"$'\033[27m'; fi
            tagged+=$'\n'"R"$'\t'"$line"
          done
        fi
      fi
      status_frame_panels "$tagged" "$wide"
      if [[ $focus == list ]]; then
        keys="↑/↓ or j/k select · tab details · space start/stop · q quit"
      elif [[ $tab == network ]]; then
        keys="j/k select · a allow here · A allow everywhere · m mode · h/l tabs · tab list · q quit"
      elif [[ $tab == rules ]]; then
        keys="j/k select · d remove · m mode · h/l tabs · tab list · q quit"
      elif [[ $wide == true ]]; then
        keys="↑/↓ or j/k scroll · tab list · space start/stop · q quit"
      else
        keys="↑/↓ or j/k scroll · esc back · space start/stop · q quit"
      fi
      if ((tabs_n > 1)) && [[ $focus == info && $tab == info ]]; then keys="${keys/ · q quit/ · h/l tabs · m mode · q quit}"; fi
      if [[ -n "$ask" ]]; then keys="$ask_desc"; fi
    fi
    frame+=("" "$keys")
    if [[ -n "$msg" ]]; then
      while IFS= read -r line; do frame+=("$line"); done <<<"$msg"
    fi
    # No newline after the last row, or a full-height frame would scroll.
    out=$'\033[H'
    for ((i = 0; i < ${#frame[@]}; i++)); do
      if ((i > 0)); then out+=$'\n'; fi
      out+="${frame[$i]}"$'\033[K'
    done
    out+=$'\033[J'
    printf '%s' "$out"

    key=""
    rc=0
    IFS= read -rsn1 -t 1 key || rc=$?
    # Enter reads as an empty key that succeeded; a timeout fails.
    if ((rc == 0)) && [[ -z "$key" ]]; then key=enter; fi
    if [[ "$key" == $'\033' ]]; then
      rest=""
      IFS= read -rsn2 -t 1 rest || true
      case "$rest" in
        "[A" | OA) key=k ;;
        "[B" | OB) key=j ;;
        "[C" | OC) key=l ;;
        "[D" | OD) key=h ;;
        "") key=esc ;;
        *) key="" ;;
      esac
    fi
    if [[ -n "$ask" && -n "$key" ]]; then
      name=${names[$sel]}
      case "$ask" in
        confirm)
          if [[ "$key" == y || "$key" == Y ]]; then status_egress_job "${ask_args[@]}"; else msg=$(status_note "$msg" "Nothing changed"); fi
          ;;
        mode)
          case "$key" in
            e) status_egress_job "Setting $name to enforce" mode "$name" enforce ;;
            r) status_egress_job "Setting $name to report" mode "$name" report ;;
            o) status_egress_job "Setting $name to off" mode "$name" off ;;
            *) msg=$(status_note "$msg" "Nothing changed") ;;
          esac
          ;;
      esac
      ask=""
      continue
    fi
    case "$key" in
      q | Q) break ;;
      esc) if [[ $focus == info ]]; then focus=list; else break; fi ;;
      $'\t')
        if [[ $focus == list ]] && ((count > 0)); then focus=info; else focus=list; fi
        rtop=0
        ;;
      enter) if ((count > 0)); then focus=info; rtop=0; fi ;;
      h | l)
        if [[ $focus == info ]] && ((tabs_n > 1)); then
          case "$tab:$key" in
            info:l) tab=network ;; network:l) tab=rules ;; rules:l) tab=info ;;
            info:h) tab=rules ;; network:h) tab=info ;; rules:h) tab=network ;;
          esac
          rtop=0
          rsel=0
        fi
        ;;
      a | A)
        if [[ $focus == info && $tab == network ]] && ((${#tab_rows[@]} > 0)); then
          name=${names[$sel]}
          r=${tab_rows[$rsel]%%$'\t'*}
          ask=confirm
          if [[ "$key" == a ]]; then
            ask_desc="Allow $r for $name? y/n"
            ask_args=("Allowing $r for $name" allow "$name" "$r")
          else
            ask_desc="Allow $r for every container? y/n"
            ask_args=("Allowing $r everywhere" allow --all "$r" --yes)
          fi
        fi
        ;;
      d)
        if [[ $focus == info && $tab == rules ]] && ((${#tab_rows[@]} > 0)); then
          name=${names[$sel]}
          r=${tab_rows[$rsel]%%$'\t'*}
          line=${tab_rows[$rsel]#*$'\t'}
          # The sources start after the 44-column host and a space; the
          # container's own list is always named last.
          if [[ ", ${line:45}" == *", $name" ]]; then
            ask=confirm
            ask_desc="Remove $r from $name? Its open connections through the proxy end. y/n"
            ask_args=("Removing $r from $name" rm "$name" "$r")
          else
            msg=$(status_note "$msg" "$r isn't on $name's own list; it comes from ${line:45}")
          fi
        fi
        ;;
      m)
        if [[ $focus == info ]] && ((tabs_n > 1)); then
          ask=mode
          ask_desc="Mode for ${names[$sel]}: e enforce · r report · o off (turning it on restarts an open container) · other key cancels"
        fi
        ;;
      j)
        if [[ $focus == info && $tab != info ]]; then
          rsel=$((rsel + 1))
        elif [[ $focus == info ]]; then
          rtop=$((rtop + 1))
        elif ((sel < count - 1)); then
          sel=$((sel + 1))
          rtop=0
          tab=info
        fi
        ;;
      k)
        if [[ $focus == info && $tab != info ]]; then
          if ((rsel > 0)); then rsel=$((rsel - 1)); fi
        elif [[ $focus == info ]]; then
          if ((rtop > 0)); then rtop=$((rtop - 1)); fi
        elif ((sel > 0)); then
          sel=$((sel - 1))
          rtop=0
          tab=info
        fi
        ;;
      " ")
        ((count > 0)) || continue
        name=${names[$sel]}
        if [[ "$pending" == *$'\t'"$name"$'\t'* ]]; then
          msg=$(status_note "$msg" "$name is busy")
          continue
        fi
        if [[ "${states[$sel]}" == Running ]]; then verb=stop; else verb=start; fi
        if [[ $verb == start && "${trans[$sel]}" != none ]]; then
          msg=$(status_note "$msg" "$name is partway through turning its allowlist on; finish it: incs egress refresh $name")
          continue
        fi
        jobs=$((jobs + 1))
        log_file="$STATUS_TMP/$jobs"
        (
          trap - EXIT INT TERM
          rc=0
          incus "$verb" "$name" </dev/null >"$log_file" 2>&1 || rc=$?
          echo "$rc" >"$log_file.tmp"
          mv "$log_file.tmp" "$log_file.rc"
        ) &
        pending+="$verb"$'\t'"$name"$'\t'"$log_file"$'\n'
        if [[ $verb == stop ]]; then line="Stopping $name…"; else line="Starting $name…"; fi
        msg=$(status_note "$msg" "$line")
        ;;
    esac
    if ((count > 0)); then sel_name=${names[$sel]}; fi
  done
}

# ---------------------------------------------------------------------------
# Tailscale serve, from the host. Under an allowlist the agent isn't
# Tailscale's operator, so mappings change here, as root in the container.
# ---------------------------------------------------------------------------
cmd_serve() {
  local container="${1:-}" spec="${2:-}" port target
  [[ -n "$container" ]] || error "Usage: incs serve <container> [<port>[:<target>] | --off <port>]"
  incus info "$container" &>/dev/null || error "Container not found: $container"
  if [[ -z "$spec" ]]; then
    incus exec "$container" -- tailscale serve status
  elif [[ "$spec" == "--off" ]]; then
    port="${3:-}"
    [[ "$port" =~ ^[0-9]+$ ]] || error "Usage: incs serve <container> --off <port>"
    incus exec "$container" -- tailscale serve --https="$port" off
    log "Removed tailnet port $port on $container"
  else
    port="${spec%%:*}" target="${spec#*:}"
    [[ "$spec" == *:* ]] || target="$port"
    [[ "$port" =~ ^[0-9]+$ && "$target" =~ ^[0-9]+$ ]] ||
      error "Ports are numbers: incs serve <container> <port>[:<target>]"
    incus exec "$container" -- tailscale serve --bg --https="$port" "http://127.0.0.1:$target"
    log "Tailnet https port $port on $container serves its port $target"
  fi
}

# ---------------------------------------------------------------------------
# Cron management
# ---------------------------------------------------------------------------
CRON_TAG="# incs-update-all"

cmd_cron() {
  local action="${1:-}"
  case "$action" in
    install)
      local hour="${2:-19}"
      # Validate hour
      if ! [[ "$hour" =~ ^[0-9]+$ ]] || [[ "$hour" -gt 23 ]]; then
        error "Invalid hour: $hour (must be 0-23)"
      fi
      ensure_log_dir
      local incs_path
      incs_path="$(realpath "$0")"
      local cron_line="0 $hour * * * $incs_path -ua >> $INCS_LOG_DIR/cron.log 2>&1 $CRON_TAG"
      # Remove existing entry, add new one
      (crontab -l 2>/dev/null | grep -v "$CRON_TAG"; echo "$cron_line") | crontab -
      log "Installed cron: daily at $(printf '%02d' "$hour"):00"
      echo "  Logs: $INCS_LOG_DIR/cron.log"
      ;;
    remove)
      crontab -l 2>/dev/null | grep -v "$CRON_TAG" | crontab -
      log "Removed incs update cron"
      ;;
    status)
      local entry
      entry=$(crontab -l 2>/dev/null | grep "$CRON_TAG" || true)
      if [[ -n "$entry" ]]; then
        echo "Active: $entry"
      else
        echo "No incs update cron installed"
      fi
      ;;
    *)
      error "Usage: incs cron {install [HOUR]|remove|status}"
      ;;
  esac
}

# ---------------------------------------------------------------------------
# Login notification — source this snippet from .zshrc/.bashrc
# ---------------------------------------------------------------------------
cmd_notify_snippet() {
  cat <<'SNIPPET'
# incs update notification — add to ~/.zshrc or ~/.bashrc
if [[ -f "$HOME/.local/state/incs/last-update" ]]; then
  _incs_status=$(grep '^status=' "$HOME/.local/state/incs/last-update" | cut -d= -f2)
  _incs_date=$(grep '^date=' "$HOME/.local/state/incs/last-update" | cut -d= -f2-)
  _incs_details=$(grep '^details=' "$HOME/.local/state/incs/last-update" | cut -d= -f2-)
  if [[ "$_incs_status" == "failed" ]]; then
    echo -e "\033[1;33m⚠️  incs update failed ($_incs_date): $_incs_details\033[0m"
    echo "   Run 'ls ~/.local/state/incs/logs/' to see logs"
  fi
  unset _incs_status _incs_date _incs_details
fi
SNIPPET
}

# A bare incs on a terminal opens the live status view. Piped, scripted, or
# without jq for the view, it prints help instead.
if [[ $# -eq 0 ]]; then
  if [[ -t 0 && -t 1 ]] && command -v jq >/dev/null 2>&1; then set -- status; else usage; fi
fi

case "$1" in
  -h|--help|help)
    usage
    ;;
  -s|shell)
    shift
    exec "$SCRIPT_DIR/incus.shell" "$@"
    ;;
  -i|init)
    shift
    exec "$SCRIPT_DIR/incus.init" "$@"
    ;;
  -n|net)
    shift
    exec "$SCRIPT_DIR/incus.network" "$@"
    ;;
  egress)
    shift
    exec "$SCRIPT_DIR/incs.egress" "$@"
    ;;
  serve)
    shift
    cmd_serve "$@"
    ;;
  -e|env)
    shift
    cmd_set_env "$@"
    ;;
  -d|delete)
    shift
    [[ $# -lt 1 ]] && error "Usage: incs delete <container>"
    _egress="$(incus config get "$1" user.incs.egress.container 2>/dev/null || true)"
    incus delete --force "$1"
    log "Deleted $1"
    if [[ -n "$_egress" ]]; then
      # Its proxy goes too, under the lock that guards the egress
      # container's rules; its port isn't handed out again.
      ( SCRIPT_DIR="$SCRIPT_DIR"
        warn() { echo -e "${YELLOW}[!]${NC} $1" >&2; }
        source "$SCRIPT_DIR/incus.net"; source "$SCRIPT_DIR/incus.egress"
        incs_lock
        egress_forget "$1" "$_egress"
        incs_unlock )
    fi
    ;;
  -k|kill)
    shift
    [[ $# -lt 1 ]] && error "Usage: incs kill <container>"
    incus stop "$1"
    log "Stopped $1"
    ;;
  -ka|kill-all)
    containers=$(incus list user.managed-by=agent-incus status=running --format csv --columns n 2>/dev/null)
    if [[ -z "$containers" ]]; then
      echo "No running agent-incus containers"
    else
      for c in $containers; do
        incus stop "$c"
        log "Stopped $c"
      done
    fi
    ;;
  status)
    shift
    cmd_status "$@"
    ;;
  -u|update)
    shift
    [[ $# -lt 1 ]] && error "Usage: incs update <container>"
    cmd_update "$1"
    ;;
  -ua|update-all)
    cmd_update_all
    ;;
  cron)
    shift
    cmd_cron "$@"
    ;;
  new-plugin)
    shift
    exec "$SCRIPT_DIR/incs.new-plugin" "$@"
    ;;
  notify-snippet)
    cmd_notify_snippet
    ;;
  -*)
    error "Unknown command: $1 (try incs -h)"
    ;;
  *)
    # Default: shell into container
    exec "$SCRIPT_DIR/incus.shell" "$@"
    ;;
esac
