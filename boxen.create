#!/bin/bash
set -euo pipefail

# boxen.create
# Creates an Incus instance with optional coding agents and a copy of your
# workspace.
#
# Default image: Ubuntu 24.04. Override with --image.

# ---------------------------------------------------------------------------
# Colors
# ---------------------------------------------------------------------------
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

# ---------------------------------------------------------------------------
# Logging helpers
# ---------------------------------------------------------------------------
log()  { echo -e "${GREEN}[+]${NC} $1"; }
warn() { echo -e "${YELLOW}[!]${NC} $1"; }
error(){ echo -e "${RED}[ERROR]${NC} $1" >&2; exit 1; }

# ---------------------------------------------------------------------------
# Usage
# ---------------------------------------------------------------------------
# usage [status]: help exits 0; a usage error passes 1.
usage() {
  cat << EOF
Usage: bxn create [OPTIONS] <project> [<github-url>]
       $(basename "$0") [OPTIONS] <project> [<github-url>]   (the script directly)

Create an Incus instance with a copy of a host directory as its workspace and
at most one coding agent. It's named HANDLE-AGENT-PROJECT (chad-claude-web, or
chad-shell-web with no agent); another one for the same project and agent is
numbered -1, -2, so parallel agents each get their own copy. The handle is
asked for once (bxn handle changes it).
Default image is Ubuntu 24.04. Shows a picker for the agent, then one for plugins.

With a GitHub repository's URL (https://github.com/OWNER/REPO) the workspace is
a clone of it, made inside the container, and nothing is copied from the host.
The GitHub Auth plugin is selected, since its token is what clones a private
repository; untick it in the picker for a public one.

Options:
  -p, --path PATH           Host directory to copy in (default: current directory)
  -w, --workspace PATH      Where the copy goes in the container (default: /workspace)
  -f, --from TEMPLATE       Launch from a saved template (shorthand for --image incus-init/TEMPLATE)
  -i, --image IMAGE         Base image override (default: ubuntu/24.04)
  -t, --template            Save container as a reusable local template (empty workspace)
  --colima-cpus N           Colima VM CPUs (default: 4, macOS only)
  --colima-memory N         Colima VM memory in GB (default: 8, macOS only)
  --colima-disk N           Colima VM disk in GB (default: 100, macOS only)
  --vm                      Provision a KVM virtual machine instead of a container
  --no-copy                 Start with an empty workspace instead of copying the host directory
  --memory SIZE             Memory limit, e.g. 8GiB (default: the boxen profile's
                            6GB for a container, 4GiB for a VM; a selected plugin
                            can raise it). Refused when the host can't back it
  --vm-disk SIZE            VM root disk size (default: 20GiB)
  --vm-memory SIZE          Same as --memory
  --vm-cpus N               VM vCPUs (default: 4)
  --ack-env                 Acknowledge .env files in the workspace (skip prompt)
  --agent NAME              The coding agent: claude, codex, grok, or shell for none
  --name NAME               Use NAME exactly, instead of HANDLE-AGENT-PROJECT
  --no-tui                  Skip interactive plugin selector, use defaults
  --insecure-network        Use the default bridge: no isolation from other
                            instances or the host (also BOXEN_INSECURE_NETWORK=1)
  --egress MODE             Internet allowlist: enforce (default), report or off
  --egress-container NAME   Run this container's proxy in boxen-egress-NAME
  --plugins SOURCE          Take the optional plugins from a GitHub repository
                            (owner/repo[#ref]), a git URL, or a directory, in
                            place of ours; the agents stay. "builtin" is ours
  --dry-run                 Show what would be done without doing it
  -h, --help                Show this help

Plugins are defined in the plugins/ directory (or ~/.local/share/boxen/plugins/
for user plugins). Some provide CLI flags
(e.g. --1pass, --gh-token, --entire) to pre-select them without the TUI.
Drop a new .sh file in plugins/ (or ~/.local/share/boxen/plugins/) to add your own.
EOF
  exit "${1:-0}"
}

# ---------------------------------------------------------------------------
# Packages — grouped by purpose for readability
# ---------------------------------------------------------------------------

# --- Ubuntu/Debian (apt) ---
APT_CORE="bash curl git wget sudo unzip tmux zsh jq"
APT_BUILD="build-essential pkg-config autoconf automake bison cmake re2c"
APT_DEVLIBS="libssl-dev libncurses-dev libreadline-dev zlib1g-dev libbz2-dev libsqlite3-dev libffi-dev liblzma-dev libyaml-dev libxml2-dev libxslt1-dev libcurl4-openssl-dev libonig-dev libzip-dev libpng-dev libjpeg-dev libfreetype6-dev libgd-dev unixodbc-dev libpq-dev"
APT_RUNTIME="gpg ca-certificates psmisc fontconfig fzf bat inotify-tools python3 python3-dev python3-pip python3-venv nodejs npm postgresql-client default-mysql-client redis-tools"

# ---------------------------------------------------------------------------
# Dependency checks
# ---------------------------------------------------------------------------
require_commands() {
  local missing=()
  for cmd in "$@"; do
    command -v "$cmd" >/dev/null 2>&1 || missing+=("$cmd")
  done
  if [[ ${#missing[@]} -gt 0 ]]; then
    error "Missing required commands: ${missing[*]}"
  fi
}

# ---------------------------------------------------------------------------
# Container readiness polling (replaces fragile sleep)
# ---------------------------------------------------------------------------
wait_for_container() {
  local name="$1" timeout="${2:-30}" elapsed=0
  local ready=0
  while [[ $elapsed -lt $timeout ]]; do
    if incus exec "$name" -- true >/dev/null 2>&1; then
      ready=1
      break
    fi
    sleep 1
    elapsed=$((elapsed + 1))
  done
  if [[ $ready -eq 0 ]]; then
    error "Container $name not ready after ${timeout}s"
  fi
  return 0
}

# Wait for networking inside the container (can lag behind boot/restart). A
# container on an allowlist has no DNS of its own; it reaches the internet
# only through its proxy, so the check goes through it too.
NET_VIA_PROXY=0
wait_for_network() {
  local name="$1" timeout="${2:-30}" elapsed=0 probe
  log "Waiting for container networking..."
  if [[ "$NET_VIA_PROXY" == "1" ]]; then
    probe='curl -fsS -o /dev/null --max-time 5 https://github.com'
  else
    probe='getent hosts github.com >/dev/null 2>&1'
  fi
  local ready=0
  while [[ $elapsed -lt $timeout ]]; do
    if incus exec "$name" -- sh -c "$probe"; then
      ready=1
      break
    fi
    sleep 2
    elapsed=$((elapsed + 2))
  done
  if [[ $ready -eq 0 ]]; then
    error "Container $name has no network after ${timeout}s"
  fi
  return 0
}

# ---------------------------------------------------------------------------
# Exit trap — revoke build-time sudo, offer to delete the container on failure
# ---------------------------------------------------------------------------
BUILD_SUDO_GRANTED=0

# The user gets passwordless sudo while plugins install. Take it back.
revoke_build_sudo() {
  [[ "$BUILD_SUDO_GRANTED" == "1" ]] || return 0
  incus exec "$CONTAINER_NAME" -- rm -f "/etc/sudoers.d/$HOST_USER" </dev/null || return 1
  BUILD_SUDO_GRANTED=0
}

warn_tailscale_backup() {
  warn "Tailscale state for '$CONTAINER_NAME' is in ${TS_STATE_BACKUP:-} (it holds the node key: keep it private).
  Restore it (start the container first if it is stopped: incus start $CONTAINER_NAME):
    incus exec $CONTAINER_NAME -- tar -C /var/lib -xf - < ${TS_STATE_BACKUP:-}"
}

# While a finished build is published as a template. The container is complete,
# so it is never offered for deletion; the Tailscale state it lent the publish
# must still go back.
template_cleanup_on_exit() {
  local rc=$?
  trap - EXIT INT TERM HUP
  set +e
  restore_tailscale_state || warn_tailscale_backup
  exit "$rc"
}

# An EXIT trap, not ERR: error() calls exit directly, which ERR never sees.
cleanup_on_exit() {
  local rc=$? reply="" egress=""
  trap - EXIT INT TERM HUP
  set +e
  if [[ "${CREATED_INSTANCE:-0}" == "1" && -n "${CONTAINER_NAME:-}" ]] && incus info "$CONTAINER_NAME" >/dev/null 2>&1; then
    # Before the prompt: the container may be kept, or the prompt never answered.
    revoke_build_sudo || \
      warn "Could not revoke build-time sudo in '$CONTAINER_NAME'. Delete it: incus delete --force $CONTAINER_NAME"
    # A template build that failed after moving the Tailscale state out.
    restore_tailscale_state || warn_tailscale_backup
    if [[ $rc -ne 0 ]]; then
      echo ""
      warn "Script failed. Container '$CONTAINER_NAME' was partially created."
      # No answer (stdin closed) keeps the container: never delete unasked.
      read -rp "Delete it? [Y/n] " reply || reply="n"
      if [[ ! "$reply" =~ ^[Nn]$ ]]; then
        egress="$(incus config get "$CONTAINER_NAME" user.boxen.egress.container 2>/dev/null)" || egress=""
        if incus delete --force "$CONTAINER_NAME"; then
          log "Deleted $CONTAINER_NAME"
          if [[ -n "$egress" ]]; then
            # A build can fail while holding the network lock. Reuse our own
            # lock, and isolate error() so cleanup preserves the build's status.
            (
              if [[ "$(cat "$BOXEN_LOCK_DIR/pid" 2>/dev/null)" != "$$" ]]; then
                boxen_lock || exit 1
              fi
              trap boxen_unlock EXIT
              egress_forget "$CONTAINER_NAME" "$egress"
            ) || warn "Could not remove $CONTAINER_NAME's proxy from $egress"
          fi
        else
          warn "Could not delete '$CONTAINER_NAME'"
        fi
      else
        warn "Container left in place. Clean up manually with: bxn rm $CONTAINER_NAME"
      fi
    fi
  fi
  exit "$rc"
}

# ---------------------------------------------------------------------------
# Defaults
# ---------------------------------------------------------------------------
WORKSPACE_PATH="$PWD"
CONTAINER_WORKSPACE="/workspace"
BASE_IMAGE="images:ubuntu/24.04"
CONTAINER_NAME=""
# Set once this run has created the instance: a run that loses a race for a
# name must never offer to delete the container that won it.
CREATED_INSTANCE=0
PROJECT=""
EXACT_NAME=""
HANDLE=""
# The agent's plugin slot, -1 for none (a shell), empty until chosen.
AGENT_SLOT=""
AGENT_DEFAULT_SLOT=-1
DRY_RUN=0
NO_TUI=0
SAVE_TEMPLATE=0
TS_STATE_BACKUP=""
ACK_ENV=0
IS_VM=0
NO_COPY=0
PATH_GIVEN=0
# A repository to clone into the workspace (bxn create <project> <url>), as
# https://github.com/OWNER/REPO, and whether the clone worked.
REPO_URL=""
REPO_CLONED=0
VM_OPT_SET=0
VM_DISK="20GiB"
VM_MEMORY="4GiB"
VM_CPUS="4"
MEMORY=""          # --memory, for either type
MEMORY_LIMIT=""    # a container's own limits.memory; empty leaves the profile's
MEMORY_SHOWN=""    # what the instance gets, and why, for the summaries
MEMORY_WHY=""
READY_TIMEOUT=30
INSECURE_NETWORK="${BOXEN_INSECURE_NETWORK:-0}"
EGRESS_MODE=""
EGRESS_GROUP=""

# ---------------------------------------------------------------------------
# Plugin discovery — reads built-in plugins/*.sh plus user plugins from
# ${XDG_DATA_HOME:-~/.local/share}/boxen/plugins/*.sh
# ---------------------------------------------------------------------------
SCRIPT_DIR="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")" && pwd)"
# The plugin source (boxen.plugins): the optional plugins come from plugins/
# or, with --plugins, BOXEN_PLUGINS_SOURCE or ~/.config/boxen/plugins-source,
# from a repository or directory of the user's in its place. Read here, before
# discovery; the parser below only consumes the flag.
# shellcheck source=boxen.plugins
source "$SCRIPT_DIR/boxen.plugins"
plugins_source_resolve "$@"
if [[ -n "$PLUGINS_SOURCE" ]]; then plugins_source_fetch "$PLUGINS_SOURCE"; fi

# Parallel arrays (bash 3.2 compatible — macOS /bin/bash has no associative arrays)
_P_ID=() _P_NAME=() _P_DESC=() _P_FILE=() _P_SELECTED=() _P_AGENT_COMMAND=()
_P_CLI_FLAGS=()            # effective metadata after user overrides
_P_FLAGS=() _P_FLAG_IDS=()   # parallel: _P_FLAGS[i] -> _P_FLAG_IDS[i]
PLUGIN_COUNT=0

# Find the slot index for a plugin ID; prints index or returns 1.
_plugin_slot() {
  local target="$1" i
  for ((i=0; i<PLUGIN_COUNT; i++)); do
    [[ "${_P_ID[$i]}" == "$target" ]] && { echo "$i"; return 0; }
  done
  return 1
}

selected_get() {
  local slot
  slot=$(_plugin_slot "$1") || { echo 0; return; }
  echo "${_P_SELECTED[$slot]:-0}"
}

selected_set() {
  local slot
  slot=$(_plugin_slot "$1") || return 1
  _P_SELECTED[$slot]="$2"
}

flag_to_id() {
  local target="$1" i
  for ((i=0; i<${#_P_FLAGS[@]}; i++)); do
    [[ "${_P_FLAGS[$i]}" == "$target" ]] && { echo "${_P_FLAG_IDS[$i]}"; return 0; }
  done
  return 1
}

# Coding agents declare their executable in plugin metadata. Selection and
# launch guidance work the same for built-in and user-provided agents. A
# container has one agent, or none (a shell): agents working in one copy of
# the code would walk over each other.
agent_label() {
  if [[ "$1" == "-1" ]]; then echo "Shell (no agent)"; else echo "${_P_NAME[$1]}"; fi
}

# The agent's part of the container name: its command, or shell.
agent_token() {
  if [[ "$AGENT_SLOT" == "-1" ]]; then echo shell
  else printf '%s' "${_P_AGENT_COMMAND[$AGENT_SLOT]}" | tr 'A-Z' 'a-z' | tr -cd 'a-z0-9-'; fi
}

# Usage: set_agent_slot <slot|-1>
set_agent_slot() {
  local i
  if [[ -n "$AGENT_SLOT" && "$AGENT_SLOT" != "$1" ]]; then
    error "One agent per container: $(agent_label "$AGENT_SLOT") and $(agent_label "$1") were both chosen. Make a container for each."
  fi
  AGENT_SLOT="$1"
  for ((i=0; i<PLUGIN_COUNT; i++)); do
    [[ -n "${_P_AGENT_COMMAND[$i]}" ]] && _P_SELECTED[$i]=0
  done
  if [[ "$1" != "-1" ]]; then _P_SELECTED[$1]=1; fi
}

select_agent() {
  local target="$1" i flag_id
  if [[ "$target" == shell || "$target" == none ]]; then set_agent_slot -1; return 0; fi
  flag_id="$(flag_to_id "--$target" || true)"
  for ((i=0; i<PLUGIN_COUNT; i++)); do
    [[ -n "${_P_AGENT_COMMAND[$i]}" ]] || continue
    if [[ "$target" == "${_P_AGENT_COMMAND[$i]}" || "$target" == "${_P_ID[$i]}" || "$flag_id" == "${_P_ID[$i]}" ]]; then
      set_agent_slot "$i"
      return 0
    fi
  done
  error "Unknown coding agent: $target"
}

print_agent_launches() {
  local i launch
  for ((i=0; i<PLUGIN_COUNT; i++)); do
    [[ "${_P_SELECTED[$i]}" == "1" && -n "${_P_AGENT_COMMAND[$i]}" ]] || continue
    _plugin_failed "${_P_ID[$i]}" && continue
    printf 'Start %s:\n' "${_P_NAME[$i]}"
    printf -v launch 'cd %q && %q' "$CONTAINER_WORKSPACE" "${_P_AGENT_COMMAND[$i]}"
    printf '  bxn -s %q %q\n' "$CONTAINER_NAME" "$launch"
  done
}

# The command that logs a tool in, for each plugin that names one
# (PLUGIN_LOGIN_COMMAND) and whose tool is installed: a template's tools
# count, whatever this launch picked. A login takes an account's password, so
# the build leaves it to the user and says how: in the short form, from the host.
# A plugin that can't say whether it's installed is taken at this launch's word.
print_plugin_logins() {
  local i cmd
  for ((i=0; i<PLUGIN_COUNT; i++)); do
    _plugin_failed "${_P_ID[$i]}" && continue
    cmd="$(
      _reset_plugin_state
      source "${_P_FILE[$i]}"
      [[ -n "$PLUGIN_LOGIN_COMMAND" ]] || exit 0
      if declare -F plugin_is_installed >/dev/null; then
        plugin_is_installed </dev/null >/dev/null 2>&1 || exit 0
      else
        [[ "${_P_SELECTED[$i]}" == "1" ]] || exit 0
      fi
      echo "$PLUGIN_LOGIN_COMMAND"
    )"
    [[ -n "$cmd" ]] || continue
    printf 'Log in to %s:\n' "${_P_NAME[$i]}"
    printf '  bxn %q %s\n' "$CONTAINER_NAME" "$cmd"
  done
}

# Discover built-in plugins first, then the plugin source's, then user plugins.
# With a source, only the built-in agents are kept. On PLUGIN_ID collision the
# later plugin overrides (logged). Final order is sorted A-Z by PLUGIN_NAME
# below — drives both TUI display and install order.
for _dir in "$BUILTIN_PLUGINS_DIR" "$SOURCE_PLUGINS_DIR" "$USER_PLUGINS_DIR"; do
  [[ -n "$_dir" && -d "$_dir" ]] || continue
  for _f in "$_dir"/*.sh; do
    [[ -f "$_f" ]] || continue
    _meta=$(bash -c '
      PLUGIN_ID="" PLUGIN_NAME="" PLUGIN_DESC="" PLUGIN_DEFAULT=0
      PLUGIN_CLI_FLAGS="" PLUGIN_NEEDS_PROMPT=0 PLUGIN_RUN_ON_LAUNCH=0
      PLUGIN_AGENT_COMMAND=""
      source "$1" 2>/dev/null
      printf "%s\n%s\n%s\n%s\n%s\n%s\n%s\n%s\n" \
        "$PLUGIN_ID" "$PLUGIN_NAME" "$PLUGIN_DESC" "$PLUGIN_DEFAULT" \
        "$PLUGIN_CLI_FLAGS" "$PLUGIN_NEEDS_PROMPT" "$PLUGIN_RUN_ON_LAUNCH" "$PLUGIN_AGENT_COMMAND"
    ' _ "$_f")

    # Read one field per line so empty optional values keep their position.
    {
      IFS= read -r _pid
      IFS= read -r _pname
      IFS= read -r _pdesc
      IFS= read -r _pdefault
      IFS= read -r _pcli
      IFS= read -r _pprompt
      IFS= read -r _plaunch
      IFS= read -r _pagent || true
    } <<< "$_meta"
    [[ -z "$_pid" ]] && continue
    # The source replaces our optional plugins, not the agents.
    [[ -n "$SOURCE_PLUGINS_DIR" && "$_dir" == "$BUILTIN_PLUGINS_DIR" && -z "$_pagent" ]] && continue

    if _existing=$(_plugin_slot "$_pid"); then
      echo "[!] Plugin '$_pid' from $_f overrides ${_P_FILE[$_existing]}" >&2
      _P_NAME[$_existing]="$_pname"
      _P_DESC[$_existing]="$_pdesc"
      _P_FILE[$_existing]="$_f"
      _P_SELECTED[$_existing]="${_pdefault:-0}"
      _P_AGENT_COMMAND[$_existing]="$_pagent"
      _P_CLI_FLAGS[$_existing]="$_pcli"
      continue
    fi

    _i=$PLUGIN_COUNT
    _P_ID[$_i]="$_pid"
    _P_NAME[$_i]="$_pname"
    _P_DESC[$_i]="$_pdesc"
    _P_FILE[$_i]="$_f"
    _P_SELECTED[$_i]="${_pdefault:-0}"
    _P_AGENT_COMMAND[$_i]="$_pagent"
    _P_CLI_FLAGS[$_i]="$_pcli"

    PLUGIN_COUNT=$((_i + 1))
  done
done
# Build aliases only from the final plugin definitions. Replaced definitions
# must not leave their flags attached to a user plugin that did not declare them.
for ((_i=0; _i<PLUGIN_COUNT; _i++)); do
  for _flag in ${_P_CLI_FLAGS[$_i]}; do
    _P_FLAGS+=("$_flag")
    _P_FLAG_IDS+=("${_P_ID[$_i]}")
  done
done
unset _P_CLI_FLAGS
unset _dir _f _meta _i _pid _pname _pdesc _pdefault _pcli _pprompt _plaunch _pagent _flag _existing

# Sort plugins by PLUGIN_NAME, case-insensitive A-Z (stable).
if (( PLUGIN_COUNT > 1 )); then
  _sort_lines=""
  for ((_i=0; _i<PLUGIN_COUNT; _i++)); do
    _sort_lines+="${_P_NAME[$_i]}"$'\t'"$_i"$'\n'
  done
  _new_ID=() _new_NAME=() _new_DESC=() _new_FILE=() _new_SELECTED=() _new_AGENT_COMMAND=()
  while IFS=$'\t' read -r _name _slot; do
    _new_ID+=("${_P_ID[$_slot]}")
    _new_NAME+=("${_P_NAME[$_slot]}")
    _new_DESC+=("${_P_DESC[$_slot]}")
    _new_FILE+=("${_P_FILE[$_slot]}")
    _new_SELECTED+=("${_P_SELECTED[$_slot]}")
    _new_AGENT_COMMAND+=("${_P_AGENT_COMMAND[$_slot]}")
  done < <(printf '%s' "$_sort_lines" | sort -f -s -t$'\t' -k1,1)
  _P_ID=("${_new_ID[@]}")
  _P_NAME=("${_new_NAME[@]}")
  _P_DESC=("${_new_DESC[@]}")
  _P_FILE=("${_new_FILE[@]}")
  _P_SELECTED=("${_new_SELECTED[@]}")
  _P_AGENT_COMMAND=("${_new_AGENT_COMMAND[@]}")
  unset _new_ID _new_NAME _new_DESC _new_FILE _new_SELECTED _new_AGENT_COMMAND _sort_lines _name _slot _i
fi

# Agents aren't preselected like plugins: one marked default only places the
# picker's cursor, and becomes the choice under --no-tui.
for ((_i=0; _i<PLUGIN_COUNT; _i++)); do
  [[ -n "${_P_AGENT_COMMAND[$_i]}" ]] || continue
  if [[ "${_P_SELECTED[$_i]}" == "1" && "$AGENT_DEFAULT_SLOT" == "-1" ]]; then AGENT_DEFAULT_SLOT=$_i; fi
  _P_SELECTED[$_i]=0
done

# Build the PLUGINS array the TUI expects (id:name:desc:default)
PLUGINS=()
for ((_i=0; _i<PLUGIN_COUNT; _i++)); do
  PLUGINS+=("${_P_ID[$_i]}:${_P_NAME[$_i]}:${_P_DESC[$_i]}:${_P_SELECTED[$_i]}")
done
unset _i

# ---------------------------------------------------------------------------
# TUI plugin selector
# ---------------------------------------------------------------------------
# The agent picker: one choice, a shell (no agent) first.
show_agent_tui() {
  local rows=(-1) cursor=0 i key seq slot
  for ((i=0; i<PLUGIN_COUNT; i++)); do
    [[ -n "${_P_AGENT_COMMAND[$i]}" ]] || continue
    rows+=("$i")
    [[ "$i" == "$AGENT_DEFAULT_SLOT" ]] && cursor=$((${#rows[@]} - 1))
  done
  # No agent plugins: nothing to pick.
  if (( ${#rows[@]} == 1 )); then set_agent_slot -1; return 0; fi
  tput civis 2>/dev/null || true
  trap 'tput cnorm 2>/dev/null || true' RETURN
  while true; do
    printf '\033[2J\033[H'
    echo -e "${GREEN}+------------------------------------------------------+${NC}"
    echo -e "${GREEN}|${NC}  Pick the coding agent: one per container           ${GREEN}|${NC}"
    echo -e "${GREEN}+------------------------------------------------------+${NC}"
    echo -e "${GREEN}|${NC}  Up/Down or j/k: navigate   Enter: choose   q: quit ${GREEN}|${NC}"
    echo -e "${GREEN}+------------------------------------------------------+${NC}"
    echo ""
    for ((i=0; i<${#rows[@]}; i++)); do
      slot=${rows[$i]}
      if [[ $i -eq $cursor ]]; then
        printf "  \033[7m %-26s \033[0m\n" "$(agent_label "$slot")"
      else
        printf "   %-26s\n" "$(agent_label "$slot")"
      fi
    done
    echo ""
    IFS= read -rsn1 key
    case "$key" in
      $'\x1b')
        IFS= read -rsn2 -t 1 seq || continue
        case "$seq" in
          '[A') cursor=$(( (cursor - 1 + ${#rows[@]}) % ${#rows[@]} )) ;;
          '[B') cursor=$(( (cursor + 1) % ${#rows[@]} )) ;;
        esac
        ;;
      'k') cursor=$(( (cursor - 1 + ${#rows[@]}) % ${#rows[@]} )) ;;
      'j') cursor=$(( (cursor + 1) % ${#rows[@]} )) ;;
      ''|$'\n') break ;;
      'q')
        tput cnorm 2>/dev/null || true
        echo "Aborted."
        exit 1
        ;;
    esac
  done
  tput cnorm 2>/dev/null || true
  printf '\033[2J\033[H'
  set_agent_slot "${rows[$cursor]}"
}

# The plugin picker. Agents have their own picker, so they aren't listed.
show_tui() {
  local rows=() cursor=0 i slot
  local key seq marker id name desc default
  for ((i=0; i<${#PLUGINS[@]}; i++)); do
    [[ -n "${_P_AGENT_COMMAND[$i]}" ]] || rows+=("$i")
  done
  local count=${#rows[@]}
  (( count > 0 )) || return 0

  tput civis 2>/dev/null || true
  trap 'tput cnorm 2>/dev/null || true' RETURN

  while true; do
    printf '\033[2J\033[H'
    echo -e "${GREEN}+------------------------------------------------------+${NC}"
    echo -e "${GREEN}|${NC}  Select plugins to install                           ${GREEN}|${NC}"
    echo -e "${GREEN}+------------------------------------------------------+${NC}"
    echo -e "${GREEN}|${NC}  Up/Down or j/k: navigate   Space: toggle   Enter: go${GREEN}|${NC}"
    echo -e "${GREEN}|${NC}  q: quit                                             ${GREEN}|${NC}"
    echo -e "${GREEN}+------------------------------------------------------+${NC}"
    echo ""

    for ((i=0; i<count; i++)); do
      slot=${rows[$i]}
      IFS=: read -r id name desc default <<< "${PLUGINS[$slot]}"
      marker="[ ]"
      [[ "${_P_SELECTED[$slot]}" == "1" ]] && marker="[x]"

      if [[ $i -eq $cursor ]]; then
        printf "  \033[7m %s %-24s %s \033[0m\n" "$marker" "$name" "$desc"
      else
        printf "   %s %-24s %s\n" "$marker" "$name" "$desc"
      fi
    done

    echo ""

    IFS= read -rsn1 key

    case "$key" in
      $'\x1b')
        IFS= read -rsn2 -t 1 seq || continue
        case "$seq" in
          '[A') cursor=$(( (cursor - 1 + count) % count )) ;;
          '[B') cursor=$(( (cursor + 1) % count )) ;;
        esac
        ;;
      'k') cursor=$(( (cursor - 1 + count) % count )) ;;
      'j') cursor=$(( (cursor + 1) % count )) ;;
      ' ')
        slot=${rows[$cursor]}
        if [[ "${_P_SELECTED[$slot]}" == "1" ]]; then
          _P_SELECTED[$slot]=0
        else
          _P_SELECTED[$slot]=1
        fi
        ;;
      ''|$'\n') break ;;
      'q')
        tput cnorm 2>/dev/null || true
        echo "Aborted."
        exit 1
        ;;
    esac
  done

  tput cnorm 2>/dev/null || true
  printf '\033[2J\033[H'
}

# ---------------------------------------------------------------------------
# Core install functions (not plugins)
# ---------------------------------------------------------------------------
install_ohmyzsh() {
  log "Installing Oh My Zsh..."
  incus exec "$CONTAINER_NAME" -- su - "$HOST_USER" -c 'bash -s' <<'ZSHEOF'
  set -e
  sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended

  sed -i 's/^ZSH_THEME=".*"/ZSH_THEME="dpoggi"/' ~/.zshrc

  # Add [incus] prefix to prompt
  cat >> ~/.zshrc <<'RCBLOCK'

# [incus] prompt prefix
PROMPT="%{$fg[cyan]%}[incus]%{$reset_color%} ${PROMPT%»*}%{$reset_color%}"$'\n'"» "
RCBLOCK

  # Plugins
  git clone https://github.com/zsh-users/zsh-autosuggestions \
    ${ZSH_CUSTOM:-~/.oh-my-zsh/custom}/plugins/zsh-autosuggestions
  sed -i 's/^plugins=(git)/plugins=(git zsh-autosuggestions)/' ~/.zshrc
ZSHEOF
}


# ---------------------------------------------------------------------------
# Component dispatch helpers
# ---------------------------------------------------------------------------
# Source a plugin file and call its functions. We iterate _P_FILE
# (sorted A-Z by PLUGIN_NAME during discovery) so install order matches the
# TUI display order and is identical across hosts.
#
# Sourced plugin files do not overwrite metadata vars or functions they don't
# declare, so without an explicit reset, values leak from one plugin to the
# next (e.g. PLUGIN_NEEDS_PROMPT=1 and plugin_prompt from 1pass would carry
# over to a later plugin that selected without one).
_reset_plugin_state() {
  PLUGIN_ID="" PLUGIN_NAME="" PLUGIN_DESC="" PLUGIN_DEFAULT=0
  PLUGIN_CLI_FLAGS="" PLUGIN_NEEDS_PROMPT=0 PLUGIN_RUN_ON_LAUNCH=0
  PLUGIN_REQUIRES="" PLUGIN_AGENT_COMMAND="" PLUGIN_PHASE="" PLUGIN_EGRESS_ALLOW="" PLUGIN_MIN_MEMORY=""
  PLUGIN_LOGIN_COMMAND=""
  unset -f plugin_prompt plugin_is_installed plugin_install plugin_on_launch plugin_proxy 2>/dev/null || true
}

# Proxy settings a tool keeps in its own files, not the environment. Every
# plugin that declares plugin_proxy and whose tool is installed gets PROXY_URL
# (empty: remove the settings) and PROXY_NO_PROXY. Installed, not selected:
# a template's tools count, whatever this launch picked.
# Usage: _run_plugin_proxy_hooks <url|"">
_run_plugin_proxy_hooks() {
  local url="$1" i
  for ((i=0; i<PLUGIN_COUNT; i++)); do
    _reset_plugin_state
    source "${_P_FILE[$i]}"
    declare -F plugin_proxy >/dev/null || continue
    declare -F plugin_is_installed >/dev/null && plugin_is_installed || continue
    PROXY_URL="$url" PROXY_NO_PROXY="$EGRESS_NO_PROXY" _run_plugin_hook plugin_proxy
  done
}

_run_plugin_prompts() {
  local i
  for ((i=0; i<PLUGIN_COUNT; i++)); do
    _reset_plugin_state
    source "${_P_FILE[$i]}"
    [[ "$(selected_get "$PLUGIN_ID")" != "1" ]] && continue
    [[ "${PLUGIN_NEEDS_PROMPT:-0}" != "1" ]] && continue
    plugin_prompt
  done
}

# Run a plugin hook in a subshell so one plugin's failure can't kill the whole
# build. Under plain set -e, a failing plugin_install aborted the script and
# silently skipped every plugin sorted after it. The subshell re-enables set -e
# so the plugin itself still stops at its first error; the
# parent records the failure and moves on. Failures are listed in the summary.
FAILED_PLUGIN_NAMES=()
FAILED_PLUGIN_IDS=()
_run_plugin_hook() {
  local hook="$1" rc=0
  set +e
  ( set -e; "$hook" )
  rc=$?
  set -e
  if [[ $rc -ne 0 ]]; then
    warn "$PLUGIN_NAME: $hook failed (exit $rc) — continuing with remaining plugins"
    FAILED_PLUGIN_NAMES+=("$PLUGIN_NAME")
    FAILED_PLUGIN_IDS+=("$PLUGIN_ID")
  fi
}

_plugin_failed() {
  local n
  for n in ${FAILED_PLUGIN_IDS[@]+"${FAILED_PLUGIN_IDS[@]}"}; do
    [[ "$n" == "$1" ]] && return 0
  done
  return 1
}

# A plugin's build phase under an allowlist: "open" plugins install before
# the lock, "locked" ones after it, with the workspace. A plugin that takes a
# credential (it prompts) is locked unless it says otherwise.
_plugin_phase() {
  if [[ -n "${PLUGIN_PHASE:-}" ]]; then echo "$PLUGIN_PHASE"
  elif [[ "${PLUGIN_NEEDS_PROMPT:-0}" == "1" ]]; then echo locked
  else echo open; fi
}

# Usage: _run_plugin_installs <from_template> [open|locked|all]
_run_plugin_installs() {
  local from_template="$1" phase="${2:-all}"
  local i
  for ((i=0; i<PLUGIN_COUNT; i++)); do
    _reset_plugin_state
    source "${_P_FILE[$i]}"
    [[ "$(selected_get "$PLUGIN_ID")" != "1" ]] && continue
    [[ "$phase" == all || "$(_plugin_phase)" == "$phase" ]] || continue

    if [[ "$from_template" == "1" ]]; then
      # Template launch dispatch:
      #   not installed                     -> plugin_install (added on top of template)
      #   installed + NEEDS_PROMPT=1        -> plugin_install (re-apply prompted token/config)
      #   installed + RUN_ON_LAUNCH=1       -> plugin_on_launch (symlinks/config hooks)
      #   otherwise                         -> skip (already baked in)
      local _installed=0
      if declare -F plugin_is_installed >/dev/null && plugin_is_installed; then
        _installed=1
      fi
      if [[ "$_installed" == "0" ]]; then
        _run_plugin_hook plugin_install
      elif [[ "${PLUGIN_NEEDS_PROMPT:-0}" == "1" ]]; then
        _run_plugin_hook plugin_install
      elif [[ "${PLUGIN_RUN_ON_LAUNCH:-0}" == "1" ]] && declare -F plugin_on_launch >/dev/null; then
        _run_plugin_hook plugin_on_launch
      fi
    else
      # Fresh install
      if declare -F plugin_is_installed >/dev/null && plugin_is_installed; then
        log "$PLUGIN_NAME already installed, skipping"
        continue
      fi
      _run_plugin_hook plugin_install
    fi
  done
}

# Tailscale keeps the node key, and the certificates `tailscale serve` obtained
# for the node, under /var/lib/tailscale. Baked into a template, every launch
# would come up as this machine with its tailnet access. So the directory is
# moved out to a private file while the image is published, then put back.
stash_tailscale_state() {
  # An exec error must not read as "no state": that would publish the key.
  local state
  state="$(incus exec "$CONTAINER_NAME" -- sh -c 'test -d /var/lib/tailscale && echo yes || echo no' </dev/null)" || state=""
  case "$state" in
    no)  return 0 ;;
    yes) ;;
    *)   error "Could not check $CONTAINER_NAME for Tailscale state. No template saved: it might carry the node key." ;;
  esac
  log "Removing the Tailscale node identity from the image..."
  incus exec "$CONTAINER_NAME" -- systemctl stop tailscaled </dev/null 2>/dev/null || true
  # A tailscaled still running could write the state back before the publish.
  # Only a stopped (or absent) service lets it go ahead; so does no answer.
  local active
  active="$(incus exec "$CONTAINER_NAME" -- systemctl is-active tailscaled </dev/null 2>/dev/null)" || true
  case "$active" in
    inactive|failed|unknown) ;;
    *) error "Could not stop tailscaled in $CONTAINER_NAME. No template saved: it might write the node key back." ;;
  esac
  TS_STATE_BACKUP="$(mktemp "${XDG_RUNTIME_DIR:-/tmp}/boxen-tailscale.XXXXXX")"
  incus exec "$CONTAINER_NAME" -- tar -C /var/lib -cf - tailscale > "$TS_STATE_BACKUP"
  incus exec "$CONTAINER_NAME" -- rm -rf /var/lib/tailscale
}

# Idempotent: nothing stashed, or already restored, is a success.
restore_tailscale_state() {
  [[ -n "${TS_STATE_BACKUP:-}" && -f "$TS_STATE_BACKUP" ]] || return 0
  # From the exit trap, publish or start may have failed with the container
  # stopped. Start it and wait, without error(): that would exit the trap.
  local status elapsed=0
  status="$(incus list "^${CONTAINER_NAME}$" --format csv --columns s 2>/dev/null)"
  if [[ "$status" != "RUNNING" ]]; then
    incus start "$CONTAINER_NAME" >/dev/null 2>&1 || return 1
  fi
  until incus exec "$CONTAINER_NAME" -- true </dev/null >/dev/null 2>&1; do
    (( elapsed++ < ${READY_TIMEOUT:-30} )) || return 1
    sleep 1
  done
  # tailscaled came back up at boot with a fresh, logged-out state; replace it.
  incus exec "$CONTAINER_NAME" -- systemctl stop tailscaled 2>/dev/null || true
  incus exec "$CONTAINER_NAME" -- tar -C /var/lib -xf - < "$TS_STATE_BACKUP" || return 1
  # The state is back in place, so the host copy of the node key can go.
  rm -f "$TS_STATE_BACKUP"
  TS_STATE_BACKUP=""
  incus exec "$CONTAINER_NAME" -- systemctl start tailscaled </dev/null || \
    warn "Tailscale state is restored in $CONTAINER_NAME, but tailscaled did not start. Start it: incus exec $CONTAINER_NAME -- systemctl start tailscaled"
}

# ---------------------------------------------------------------------------
# Copy the workspace in. The host directory is copied once and never mounted:
# nothing the container writes reaches the host, which sees only the work that
# leaves through git.
# ---------------------------------------------------------------------------
copy_workspace() {
  local existing
  # A template built before templates were emptied carries a workspace owned
  # by whoever built it. If our UID differs those files are unwritable (git
  # commit fails on .git/index.lock), so re-own them rather than error. Files
  # in a workspace that did not come from a template are a mistake: stop.
  existing="$(incus exec "$CONTAINER_NAME" -- ls -A "$CONTAINER_WORKSPACE" 2>/dev/null </dev/null || true)"
  if [[ -n "$existing" ]]; then
    [[ "$FROM_BASE_IMAGE" == "1" ]] || \
      error "$CONTAINER_WORKSPACE is not empty inside the container: $BASE_IMAGE already has files there."
    log "Reusing workspace from template; re-owning to $HOST_USER..."
  else
    incus exec "$CONTAINER_NAME" -- mkdir -p "$CONTAINER_WORKSPACE" </dev/null
    # The working tree as it is on disk, .git and uncommitted work included.
    # Extracted as the container's root (--no-same-owner), then handed to the
    # user. Template builds and --no-copy start empty.
    if [[ "$SAVE_TEMPLATE" != "1" && "$NO_COPY" != "1" ]]; then
      log "Copying $WORKSPACE_PATH into $CONTAINER_WORKSPACE (includes .git)..."
      tar -C "$WORKSPACE_PATH" -cf - . \
        | incus exec "$CONTAINER_NAME" -- tar --no-same-owner -C "$CONTAINER_WORKSPACE" -xf -
    fi
  fi
  incus exec "$CONTAINER_NAME" -- chown -R "$HOST_USER:$HOST_USER" "$CONTAINER_WORKSPACE" </dev/null
  # Git refuses a repository it considers someone else's ("dubious ownership").
  local ws_q
  printf -v ws_q '%q' "$CONTAINER_WORKSPACE"
  incus exec "$CONTAINER_NAME" -- su - "$HOST_USER" -c \
    "git config --global --add safe.directory $ws_q 2>/dev/null || true"
}

# ---------------------------------------------------------------------------
# Git identity for commits in the container. It's what git itself would use
# in the folder being copied: that repository's own config and any includeIf
# matching its path (a work email for ~/work), else the global identity. Set
# on every build, whatever plugins are chosen, so commits never fail with
# "Please tell me who you are". A template build doesn't carry anyone's.
# ---------------------------------------------------------------------------
GIT_NAME="" GIT_EMAIL="" GIT_ID_SOURCE=""

# Global lookups follow include.path, as git does, but run from / so that no
# includeIf for the current folder counts as global.
# Usage: _host_git_config <key>
_host_git_config() {
  local v=""
  if [[ "$SAVE_TEMPLATE" != "1" && "$NO_COPY" != "1" && -d "$WORKSPACE_PATH" ]]; then
    v="$(git -C "$WORKSPACE_PATH" config --get "$1" 2>/dev/null)" || v=""
  fi
  [[ -n "$v" ]] || v="$(git -C / config --global --includes --get "$1" 2>/dev/null)" || v=""
  printf '%s' "$v"
}

# An email as git means it. Git takes "<foo@example.com>" as foo@example.com
# when it writes a commit, so a config with the brackets works on the host;
# copied as is, they'd reach every tool in the container that reads
# user.email. Strips surrounding spaces and one pair of angle brackets.
_git_email_clean() {
  local e="$1"
  e="${e#"${e%%[![:space:]]*}"}"; e="${e%"${e##*[![:space:]]}"}"
  if [[ "$e" == "<"*">" ]]; then
    e="${e#<}"; e="${e%>}"
    e="${e#"${e%%[![:space:]]*}"}"; e="${e%"${e##*[![:space:]]}"}"
  fi
  printf '%s' "$e"
}

capture_git_identity() {
  local name email
  command -v git >/dev/null 2>&1 || return 0
  name="$(_host_git_config user.name)"
  email="$(_git_email_clean "$(_host_git_config user.email)")"
  # One line each: they go to the container as lines on stdin.
  [[ "$name$email" != *$'\n'* ]] || { name=""; email=""; }
  if [[ -n "$name" && -n "$email" ]]; then
    GIT_NAME="$name" GIT_EMAIL="$email"
    if [[ "$SAVE_TEMPLATE" != "1" && "$NO_COPY" != "1" ]] &&
       [[ "$(_git_email_clean "$(git -C / config --global --includes --get user.email 2>/dev/null)")" != "$email" ||
          "$(git -C / config --global --includes --get user.name 2>/dev/null)" != "$name" ]]; then
      GIT_ID_SOURCE="$WORKSPACE_PATH's git config"
    else
      GIT_ID_SOURCE="your global git config"
    fi
  fi
}

# Ask only when the host has no identity, on a terminal, and not for a template.
prompt_git_identity() {
  [[ -z "$GIT_NAME" || -z "$GIT_EMAIL" ]] || return 0
  [[ "$SAVE_TEMPLATE" != "1" && "$DRY_RUN" != "1" && -t 0 ]] || return 0
  echo ""
  log "Git has no user.name or user.email on this host. Commits in $CONTAINER_NAME use these:"
  read_value GIT_NAME "Git user.name: "
  read_value GIT_EMAIL "Git user.email: "
  GIT_EMAIL="$(_git_email_clean "$GIT_EMAIL")"
  if [[ -n "$GIT_NAME" && -n "$GIT_EMAIL" ]]; then GIT_ID_SOURCE="what you entered"
  else GIT_NAME="" GIT_EMAIL=""; fi
}

# The values go in as lines on stdin, read by the remote shell: never part of
# a command string, so any character in a name is safe.
write_git_identity() {
  [[ "$SAVE_TEMPLATE" != "1" ]] || return 0
  if [[ -z "$GIT_NAME" || -z "$GIT_EMAIL" ]]; then
    warn "No git identity, so commits in $CONTAINER_NAME fail until you set one: bxn -s $CONTAINER_NAME git config --global user.name \"Your Name\" (and user.email)"
    return 0
  fi
  printf '%s\n%s\n' "$GIT_NAME" "$GIT_EMAIL" | incus exec "$CONTAINER_NAME" -- su - "$HOST_USER" -s /bin/sh -c \
    'IFS= read -r n && IFS= read -r e && git config --global user.name "$n" && git config --global user.email "$e"' ||
    { warn "Could not set the git identity in $CONTAINER_NAME"; return 0; }
  log "Git identity: $GIT_NAME <$GIT_EMAIL>, from $GIT_ID_SOURCE"
}

# The egress hosts the selected plugins ask for (PLUGIN_EGRESS_ALLOW).
_selected_plugin_hosts() {
  local i
  for ((i=0; i<PLUGIN_COUNT; i++)); do
    [[ "${_P_SELECTED[$i]}" == "1" ]] || continue
    ( _reset_plugin_state; source "${_P_FILE[$i]}"; echo "${PLUGIN_EGRESS_ALLOW:-}" )
  done
}

# ---------------------------------------------------------------------------
# Memory. An instance gets --memory, else the largest PLUGIN_MIN_MEMORY among
# the selected plugins when that beats the default (the boxen profile's limit
# for a container, 4GiB for a VM). A plugin's floor is for what it runs: the
# local Supabase stack wants more than most whole projects. The build is
# refused when the host can't back the figure with 2GiB left over: a VM
# really takes it, and a container's cap shouldn't promise what isn't there.
# ---------------------------------------------------------------------------

# Bytes for an Incus size: 8GiB, 6GB, 512MiB, 1073741824. Fails on anything else.
size_to_bytes() {
  local n unit
  [[ "$1" =~ ^([0-9]+)[[:space:]]*(B|kB|KB|KiB|MB|MiB|GB|GiB|TB|TiB)?$ ]] || return 1
  n=${BASH_REMATCH[1]} unit=${BASH_REMATCH[2]}
  case "$unit" in
    ""|B) echo "$n" ;;
    kB|KB) echo $((n * 1000)) ;;
    KiB)   echo $((n * 1024)) ;;
    MB)    echo $((n * 1000000)) ;;
    MiB)   echo $((n * 1048576)) ;;
    GB)    echo $((n * 1000000000)) ;;
    GiB)   echo $((n * 1073741824)) ;;
    TB)    echo $((n * 1000000000000)) ;;
    TiB)   echo $((n * 1099511627776)) ;;
  esac
}

# GiB to one decimal, for messages.
bytes_to_gib() {
  local t=$(( $1 * 10 / 1073741824 ))
  echo "$((t / 10)).$((t % 10))GiB"
}

# The memory of the machine Incus runs on, in bytes: on macOS that's Colima's
# VM. Asked of Incus first, through the resources API with jq, else from the
# "Total:" line of incus info --resources (rounded, e.g. 62.69GiB), and only
# then from /proc/meminfo, which is the same machine on Linux. Empty when
# none of them answers.
host_memory_bytes() {
  local v="" t unit frac
  if command -v jq >/dev/null 2>&1; then
    v="$(incus query /1.0/resources 2>/dev/null | jq -r '.memory.total // empty' 2>/dev/null)" || v=""
  fi
  if ! [[ "$v" =~ ^[0-9]+$ ]]; then
    v=""
    t="$(incus info --resources 2>/dev/null | awk '/^Memory:/ { m=1; next } m && /^ *Total:/ { print $2; exit }')"
    if [[ "$t" =~ ^([0-9]+)(\.([0-9]+))?(B|kB|KB|KiB|MB|MiB|GB|GiB|TB|TiB)?$ ]]; then
      unit="$(size_to_bytes "1${BASH_REMATCH[4]}")" frac="${BASH_REMATCH[3]}"
      v=$(( 10#${BASH_REMATCH[1]} * unit ))
      [[ -z "$frac" ]] || v=$(( v + 10#$frac * unit / 10 ** ${#frac} ))
    fi
  fi
  if [[ -z "$v" && -r /proc/meminfo ]]; then
    v="$(awk '/^MemTotal:/ { printf "%d", $2 * 1024; exit }' /proc/meminfo)"
  fi
  [[ "$v" =~ ^[0-9]+$ ]] && echo "$v"
  return 0
}

# Sets MEMORY_LIMIT, MEMORY_SHOWN and MEMORY_WHY (and VM_MEMORY for a VM).
resolve_memory() {
  local default want want_bytes floor_bytes=0 floor="" floor_by="" i min b host headroom=$((2 * 1073741824)) where=""
  if [[ "$IS_VM" == "1" ]]; then default="$VM_MEMORY"; else default="$AGENT_PROFILE_MEMORY"; fi
  if [[ -n "$MEMORY" ]]; then
    want_bytes="$(size_to_bytes "$MEMORY")" || error "--memory must be a size such as 8GiB or 6GB (got: $MEMORY)"
    want="$MEMORY" MEMORY_WHY="--memory"
  else
    want="$default" MEMORY_WHY="default"
    want_bytes="$(size_to_bytes "$default")" || error "The default memory isn't a size: $default"
  fi
  for ((i=0; i<PLUGIN_COUNT; i++)); do
    [[ "${_P_SELECTED[$i]}" == "1" ]] || continue
    min="$( _reset_plugin_state; source "${_P_FILE[$i]}"; echo "${PLUGIN_MIN_MEMORY:-}" )"
    [[ -n "$min" ]] || continue
    b="$(size_to_bytes "$min")" || { warn "${_P_NAME[$i]}: PLUGIN_MIN_MEMORY '$min' isn't a size; ignored"; continue; }
    if (( b > floor_bytes )); then floor_bytes=$b floor="$min" floor_by="${_P_NAME[$i]}"; fi
  done
  if (( floor_bytes > want_bytes )); then
    want="$floor" want_bytes=$floor_bytes MEMORY_WHY="$floor_by needs at least $floor"
  fi
  host="$(host_memory_bytes)"
  if [[ -z "$host" ]]; then
    warn "Couldn't read this host's memory from Incus or /proc/meminfo, so whether it can back $want wasn't checked"
  elif (( want_bytes > host - headroom )); then
    if [[ "$IS_VM" != "1" && "$MEMORY_WHY" == default ]]; then
      # Nothing asked for this: it's the profile's cap, which a container
      # doesn't reserve, so a small host still builds as it always has.
      warn "This host has $(bytes_to_gib "$host") of memory, less than the profile's $want limit plus 2GiB; $CONTAINER_NAME can use up to that. Set a lower limit with --memory."
    else
      [[ "$(uname)" == Darwin ]] && where=" Here that's Colima's VM, which --colima-memory sizes only when it's first made; to resize it: colima stop -p ${COLIMA_PROFILE:-boxen} && colima start -p ${COLIMA_PROFILE:-boxen} --memory N."
      error "This host has $(bytes_to_gib "$host") of memory; $CONTAINER_NAME would get $want ($MEMORY_WHY), leaving it less than 2GiB.$where Choose less with --memory."
    fi
  fi
  if [[ "$IS_VM" == "1" ]]; then
    VM_MEMORY="$want"
  elif [[ "$MEMORY_WHY" != default ]]; then
    MEMORY_LIMIT="$want"
  fi
  MEMORY_SHOWN="$want"
  [[ "$MEMORY_WHY" == default || "$MEMORY_WHY" == --memory ]] || log "Memory: $want ($MEMORY_WHY)"
}

# The lock, between a fresh build's open and locked phases: the container's
# proxy, then the same lockdown `bxn egress mode` uses (stop, locked card, a
# new address, a verified proxy, start).
lock_build() {
  log "Turning on the allowlist ($EGRESS_MODE) before the workspace and credentials go in..."
  boxen_lock
  egress_ensure "$EGRESS_CONTAINER"
  egress_register "$CONTAINER_NAME" "$EGRESS_CONTAINER"
  egress_write_proxy_env "$CONTAINER_NAME"
  egress_lockdown "$CONTAINER_NAME"
  boxen_unlock
  incus config set "$CONTAINER_NAME" user.boxen.egress.build=locked
  NET_VIA_PROXY=1
  wait_for_container "$CONTAINER_NAME" "$READY_TIMEOUT"
  wait_for_network "$CONTAINER_NAME" "$READY_TIMEOUT"
}

# Settings a locked container needs, then the build is done:
# - github.com over HTTPS, since SSH (port 22) can't get out;
# - the proxy settings of tools that keep their own (plugin_proxy);
# - the login banner and the coding agents' note.
finish_locked_build() {
  incus exec "$CONTAINER_NAME" -- su - "$HOST_USER" -s /bin/sh -c 'sh -s' <<'GITCFG' || warn "Could not point github remotes at HTTPS"
git config --global url."https://github.com/".insteadOf "git@github.com:"
git config --global --add url."https://github.com/".insteadOf "ssh://git@github.com/"
GITCFG
  _run_plugin_proxy_hooks "$(egress_proxy_url "$CONTAINER_NAME")"
  egress_write_notices "$CONTAINER_NAME" "$HOST_USER"
  egress_commit "$CONTAINER_NAME"
  incus config set "$CONTAINER_NAME" user.boxen.egress.build=done
}

# Node's built-in fetch reads proxy settings only from v22.21 and v24.
warn_old_node() {
  local v="" f major minor
  for f in .nvmrc .node-version; do
    [[ -f "$WORKSPACE_PATH/$f" ]] && v="$(tr -d ' v\r' < "$WORKSPACE_PATH/$f" | head -1)"
  done
  [[ -z "$v" && -f "$WORKSPACE_PATH/.tool-versions" ]] &&
    v="$(awk '$1 == "nodejs" || $1 == "node" { print $2; exit }' "$WORKSPACE_PATH/.tool-versions")"
  for f in mise.toml .mise.toml; do
    [[ -z "$v" && -f "$WORKSPACE_PATH/$f" ]] &&
      v="$(sed -nE 's/^[[:space:]]*node[[:space:]]*=[[:space:]]*"?v?([0-9][0-9.]*).*/\1/p' "$WORKSPACE_PATH/$f" | head -1)"
  done
  [[ "$v" =~ ^([0-9]+)(\.([0-9]+))? ]] || return 0
  major="${BASH_REMATCH[1]}" minor="${BASH_REMATCH[3]:-0}"
  if (( major < 22 || (major == 22 && minor < 21) || major == 23 )); then
    warn "The workspace pins Node $v. Its built-in fetch ignores proxy settings before v22.21 (and on v23), so it can't reach the internet under the allowlist. Upgrade Node, or use --egress off."
  fi
  return 0
}

save_template() {
  local alias="incus-init/$CONTAINER_NAME"
  log "Saving as local template: $alias (stored in local Incus image store)"

  # Save token lines from .zshenv, then strip them so they don't leak into the image
  local saved_tokens
  saved_tokens=$(incus exec "$CONTAINER_NAME" -- su - "$HOST_USER" -c \
    "grep -E '^export (GH_TOKEN|OP_SERVICE_ACCOUNT_TOKEN)=' ~/.zshenv 2>/dev/null || true")

  log "Scrubbing secrets from image..."
  incus exec "$CONTAINER_NAME" -- su - "$HOST_USER" -c \
    "sed -i '/^export OP_SERVICE_ACCOUNT_TOKEN=/d; /^export GH_TOKEN=/d' ~/.zshenv 2>/dev/null || true"

  # Empty the workspace before publishing. A template is a reusable *provisioned
  # base* (packages, mise, shell, tools) — not a frozen copy of one repo. Baking
  # the copy in also drags the builder's UID into every future container, where
  # it surfaces as the overflow UID 65534 (nobody). Leaving /workspace empty lets
  # each launch populate it fresh, owned by the launching user. The guard keeps a
  # misresolved CONTAINER_WORKSPACE from ever expanding to `rm -rf /`.
  if [[ -n "$CONTAINER_WORKSPACE" && "$CONTAINER_WORKSPACE" != "/" ]]; then
    log "Emptying workspace so the template stays a clean base..."
    incus exec "$CONTAINER_NAME" -- rm -rf "$CONTAINER_WORKSPACE"
  fi

  stash_tailscale_state

  log "Stopping container for snapshot..."
  incus stop "$CONTAINER_NAME"
  incus publish "$CONTAINER_NAME" --alias "$alias"
  log "Starting container back up..."
  incus start "$CONTAINER_NAME"
  wait_for_container "$CONTAINER_NAME" "$READY_TIMEOUT"

  restore_tailscale_state || error "Could not restore the Tailscale state in $CONTAINER_NAME from $TS_STATE_BACKUP"

  # Restore saved tokens to the running container
  if [[ -n "$saved_tokens" ]]; then
    incus exec "$CONTAINER_NAME" -- su - "$HOST_USER" -c "cat >> ~/.zshenv <<'TOKENS'
$saved_tokens
TOKENS"
  fi

  wait_for_network "$CONTAINER_NAME" "$READY_TIMEOUT"
  log "Saved template: $alias"
  echo "  Reuse with: bxn create --from $CONTAINER_NAME <new-name>"
}

# The repository `bxn create <project> <url>` clones. Only github.com, and
# always by its HTTPS address: that's the way out under an allowlist, and what
# the GitHub Auth plugin's token signs in to. The forms GitHub hands out are
# all taken: the page's address, the HTTPS clone URL and the SSH one.
set_repo_url() {
  local u="$1" path=""
  [[ -z "$REPO_URL" ]] || error "Two repositories given ($REPO_URL and another); a workspace holds one"
  case "$u" in
    https://github.com/*)     path="${u#https://github.com/}" ;;
    https://www.github.com/*) path="${u#https://www.github.com/}" ;;
    github.com/*)             path="${u#github.com/}" ;;
    git@github.com:*)         path="${u#git@github.com:}" ;;
    ssh://git@github.com/*)   path="${u#ssh://git@github.com/}" ;;
  esac
  path="${path%/}"
  path="${path%.git}"
  if [[ ! "$path" =~ ^[A-Za-z0-9][A-Za-z0-9-]*/[A-Za-z0-9._-]+$ || "$path" == */. || "$path" == */.. ]]; then
    # Not repeated back: a URL can carry a token (https://TOKEN@github.com/...,
    # ?token=...), and this goes to the terminal and to logs.
    error "Not a GitHub repository URL. Expected https://github.com/OWNER/REPO, with no credentials in it: the GitHub Auth plugin takes the token"
  fi
  REPO_URL="https://github.com/$path"
}

# Clone it into the workspace, as the user, once the plugins are in: GitHub
# Auth has set git's credential helper by then. A clone that fails (a typo, a
# token without access) leaves a finished container with an empty workspace
# and the command to try again, not a build thrown away at its last step.
clone_repo() {
  local url_q
  printf -v url_q '%q' "$REPO_URL"
  log "Cloning $REPO_URL into $CONTAINER_WORKSPACE..."
  # No terminal prompt: without a token git would ask for a username and wait.
  if incus exec "$CONTAINER_NAME" -- su - "$HOST_USER" -c \
       "cd $WORKSPACE_Q && GIT_TERMINAL_PROMPT=0 git clone $url_q ." </dev/null; then
    REPO_CLONED=1
  else
    warn "Could not clone $REPO_URL: $CONTAINER_NAME has an empty workspace. Once the cause is fixed: bxn $CONTAINER_NAME 'git clone $REPO_URL .'"
  fi
}

# Whether the workspace has a mise config to install from: the host directory
# that was copied in, or the clone inside the container.
workspace_has_mise_config() {
  if [[ -n "$REPO_URL" ]]; then
    [[ "$REPO_CLONED" == "1" ]] || return 1
    incus exec "$CONTAINER_NAME" -- su - "$HOST_USER" -c \
      "cd $WORKSPACE_Q && { test -f mise.toml || test -f .mise.toml || test -f .tool-versions; }" </dev/null
    return
  fi
  [[ "$SAVE_TEMPLATE" != "1" && "$NO_COPY" != "1" ]] || return 1
  [[ -f "$WORKSPACE_PATH/mise.toml" || -f "$WORKSPACE_PATH/.mise.toml" || -f "$WORKSPACE_PATH/.tool-versions" ]]
}

# ---------------------------------------------------------------------------
# Parse arguments
# ---------------------------------------------------------------------------
while [[ $# -gt 0 ]]; do
  case "$1" in
    -p|--path)       [[ $# -lt 2 ]] && error "$1 requires an argument"; WORKSPACE_PATH="$2"; PATH_GIVEN=1; shift 2 ;;
    -w|--workspace)  [[ $# -lt 2 ]] && error "$1 requires an argument"; CONTAINER_WORKSPACE="$2"; shift 2 ;;
    -f|--from)       [[ $# -lt 2 ]] && error "$1 requires an argument"; BASE_IMAGE="incus-init/$2"; shift 2 ;;
    -i|--image)      [[ $# -lt 2 ]] && error "$1 requires an argument"; BASE_IMAGE="$2"; shift 2 ;;
    -t|--template) SAVE_TEMPLATE=1; shift ;;
    --colima-cpus)   [[ $# -lt 2 ]] && error "$1 requires an argument"; COLIMA_CPUS="$2"; shift 2 ;;
    --colima-memory) [[ $# -lt 2 ]] && error "$1 requires an argument"; COLIMA_MEMORY="$2"; shift 2 ;;
    --colima-disk)   [[ $# -lt 2 ]] && error "$1 requires an argument"; COLIMA_DISK="$2"; shift 2 ;;
    --vm)            IS_VM=1; shift ;;
    --no-copy)       NO_COPY=1; shift ;;
    --vm-disk)       [[ $# -lt 2 ]] && error "$1 requires an argument"; VM_DISK="$2"; VM_OPT_SET=1; shift 2 ;;
    --memory|--vm-memory) [[ $# -lt 2 ]] && error "$1 requires an argument"; MEMORY="$2"; shift 2 ;;
    --vm-cpus)       [[ $# -lt 2 ]] && error "$1 requires an argument"; VM_CPUS="$2"; VM_OPT_SET=1; shift 2 ;;
    --ack-env)       ACK_ENV=1; shift ;;
    --agent)         [[ $# -lt 2 ]] && error "$1 requires an argument"; select_agent "$2"; shift 2 ;;
    --name)          [[ $# -lt 2 ]] && error "$1 requires an argument"; EXACT_NAME="$2"; shift 2 ;;
    --no-tui)        NO_TUI=1; shift ;;
    --insecure-network) INSECURE_NETWORK=1; shift ;;
    --egress)        [[ $# -lt 2 ]] && error "$1 requires an argument"; EGRESS_MODE="$2"; shift 2 ;;
    --egress-container) [[ $# -lt 2 ]] && error "$1 requires an argument"; EGRESS_GROUP="$2"; shift 2 ;;
    --plugins)       [[ $# -lt 2 ]] && error "$1 requires an argument"; shift 2 ;;  # read before discovery
    --plugins=*)     shift ;;
    --dry-run)       DRY_RUN=1; shift ;;
    -h|--help)       usage ;;
    -*)
      # Check if it's a plugin CLI flag
      if _flag_id=$(flag_to_id "$1"); then
        # An agent's flag (--claude) chooses the agent, so two are refused.
        _slot=$(_plugin_slot "$_flag_id")
        if [[ -n "${_P_AGENT_COMMAND[$_slot]}" ]]; then select_agent "$_flag_id"; else selected_set "$_flag_id" 1; fi
        shift
      else
        error "Unknown option: $1"
      fi
      ;;
    # A project's name has no slash or colon in it; a repository's URL does.
    */*|*:*)         set_repo_url "$1"; shift ;;
    *)               PROJECT="$1"; shift ;;
  esac
done

# A repository to clone is the workspace: nothing is copied from the host, and
# GitHub Auth is selected, as its flag would. The picker still lets it go, for
# a public repository.
if [[ -n "$REPO_URL" ]]; then
  [[ "$SAVE_TEMPLATE" != "1" ]] || error "A template's workspace is empty, so it can't take a repository ($REPO_URL)"
  [[ "$PATH_GIVEN" != "1" ]] || error "--path copies a host directory and $REPO_URL would be cloned; a workspace holds one"
  NO_COPY=1
  selected_set gh-auth 1 || warn "No GitHub Auth plugin to select; $REPO_URL clones only if it's public"
fi

# ---------------------------------------------------------------------------
# macOS pre-flight (noop on Linux)
# ---------------------------------------------------------------------------
source "$SCRIPT_DIR/boxen.macos.setup"
source "$SCRIPT_DIR/boxen.envscan"
# read_secret / read_value, for plugin prompts that take pasted values.
source "$SCRIPT_DIR/boxen.prompt"
# shellcheck source=boxen.profile
source "$SCRIPT_DIR/boxen.profile"
# shellcheck source=boxen.net
source "$SCRIPT_DIR/boxen.net"
# shellcheck source=boxen.egress
source "$SCRIPT_DIR/boxen.egress"
# shellcheck source=boxen.names
source "$SCRIPT_DIR/boxen.names"

# ---------------------------------------------------------------------------
# Validate
# ---------------------------------------------------------------------------
require_commands incus curl sudo realpath

[[ -n "$PROJECT" || -n "$EXACT_NAME" ]] || { warn "Project name required"; echo ""; usage 1; }
for _n in "$PROJECT" "$EXACT_NAME"; do
  [[ -z "$_n" || "$_n" =~ ^[a-zA-Z][a-zA-Z0-9-]*$ ]] ||
    error "Invalid name '$_n': it must start with a letter, with only letters, digits and hyphens"
done
unset _n

# A name given exactly (--name), or a template's (it becomes the image
# incus-init/NAME), is checked now; HANDLE-AGENT-PROJECT waits for the agent.
if [[ -n "$EXACT_NAME" ]]; then
  CONTAINER_NAME="$EXACT_NAME"
elif [[ "$SAVE_TEMPLATE" == "1" ]]; then
  CONTAINER_NAME="$PROJECT"
fi
if [[ -n "$CONTAINER_NAME" ]] && incus info "$CONTAINER_NAME" >/dev/null 2>&1; then
  error "Container '$CONTAINER_NAME' already exists"
fi
[[ "$CONTAINER_WORKSPACE" == /?* ]] || error "--workspace must be an absolute path other than / (got: $CONTAINER_WORKSPACE)"
# Remote shell snippets cd into the workspace; quote it once for all of them.
printf -v WORKSPACE_Q '%q' "$CONTAINER_WORKSPACE"

# The allowlist needs the isolated network. Off builds as before.
if [[ "$INSECURE_NETWORK" == "1" ]]; then
  [[ -z "$EGRESS_MODE" || "$EGRESS_MODE" == "off" ]] ||
    error "--egress $EGRESS_MODE needs the isolated network; drop --insecure-network"
  EGRESS_MODE=off
fi
EGRESS_MODE="${EGRESS_MODE:-enforce}"
case "$EGRESS_MODE" in
  enforce|report|off) ;;
  *) error "--egress must be enforce, report or off (got: $EGRESS_MODE)" ;;
esac
EGRESS_CONTAINER="$(egress_name "$EGRESS_GROUP")"
LOCKED_BUILD=0
[[ "$EGRESS_MODE" != "off" ]] && LOCKED_BUILD=1

# ---------------------------------------------------------------------------
# Detect if launching from a local base image (skip provisioning)
# ---------------------------------------------------------------------------
FROM_BASE_IMAGE=0
if [[ "$BASE_IMAGE" != images:* ]]; then
  FROM_BASE_IMAGE=1
  if ! incus image info "$BASE_IMAGE" &>/dev/null; then
    error "Template image '$BASE_IMAGE' not found. Run 'incus image list' to see available templates."
  fi
  # Local templates are single-type: a VM template can't launch as a container
  # and vice-versa. A VM template implies --vm; a container template given --vm
  # fails here with a clear message instead of a cryptic one mid-launch.
  _img_type="$(incus image info "$BASE_IMAGE" 2>/dev/null | awk -F': ' '/^Type:/{print $2; exit}')"
  if [[ "$IS_VM" == "1" && "$_img_type" == "container" ]]; then
    error "Template '$BASE_IMAGE' is a container image; drop --vm or rebuild it with --vm."
  elif [[ "$IS_VM" == "0" && "$_img_type" == "virtual-machine" ]]; then
    log "Template '$BASE_IMAGE' is a VM image; launching as a VM"
    IS_VM=1
  fi
  log "Using local template: $BASE_IMAGE"
fi

# VM flag validation. VM-only options are meaningless for containers: warn and
# ignore rather than error, so an errant flag never blocks a build.
if [[ "$IS_VM" == "1" ]]; then
  [[ "$VM_CPUS" =~ ^[1-9][0-9]*$ ]] || error "--vm-cpus must be a positive integer (got: $VM_CPUS)"
  READY_TIMEOUT=90
elif [[ "$VM_OPT_SET" == "1" ]]; then
  warn "VM options (--vm-disk/--vm-cpus) are ignored without --vm"
fi

HOST_USER="$(whoami)"
HOST_UID="$(id -u)"
HOST_GID="$(id -g)"

# ---------------------------------------------------------------------------
# Resolve the workspace path and warn about .env files: they are copied in with
# everything else. Template builds publish an empty workspace, so nothing is
# exposed and there is no host tree to resolve. --no-copy starts empty too, so
# its host directory is not scanned.
# ---------------------------------------------------------------------------
ENV_FILES_LIST=""
if [[ "$SAVE_TEMPLATE" != "1" ]]; then
  WORKSPACE_PATH="${WORKSPACE_PATH/#\~/$HOME}"
  WORKSPACE_PATH="$(realpath "$WORKSPACE_PATH")"
  [[ ! -d "$WORKSPACE_PATH" ]] && error "Directory not found: $WORKSPACE_PATH"

  if [[ "$NO_COPY" != "1" ]]; then
    [[ "$LOCKED_BUILD" == "1" ]] && warn_old_node
    ENV_FILES_LIST="$(detect_env_files "$WORKSPACE_PATH")"
    if [[ -n "$ENV_FILES_LIST" ]]; then
      echo ""
      while IFS= read -r _line; do
        echo -e "${YELLOW}${_line}${NC}" >&2
      done < <(printf '%s\n' "$ENV_FILES_LIST" | format_env_warning_lines "$WORKSPACE_PATH")
      confirm_env_acknowledgement "$ACK_ENV"
    fi
  fi
fi

# ---------------------------------------------------------------------------
# TUI plugin selector
# ---------------------------------------------------------------------------
if [[ -n "$SOURCE_PLUGINS_DIR" ]]; then
  log "Optional plugins from $PLUGINS_SOURCE_SHOWN${PLUGINS_SOURCE_COMMIT:+ at ${PLUGINS_SOURCE_COMMIT:0:12}} ($PLUGINS_SOURCE_FROM)"
fi
# The agent: from --agent or its flag, else picked now, after every other
# check; --no-tui takes the default agent if a plugin marks one, else a shell.
if [[ -z "$AGENT_SLOT" ]]; then
  if [[ "$NO_TUI" == "0" ]]; then show_agent_tui; else set_agent_slot "$AGENT_DEFAULT_SLOT"; fi
fi
AGENT_TOKEN="$(agent_token)"
[[ -n "$AGENT_TOKEN" ]] || error "$(agent_label "$AGENT_SLOT") has no usable command name for the container name"
if [[ -z "$CONTAINER_NAME" ]]; then
  if [[ "$DRY_RUN" == "1" ]]; then HANDLE="$(names_handle --no-save)"; else HANDLE="$(names_handle)"; fi
  CONTAINER_NAME="$(names_next "$HANDLE-$AGENT_TOKEN-$PROJECT")"
  [[ "$CONTAINER_NAME" =~ ^[a-zA-Z][a-zA-Z0-9-]*$ ]] ||
    error "Invalid container name '$CONTAINER_NAME': it must start with a letter, with only letters, digits and hyphens"
fi

if [[ "$NO_TUI" == "0" ]]; then
  show_tui
fi

# Resolve plugin requirements. A selected plugin may declare
# PLUGIN_REQUIRES="<id> <id>..."; those plugins are auto-selected here — after
# all user selection input (CLI flags + TUI) but before the prompt loop, so a
# required plugin's own prompt still fires. Resolution is single-level: a
# required plugin's own requirements are not chased.
for ((_i=0; _i<PLUGIN_COUNT; _i++)); do
  [[ "${_P_SELECTED[$_i]}" == "1" ]] || continue
  _reset_plugin_state
  source "${_P_FILE[$_i]}"
  for _req in $PLUGIN_REQUIRES; do
    [[ "$(selected_get "$_req")" == "1" ]] && continue
    # An agent can't come in as a requirement: it would be a second agent, or
    # one the container isn't named for.
    if _req_slot="$(_plugin_slot "$_req")" && [[ -n "${_P_AGENT_COMMAND[$_req_slot]}" ]]; then
      error "${_P_NAME[$_i]} needs the agent $(agent_label "$_req_slot"), but this container's is $(agent_label "$AGENT_SLOT"). One agent per container: choose it with --agent ${_P_AGENT_COMMAND[$_req_slot]}."
    fi
    if selected_set "$_req" 1; then
      log "Auto-selected '$_req' (required by ${_P_NAME[$_i]})"
    else
      warn "${_P_NAME[$_i]} requires unknown plugin '$_req' — ignored"
    fi
  done
done
unset _req _req_slot

# Echo the final selection before acting on it. In the TUI, space toggles and
# Enter launches — a mis-keyed toggle otherwise fails silently: the plugin's
# prompt and install just never happen, with nothing on screen to say why.
_sel_names=""
for ((_i=0; _i<PLUGIN_COUNT; _i++)); do
  [[ -n "${_P_AGENT_COMMAND[$_i]}" ]] && continue
  [[ "${_P_SELECTED[$_i]}" == "1" ]] && _sel_names+="${_sel_names:+, }${_P_NAME[$_i]}"
done
log "Agent: $(agent_label "$AGENT_SLOT")"
log "Plugins selected: ${_sel_names:-none}"
unset _i _sel_names
resolve_memory

# ---------------------------------------------------------------------------
# Component prompts — called once, after TUI decision
# ---------------------------------------------------------------------------
capture_git_identity
prompt_git_identity
_run_plugin_prompts

# ---------------------------------------------------------------------------
# Dry-run summary
# ---------------------------------------------------------------------------
if [[ "$DRY_RUN" == "1" ]]; then
  echo ""
  echo "========================================"
  echo "DRY RUN — nothing will be created"
  echo "========================================"
  echo "Container:   $CONTAINER_NAME"
  echo "Agent:       $(agent_label "$AGENT_SLOT")"
  echo "Image:       $BASE_IMAGE"
  echo "User:        $HOST_USER (UID:$HOST_UID GID:$HOST_GID)"
  if [[ "$SAVE_TEMPLATE" == "1" ]]; then
    echo "Git:         none (a template doesn't carry anyone's identity)"
  elif [[ -n "$GIT_NAME" ]]; then
    echo "Git:         $GIT_NAME <$GIT_EMAIL>, from $GIT_ID_SOURCE"
  else
    echo "Git:         none on this host; commits will fail until you set one"
  fi
  if [[ "$IS_VM" == "1" ]]; then
    echo "Type:        VM (disk=$VM_DISK memory=$VM_MEMORY cpus=$VM_CPUS)"
  else
    echo "Type:        container"
  fi
  echo "Memory:      $MEMORY_SHOWN ($MEMORY_WHY)"
  if [[ "$INSECURE_NETWORK" == "1" ]]; then
    echo "Network:     default bridge, not isolated (--insecure-network)"
  else
    echo "Network:     $BOXEN_NET, isolated from other instances and the host"
  fi
  if [[ "$LOCKED_BUILD" == "1" ]]; then
    echo "Egress:      $EGRESS_MODE (allowlist), proxy in $EGRESS_CONTAINER"
  else
    echo "Egress:      off (no allowlist)"
  fi
  if [[ -n "$SOURCE_PLUGINS_DIR" ]]; then
    echo "Plugins:     $PLUGINS_SOURCE_SHOWN${PLUGINS_SOURCE_COMMIT:+ at ${PLUGINS_SOURCE_COMMIT:0:12}} (from $PLUGINS_SOURCE_FROM), plus the agents"
  else
    echo "Plugins:     built in"
  fi
  if [[ "$SAVE_TEMPLATE" == "1" ]]; then
    echo "Workspace:   empty (template base)"
  elif [[ -n "$REPO_URL" ]]; then
    echo "Workspace:   clone $REPO_URL into $CONTAINER_WORKSPACE"
  elif [[ "$NO_COPY" == "1" ]]; then
    echo "Workspace:   empty $CONTAINER_WORKSPACE (--no-copy)"
  else
    echo "Workspace:   copy $WORKSPACE_PATH into $CONTAINER_WORKSPACE (incl .git)"
  fi
  if [[ -n "$ENV_FILES_LIST" ]]; then
    _env_count="$(printf '%s\n' "$ENV_FILES_LIST" | wc -l | tr -d ' ')"
    echo ".env files exposed: $_env_count"
    _shown=0
    while IFS= read -r _envpath; do
      if (( _shown >= 20 )); then
        echo "  …and $(( _env_count - 20 )) more"
        break
      fi
      echo "  ${_envpath#$WORKSPACE_PATH/}"
      _shown=$(( _shown + 1 ))
    done <<< "$ENV_FILES_LIST"
  fi
  echo ""
  echo "Selected plugins:"
  for ((_i=0; _i<PLUGIN_COUNT; _i++)); do
    [[ -n "${_P_AGENT_COMMAND[$_i]}" ]] && continue
    IFS=: read -r id name desc default <<< "${PLUGINS[$_i]}"
    if [[ "$(selected_get "$id")" == "1" ]]; then
      echo "  [x] $name"
    else
      echo "  [ ] $name"
    fi
  done
  echo ""
  echo "Template:    $( [[ "$SAVE_TEMPLATE" == "1" ]] && echo "incus-init/$CONTAINER_NAME" || echo no )"
  echo "========================================"
  exit 0
fi

# ---------------------------------------------------------------------------
# From here on, real work — set up cleanup trap
# ---------------------------------------------------------------------------
trap cleanup_on_exit EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

ensure_profile

# The isolated bridge, and this instance's address on it (boxen.net).
NET_ARGS=()
if [[ "$INSECURE_NETWORK" == "1" ]]; then
  warn "--insecure-network: $CONTAINER_NAME goes on the default bridge, where instances can reach each other and the host"
else
  net_preflight
  boxen_lock
  ensure_net
  NET_IP="$(net_next_address)"
  boxen_unlock
  NET_ARGS=(-p "$BOXEN_NET_PROFILE" -d "eth0,ipv4.address=$NET_IP")
fi

# ---------------------------------------------------------------------------
# Create container
# ---------------------------------------------------------------------------
# The tags go on at creation, so an instance whose first start fails is
# still one bxn knows: status, rm, update-all and short names find it.
# boxen.shell starts sessions in user.boxen.workspace; commands find a
# container from its project by the handle and project (boxen.names).
TAG_ARGS=(-c user.managed-by=boxen -c user.boxen=1 -c "user.boxen.agent=$AGENT_TOKEN"
  -c "user.boxen.workspace=$CONTAINER_WORKSPACE")
if [[ -n "$HANDLE" ]]; then
  TAG_ARGS+=(-c "user.boxen.handle=$HANDLE" -c "user.boxen.project=$PROJECT")
fi
if [[ "$INSECURE_NETWORK" == "1" ]]; then
  TAG_ARGS+=(-c user.boxen.net=open)
else
  TAG_ARGS+=(-c user.boxen.net=isolated)
fi
if [[ -n "$SOURCE_PLUGINS_DIR" ]]; then
  TAG_ARGS+=(-c "user.boxen.plugins.source=$PLUGINS_SOURCE_SHOWN")
  [[ -z "$PLUGINS_SOURCE_COMMIT" ]] || TAG_ARGS+=(-c "user.boxen.plugins.commit=$PLUGINS_SOURCE_COMMIT")
fi

create_instance() {
  if [[ "$IS_VM" == "1" ]]; then
    # Naming any profile replaces the implicit default, so name it too.
    incus init "$BASE_IMAGE" "$CONTAINER_NAME" --vm \
      ${NET_ARGS[@]+-p default "${NET_ARGS[@]}"} "${TAG_ARGS[@]}" \
      -c limits.memory="$VM_MEMORY" \
      -c limits.cpu="$VM_CPUS" \
      -d root,size="$VM_DISK"
  else
    # Its own limit only when something asked for one; else the profile's.
    local mem=()
    [[ -z "$MEMORY_LIMIT" ]] || mem=(-c "limits.memory=$MEMORY_LIMIT")
    incus init "$BASE_IMAGE" "$CONTAINER_NAME" -p default -p "$AGENT_PROFILE" \
      ${NET_ARGS[@]+"${NET_ARGS[@]}"} "${TAG_ARGS[@]}" ${mem[@]+"${mem[@]}"}
  fi
}
log "Creating container: $CONTAINER_NAME ($(basename "$BASE_IMAGE"))"
# Created, then started, so a failure to create is told apart from a failure
# to start. Another bxn may take a generated name after names_next chose it:
# that container is theirs, so take the next number instead.
_create_tries=0
until create_instance; do
  if [[ -n "$HANDLE" ]] && (( ++_create_tries < 5 )) && incus info "$CONTAINER_NAME" >/dev/null 2>&1; then
    CONTAINER_NAME="$(names_next "$HANDLE-$AGENT_TOKEN-$PROJECT")"
    log "That name was just taken; creating $CONTAINER_NAME instead"
    continue
  fi
  error "Could not create $CONTAINER_NAME"
done
unset _create_tries
CREATED_INSTANCE=1
# Under an allowlist it stays stopped, so bxn decides when it first runs.
[[ "$LOCKED_BUILD" == "1" ]] || incus start "$CONTAINER_NAME"

if [[ "$LOCKED_BUILD" == "1" ]]; then
  # Kept from starting on its own until the build finishes; the original
  # autostart (never set) comes back when the lock commits. The builder's PID
  # and boot tell a healthy build from an abandoned one.
  incus config set "$CONTAINER_NAME" boot.autostart=false user.boxen.egress.autostart-saved=unset \
    "user.boxen.egress=$EGRESS_MODE" "user.boxen.egress.builder=$$@$(egress_boot_id)" \
    "user.boxen.egress.build=$([[ "$FROM_BASE_IMAGE" == "1" ]] && echo locked || echo open)"
  # read -a splits on spaces without pathname expansion, so a wildcard such
  # as *.tailscale.com can't match files in the current directory.
  read -r -a _plugin_hosts <<< "$(_selected_plugin_hosts | tr '\n' ' ')"
  egress_record_plugin_hosts "$CONTAINER_NAME" ${_plugin_hosts[@]+"${_plugin_hosts[@]}"}
  if [[ "$FROM_BASE_IMAGE" == "1" ]]; then
    # A template may hold logins, credential files or startup services, so it
    # never runs open: locked card and a verified proxy before its first start.
    log "Locking $CONTAINER_NAME's network ($EGRESS_MODE) before its first start..."
    boxen_lock
    egress_prepare_unstarted "$CONTAINER_NAME" "$EGRESS_CONTAINER" "$EGRESS_MODE"
    boxen_unlock
    NET_VIA_PROXY=1
  fi
  incus start "$CONTAINER_NAME"
  wait_for_container "$CONTAINER_NAME" "$READY_TIMEOUT"
  [[ "$FROM_BASE_IMAGE" == "1" ]] && egress_write_proxy_env "$CONTAINER_NAME"
elif [[ "$FROM_BASE_IMAGE" == "1" ]]; then
  # A template built under an allowlist carries proxy settings for a proxy
  # this container doesn't have, in the environment and in tools' own files.
  wait_for_container "$CONTAINER_NAME" "$READY_TIMEOUT"
  egress_clear_proxy_env "$CONTAINER_NAME"
  _run_plugin_proxy_hooks ""
fi

wait_for_container "$CONTAINER_NAME" "$READY_TIMEOUT"
wait_for_network "$CONTAINER_NAME" "$READY_TIMEOUT"

# ---------------------------------------------------------------------------
# Provision (skipped when launching from a local base image)
# ---------------------------------------------------------------------------
if [[ "$FROM_BASE_IMAGE" == "0" ]]; then

  # --- Install packages ---
  log "Installing packages..."
  incus exec "$CONTAINER_NAME" -- sh -es <<PACKAGES
    export DEBIAN_FRONTEND=noninteractive
    apt-get update -y
    apt-get install -y $APT_CORE $APT_BUILD $APT_DEVLIBS $APT_RUNTIME
    apt-get clean && rm -rf /var/lib/apt/lists/*

    # Extra repos (mise + GitHub CLI)
    install -dm 755 /etc/apt/keyrings
    curl -fsSL https://mise.jdx.dev/gpg-key.pub | gpg --dearmor -o /etc/apt/keyrings/mise-archive-keyring.gpg
    echo "deb [signed-by=/etc/apt/keyrings/mise-archive-keyring.gpg] https://mise.jdx.dev/deb stable main" | tee /etc/apt/sources.list.d/mise.list
    curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
      | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg 2>/dev/null
    chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg
    echo "deb [arch=\$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
      > /etc/apt/sources.list.d/github-cli.list
    apt-get update -y
    apt-get install -y mise gh
PACKAGES

fi  # end FROM_BASE_IMAGE == 0

# ---------------------------------------------------------------------------
# Create user (always — base image may have been built by a different user)
# ---------------------------------------------------------------------------
log "Creating user $HOST_USER..."
BUILD_SUDO_GRANTED=1
incus exec "$CONTAINER_NAME" -- sh -c "
  # Skip creation if user already exists with correct UID
  if ! (id $HOST_USER >/dev/null 2>&1 && [ \"\$(id -u $HOST_USER)\" = \"$HOST_UID\" ]); then
    ZSH_PATH=\$(command -v zsh || echo /bin/bash)

    # Remove conflicting UID/GID owners
    EXISTING_USER=\$(getent passwd $HOST_UID | cut -d: -f1 || true)
    EXISTING_GROUP=\$(getent group $HOST_GID | cut -d: -f1 || true)

    if [ -n \"\$EXISTING_USER\" ] && [ \"\$EXISTING_USER\" != \"$HOST_USER\" ]; then
      userdel -r \"\$EXISTING_USER\" 2>/dev/null || userdel \"\$EXISTING_USER\" 2>/dev/null || true
    fi
    if [ -n \"\$EXISTING_GROUP\" ] && [ \"\$EXISTING_GROUP\" != \"$HOST_USER\" ]; then
      groupdel \"\$EXISTING_GROUP\" 2>/dev/null || true
    fi

    groupadd -g $HOST_GID $HOST_USER 2>/dev/null || true
    useradd -m -u $HOST_UID -g $HOST_GID -s \"\$ZSH_PATH\" $HOST_USER || exit 1
  fi

  id $HOST_USER >/dev/null 2>&1 || { echo 'User creation failed' >&2; exit 1; }

  # Group-gated sudo: the user is not a member of _sudo. boxen.shell adds the
  # group to a single session when asked (--with-sudo).
  groupadd -f _sudo
  echo '%_sudo ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/_sudo
  chmod 0440 /etc/sudoers.d/_sudo

  # Grant user-level sudo for the build (plugins need it). Removed after
  # plugin installs, and by the exit trap if the build stops early.
  echo '$HOST_USER ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/$HOST_USER
  chmod 0440 /etc/sudoers.d/$HOST_USER
"

# ---------------------------------------------------------------------------
# Disable mise's gix-based git cloner. gix trips on some asdf plugin repos
# (notably asdf-php) with "Failed to update references to their new position
# to match their remote locations" and fails any mise install run by the
# user later. System git handles the same clones fine.
# ---------------------------------------------------------------------------
write_git_identity

log "Configuring mise to use system git (gix=false)..."
incus exec "$CONTAINER_NAME" -- su - "$HOST_USER" -c 'bash -s' <<'MISECFG'
  set -e
  mkdir -p "$HOME/.config/mise"
  cfg="$HOME/.config/mise/config.toml"
  if [[ ! -f "$cfg" ]] || ! grep -q '^\[settings\]' "$cfg"; then
    printf '[settings]\ngix = false\n' >> "$cfg"
  elif ! grep -qE '^gix *= *false' "$cfg"; then
    # [settings] exists but no gix=false line — append under the section
    awk '
      /^\[settings\]/ { print; print "gix = false"; next }
      { print }
    ' "$cfg" > "$cfg.new" && mv "$cfg.new" "$cfg"
  fi
MISECFG

# GitHub's stacked PRs (gh stack), for every user: an extension lives in the
# user's home, so a template built by someone else doesn't carry it. It needs
# no login. Missing it shouldn't fail a build: the next one adds it.
log "Installing gh stack (GitHub stacked PRs)..."
incus exec "$CONTAINER_NAME" -- su - "$HOST_USER" -c 'bash -s' <<'GHSTACK' ||
  set -e
  if gh extension list 2>/dev/null | grep -q 'github/gh-stack'; then exit 0; fi
  gh extension install github/gh-stack >/dev/null
GHSTACK
  warn "Could not install gh stack. Install it later: bxn -s $CONTAINER_NAME gh extension install github/gh-stack"

# ---------------------------------------------------------------------------
# Copy the workspace in. A fresh build under an allowlist copies it after the
# lock instead, below.
# ---------------------------------------------------------------------------
[[ "$LOCKED_BUILD" == "1" && "$FROM_BASE_IMAGE" == "0" ]] || copy_workspace

# Final readiness check
wait_for_container "$CONTAINER_NAME" "$READY_TIMEOUT"
incus exec "$CONTAINER_NAME" -- id "$HOST_USER" >/dev/null 2>&1 \
  || error "User $HOST_USER does not exist. User creation may have failed."

wait_for_network "$CONTAINER_NAME" "$READY_TIMEOUT"

# ---------------------------------------------------------------------------
# Shell setup (skipped when launching from a local base image)
# ---------------------------------------------------------------------------
if [[ "$FROM_BASE_IMAGE" == "0" ]]; then

  log "Configuring zsh..."
  incus exec "$CONTAINER_NAME" -- su - "$HOST_USER" -c "bash -s -- $WORKSPACE_Q" <<'ZSHEOF'
    set -e

    # Auto-cd to the workspace on login, unless the session already chose a
    # directory (boxen.shell passes --cwd).
    touch ~/.zshrc
    printf 'if [[ $PWD == "$HOME" && -d %q ]]; then\n    cd %q\nfi\n' "$1" "$1" >> ~/.zprofile
ZSHEOF

  # Install Oh My Zsh — must run before appending to .zshrc since
  # the installer replaces .zshrc with its own template
  install_ohmyzsh

  # Append mise activation and PATH after Oh My Zsh has written its .zshrc
  incus exec "$CONTAINER_NAME" -- su - "$HOST_USER" -c 'bash -s' <<'ZSHEOF'
    set -e
    echo 'eval "$(mise activate zsh)"' >> ~/.zshrc
    echo 'export PATH="$HOME/.local/bin:$PATH"' >> ~/.zshrc
ZSHEOF

fi  # end FROM_BASE_IMAGE == 0

# ---------------------------------------------------------------------------
# Install selected plugins. A fresh build under an allowlist installs the
# ones that take no credentials, locks, then copies the workspace and
# installs the rest. A repository is cloned last of all: GitHub Auth is one
# of the rest.
# ---------------------------------------------------------------------------
if [[ "$LOCKED_BUILD" == "1" && "$FROM_BASE_IMAGE" == "0" ]]; then
  _run_plugin_installs 0 open
  lock_build
  copy_workspace
  _run_plugin_installs 0 locked
else
  _run_plugin_installs "$FROM_BASE_IMAGE"
fi
[[ -z "$REPO_URL" ]] || clone_repo

# Revoke build-time sudo now that plugins are done
log "Revoking build-time sudo..."
revoke_build_sudo || error "Could not revoke build-time sudo"

# Run mise install if the workspace has a config. Skipped for template builds
# and --no-copy: the workspace starts empty, so the host's mise config never
# reached it. A cloned repository's own config counts.
if workspace_has_mise_config; then
  log "Trusting workspace mise config..."
  incus exec "$CONTAINER_NAME" -- su - "$HOST_USER" -c "cd $WORKSPACE_Q && mise trust"

  # Pre-clone asdf plugins with system git before `mise install`.
  # mise's built-in gix cloner trips on some plugin repos (e.g. asdf-php)
  # with "Failed to update references to their new position to match their
  # remote locations". `mise settings set gix false` does not reliably disable
  # gix in current mise releases, so we sidestep the clone entirely: if the
  # plugin dir already exists, mise skips its own clone.
  log "Pre-cloning mise plugins via system git (gix workaround)..."
  incus exec "$CONTAINER_NAME" -- su - "$HOST_USER" -c "bash -s -- $WORKSPACE_Q" <<'PRECLONE'
    set -e
    tools=$(python3 - "$1" <<'PY'
import os, re, sys
ws = sys.argv[1]
tools = set()
for f in ("mise.toml", ".mise.toml"):
    p = os.path.join(ws, f)
    if not os.path.exists(p):
        continue
    in_tools = False
    with open(p) as fh:
        for line in fh:
            s = line.strip()
            m = re.match(r'^\[([A-Za-z0-9_.-]+)\]', s)
            if m:
                sect = m.group(1)
                in_tools = (sect == "tools")
                if sect.startswith("tools."):
                    tools.add(sect[6:])
                continue
            if not in_tools or not s or s.startswith("#"):
                continue
            km = re.match(r'^"?([A-Za-z0-9_-]+)"?\s*=', s)
            if km:
                tools.add(km.group(1))
p = os.path.join(ws, ".tool-versions")
if os.path.exists(p):
    with open(p) as fh:
        for line in fh:
            s = line.strip()
            if s and not s.startswith("#"):
                tools.add(s.split()[0])
for t in sorted(tools):
    print(t)
PY
)
    # Tools mise ships as core/builtin plugins — no asdf clone needed.
    core="bun deno elixir erlang go golang java node nodejs python python3 ruby rust zig"
    plugins_dir="$HOME/.local/share/mise/plugins"
    mkdir -p "$plugins_dir"
    for tool in $tools; do
      case " $core " in *" $tool "*) continue ;; esac
      [[ -d "$plugins_dir/$tool" ]] && continue
      url="https://github.com/mise-plugins/asdf-$tool.git"
      if git clone --quiet --depth 1 "$url" "$plugins_dir/$tool" 2>/dev/null; then
        echo "  pre-cloned: $tool"
      else
        rm -rf "$plugins_dir/$tool"
        echo "  no asdf-$tool plugin on mise-plugins; letting mise resolve"
      fi
    done
PRECLONE

  log "Running mise install for workspace..."
  # Non-fatal: a broken tool version in the workspace config shouldn't nuke an
  # otherwise-complete instance (plugins and env are already applied by now).
  incus exec "$CONTAINER_NAME" -- su - "$HOST_USER" -c "cd $WORKSPACE_Q && mise install" || \
    warn "mise install failed — fix tool versions and rerun 'mise install' inside the instance"
fi

# Expose mise shims to coding agents and other non-interactive shells
# by symlinking them into ~/.local/bin, which is on the default PATH.
# mise activation in .zshrc only covers interactive zsh; without this,
# `incus exec ... bash -c '...'` falls through to system binaries.
[[ "$LOCKED_BUILD" == "1" ]] && finish_locked_build

log "Syncing mise shims into ~/.local/bin..."
incus exec "$CONTAINER_NAME" -- su - "$HOST_USER" -c '
  shims="$HOME/.local/share/mise/shims"
  if [[ -d "$shims" ]]; then
    mkdir -p "$HOME/.local/bin"
    for shim in "$shims"/*; do
      [[ -e "$shim" ]] || continue
      ln -sf "$shim" "$HOME/.local/bin/$(basename "$shim")"
    done
  fi
'


# ---------------------------------------------------------------------------
# Disable cleanup trap on success. A template build swaps in a narrower guard
# until it is published: save_template moves the Tailscale state out.
# ---------------------------------------------------------------------------
if [[ "$SAVE_TEMPLATE" == "1" ]]; then
  trap template_cleanup_on_exit EXIT
else
  trap - EXIT INT TERM HUP
fi

# ---------------------------------------------------------------------------
# Done
# ---------------------------------------------------------------------------
if [[ ${#FAILED_PLUGIN_NAMES[@]} -gt 0 ]]; then
  warn "Some plugins FAILED: ${FAILED_PLUGIN_NAMES[*]}"
else
  log "Container ready!"
fi
echo ""
echo "========================================"
echo "Container:   $CONTAINER_NAME"
echo "Image:       $BASE_IMAGE"
echo "User:        $HOST_USER (UID:$HOST_UID GID:$HOST_GID)"
if [[ "$IS_VM" == "1" ]]; then
  echo "Type:        VM (disk=$VM_DISK memory=$VM_MEMORY cpus=$VM_CPUS)"
else
  echo "Type:        container"
fi
echo "Memory:      $MEMORY_SHOWN ($MEMORY_WHY)"
if [[ "$SAVE_TEMPLATE" == "1" ]]; then
  echo "Workspace:   empty (template base)"
elif [[ "$REPO_CLONED" == "1" ]]; then
  echo "Workspace:   clone of $REPO_URL in $CONTAINER_WORKSPACE"
elif [[ -n "$REPO_URL" ]]; then
  echo "Workspace:   empty $CONTAINER_WORKSPACE ($REPO_URL didn't clone)"
elif [[ "$NO_COPY" == "1" ]]; then
  echo "Workspace:   empty $CONTAINER_WORKSPACE (--no-copy)"
else
  echo "Workspace:   copy of $WORKSPACE_PATH in $CONTAINER_WORKSPACE (incl .git)"
fi
# Env var names (never values) that made it into the instance config — answers
# "did the token take?" at a glance after a long build.
_env_keys="$(incus config show "$CONTAINER_NAME" 2>/dev/null \
  | awk '/^  environment\./{k=$1; sub(/^environment\./,"",k); sub(/:$/,"",k); print k}' \
  | tr '\n' ' ')"
echo "Env vars:    ${_env_keys:-none}"
unset _env_keys
echo ""
echo "Installed:"
for entry in "${PLUGINS[@]}"; do
  IFS=: read -r id name desc default <<< "$entry"
  if [[ "$(selected_get "$id")" == "1" ]]; then
    if _plugin_failed "$id"; then
      echo "  ✗ $name (FAILED — see warnings above)"
    else
      echo "  ✓ $name"
    fi
  fi
done
echo "========================================"
echo ""
echo "Shell in:"
echo "  bxn $CONTAINER_NAME"
# The project alone, when that opens this container (boxen.names): not when
# another agent's container shares the project, or the name wasn't generated.
if [[ -n "$HANDLE" ]] && _short="$(names_short "$CONTAINER_NAME" "$HANDLE" "$AGENT_TOKEN" "$PROJECT")"; then
  echo "  bxn $_short    (short for it)"
fi
unset _short
echo ""
print_agent_launches
print_plugin_logins

# ---------------------------------------------------------------------------
# Publish as local image (optional)
# ---------------------------------------------------------------------------
if [[ "$SAVE_TEMPLATE" == "1" ]]; then
  save_template
  trap - EXIT INT TERM HUP
fi
