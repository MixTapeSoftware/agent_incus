#!/usr/bin/env bash
set -uo pipefail

# bxn.doctor
# `bxn doctor`: checks the host for what would stop bxn creating or starting
# containers, and for state left behind by commands that didn't finish. It
# only reads; each problem comes with the command that fixes it, when one does.
# Checks that need root are a later step; this one runs as the user.

_boxen_resolve() {
  if command -v realpath >/dev/null 2>&1; then realpath "$1"; return; fi
  local p="$1" link
  while [[ -L "$p" ]]; do
    link="$(readlink "$p")"
    case "$link" in /*) p="$link" ;; *) p="$(dirname "$p")/$link" ;; esac
  done
  echo "$p"
}
SCRIPT_DIR="$(cd "$(dirname "$(_boxen_resolve "${BASH_SOURCE[0]}")")" && pwd)"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
DIM='\033[2m'
NC='\033[0m'
if [[ ! -t 1 || -n "${NO_COLOR:-}" ]]; then RED="" GREEN="" YELLOW="" DIM="" NC=""; fi
log()  { echo -e "${GREEN}[+]${NC} $1" >&2; }
warn() { echo -e "${YELLOW}[!]${NC} $1" >&2; }
error(){ echo -e "${RED}[ERROR]${NC} $1" >&2; exit 1; }

# shellcheck source=boxen.net
source "$SCRIPT_DIR/boxen.net"
# shellcheck source=boxen.egress
source "$SCRIPT_DIR/boxen.egress"

# Where the host's network state is read. Tests point these at fixtures.
DOCTOR_SYS_NET="${BOXEN_DOCTOR_SYS_NET:-/sys/class/net}"
DOCTOR_PROC_SYS="${BOXEN_DOCTOR_PROC_SYS:-/proc/sys}"

usage() {
  cat <<'EOF'
Usage: bxn doctor

Checks what would stop bxn creating or starting containers: Incus and its
firewall support, the boxenbr0 bridge, the lock bxn commands share, the
egress containers and their proxies, and containers left half made. It
changes nothing. Exits 1 when something is broken.
EOF
  exit "${1:-0}"
}

FAILS=0
WARNS=0
ok()      { printf "  ${GREEN}ok${NC}    %s\n" "$1"; }
skipped() { printf "  ${DIM}skip${NC}  %s\n" "$1"; }
# Usage: bad <what's wrong> [<fix>]   — something that breaks a create or start
bad() {
  FAILS=$((FAILS + 1))
  printf "  ${RED}FAIL${NC}  %s\n" "$1"
  [[ -z "${2:-}" ]] || printf "        fix: %s\n" "$2"
}
# Usage: note <what's off> [<fix>]    — worth fixing, but nothing fails yet
note() {
  WARNS=$((WARNS + 1))
  printf "  ${YELLOW}warn${NC}  %s\n" "$1"
  [[ -z "${2:-}" ]] || printf "        fix: %s\n" "$2"
}
section() { printf '\n%s\n' "$1"; }

# --- Incus -------------------------------------------------------------------

# Returns 1 when Incus can't be reached, since nothing after that can be read.
check_incus() {
  local info ver fw
  section "Incus"
  if ! command -v incus >/dev/null 2>&1; then
    bad "incus isn't installed" "see Prerequisites in the README"
    return 1
  fi
  if ! info="$(incus query /1.0 2>&1)"; then
    bad "Can't reach the Incus server: $(head -n 1 <<< "$info")" \
      "start it (sudo systemctl start incus), or join its group (sudo usermod -aG incus-admin $(id -un), then log in again)"
    return 1
  fi
  ok "The Incus server answers"
  ver="$(incus version 2>/dev/null | awk -F': *' '/^Server version/ {print $2}')"
  if [[ -n "$ver" ]] && net_version_ge "$ver" "$BOXEN_NET_MIN_INCUS"; then
    ok "Incus $ver (bxn needs $BOXEN_NET_MIN_INCUS or later)"
  else
    bad "Incus ${ver:-(unknown version)} is older than $BOXEN_NET_MIN_INCUS, so bxn can't isolate new containers" \
      "upgrade Incus, or create with --insecure-network"
  fi
  fw="$(grep -o '"firewall": *"[^"]*"' <<< "$info" | head -1 | sed 's/.*"\([^"]*\)"$/\1/')" || fw=""
  if [[ "$fw" == nftables ]]; then
    ok "Incus's firewall driver is nftables"
  else
    bad "Incus's firewall driver is ${fw:-unknown}, not nftables, so bxn can't isolate new containers" \
      "install nftables and restart Incus, or create with --insecure-network"
  fi
  if grep -q '"network_bridge_acl_devices"' <<< "$info"; then
    ok "Incus supports per-container network rules"
  else
    bad "Incus lacks the network_bridge_acl_devices API extension" "upgrade Incus, or create with --insecure-network"
  fi
  return 0
}

# --- The lock ----------------------------------------------------------------

check_lock() {
  local pid args age
  section "Lock"
  if [[ ! -d "$BOXEN_LOCK_DIR" ]]; then
    ok "No bxn command holds the lock"
    return 0
  fi
  pid="$(cat "$BOXEN_LOCK_DIR/pid" 2>/dev/null)" || pid=""
  if [[ -z "$pid" ]]; then
    # boxen_lock takes over only a lock whose owner it can see has exited.
    bad "The lock at $BOXEN_LOCK_DIR names no owner, so bxn commands wait 15 minutes for it, then fail" \
      "when no bxn command is running: rm -rf $BOXEN_LOCK_DIR"
    return 0
  fi
  if ! kill -0 "$pid" 2>/dev/null; then
    ok "The lock was left by a bxn command that exited (pid $pid); the next one takes it over"
    return 0
  fi
  args="$(ps -o args= -p "$pid" 2>/dev/null)" || args=""
  age="$(ps -o etime= -p "$pid" 2>/dev/null | tr -d ' ')" || age=""
  if [[ "$args" == *bxn* || "$args" == *boxen* ]]; then
    note "A bxn command holds the lock (pid $pid, running ${age:-?}): $args; other bxn commands wait for it" \
      "let it finish, or stop it: kill $pid"
  else
    # The pid was reused, often after a reboot: bxn can't tell it's stale.
    bad "The lock names pid $pid, which is now ${args:-another process}, not bxn; bxn commands wait 15 minutes for it, then fail" \
      "rm -rf $BOXEN_LOCK_DIR"
  fi
}

# --- Instances, read once ----------------------------------------------------

# One row per instance, tab separated: name, status, eth0 address, managed-by,
# egress container, egress transition, egress port, build abandoned (yes/no).
INSTANCES=()
# Returns 1 when Incus won't list its instances, after saying so: an empty
# list would otherwise pass every check that reads it.
read_instances() {
  local name st ip mgd eg tr port ab list
  INSTANCES=()
  if ! list="$(incus list --format csv --columns ns 2>/dev/null)"; then
    section "Instances"
    bad "Incus wouldn't list its instances, so none of them was checked" "incus list"
    return 1
  fi
  while IFS=, read -r name st; do
    [[ -n "$name" ]] || continue
    ip="$(incus config device get "$name" eth0 ipv4.address 2>/dev/null)" || ip=""
    mgd="$(incus config get "$name" user.managed-by 2>/dev/null)" || mgd=""
    eg="$(incus config get "$name" user.boxen.egress.container 2>/dev/null)" || eg=""
    tr="$(egress_transition "$name")"
    port="$(incus config get "$name" user.boxen.egress.port 2>/dev/null)" || port=""
    ab=no
    egress_build_abandoned "$name" && ab=yes
    INSTANCES+=("$name"$'\t'"$st"$'\t'"${ip:--}"$'\t'"${mgd:--}"$'\t'"${eg:--}"$'\t'"${tr:--}"$'\t'"${port:--}"$'\t'"$ab")
  done <<< "$list"
}

# Usage: inst_field <row> <n>   (1-based, as cut counts)
inst_field() { cut -f"$2" <<< "$1"; }

# --- The bridge --------------------------------------------------------------

# Whether the Incus server runs here, so the host's own interfaces and
# processes are the ones it uses.
server_is_local() {
  [[ "$(uname -s)" == Linux ]] || return 1
  [[ "$(incus remote get-default 2>/dev/null)" == local ]]
}

# Usage: in_subnet <ip> <cidr>
in_subnet() { [[ "$1" =~ ^[0-9]+(\.[0-9]+){3}$ ]] && net_overlaps "$1/32" "$2"; }

check_bridge() {
  local subnet net line c dev clash="" others row ip dups
  section "Network ($BOXEN_NET)"
  if ! incus network show "$BOXEN_NET" &>/dev/null; then
    ok "$BOXEN_NET doesn't exist yet; the first bxn create makes it"
    return 0
  fi
  subnet="$(incus network get "$BOXEN_NET" ipv4.address 2>/dev/null)"
  if ! [[ "$subnet" =~ ^[0-9]+(\.[0-9]+){3}/16$ ]]; then
    bad "$BOXEN_NET has ipv4.address=${subnet:-(none)}, but bxn needs a /16" \
      "incus network set $BOXEN_NET ipv4.address=<a free 10.x.0.1/16>"
    return 0
  fi
  net="$(net_int2ip $(( $(net_ip2int "${subnet%/*}") & 0xFFFF0000 )))/16"
  ok "$BOXEN_NET is $subnet"

  # A route added after the bridge (a VPN, often) can take its replies.
  # Only this machine's routes, so only when the server runs here.
  if server_is_local && command -v ip >/dev/null 2>&1; then
    while IFS= read -r line; do
      c="${line%% *}"
      [[ "$c" == default ]] && continue
      [[ "$c" == */* ]] || c="$c/32"
      [[ "$c" =~ ^[0-9]+(\.[0-9]+){3}/[0-9]+$ ]] || continue
      dev="$(sed -n 's/.* dev \([^ ]*\).*/\1/p' <<< "$line")"
      [[ "$dev" == "$BOXEN_NET" ]] && continue
      net_overlaps "$c" "$net" && clash+="${clash:+; }$c on ${dev:-?}"
    done <<< "$(ip -4 route 2>/dev/null)"
  fi
  others="$(incus network list --format csv 2>/dev/null | awk -F, -v me="$BOXEN_NET" '$1 != me && $4 ~ /\// {print $1 "," $4}')" || others=""
  while IFS=, read -r dev c; do
    [[ -n "$c" ]] && net_overlaps "$c" "$net" && clash+="${clash:+; }$c on Incus network $dev"
  done <<< "$others"
  if [[ -n "$clash" ]]; then
    bad "$BOXEN_NET's $net overlaps $clash, so containers' traffic can go the wrong way" \
      "disconnect what overlaps (a VPN?), or move $BOXEN_NET to a free /16 once no container uses it"
  else
    ok "No other route or network overlaps $net"
  fi

  if server_is_local; then
    if [[ -e "$DOCTOR_SYS_NET/$BOXEN_NET" ]]; then
      ok "The host has the $BOXEN_NET interface"
    else
      bad "Incus has $BOXEN_NET, but the host has no such interface, so containers on it get no network" \
        "sudo systemctl restart incus"
    fi
    if [[ "$(cat "$DOCTOR_PROC_SYS/net/ipv4/ip_forward" 2>/dev/null)" == 1 ]]; then
      ok "IPv4 forwarding is on"
    else
      bad "IPv4 forwarding is off, so containers can't reach the internet" \
        "sudo sysctl -w net.ipv4.ip_forward=1 (restarting Incus also turns it on)"
    fi
    if pgrep -f -- "dnsmasq.*--interface=$BOXEN_NET( |$)" >/dev/null 2>&1; then
      ok "The DHCP server for $BOXEN_NET is running"
    else
      bad "No DHCP server runs for $BOXEN_NET, so new containers get no address and bxn create stops at \"Waiting for container networking\"" \
        "sudo systemctl restart incus"
    fi
  else
    skipped "The Incus server isn't on this machine, so its interfaces and DHCP aren't checked"
  fi

  # ufw drops DHCP and forwarding on a new bridge; bxn adds its rules once.
  if [[ "$(uname -s)" == Linux ]] && command -v ufw >/dev/null 2>&1 && grep -q '^ENABLED=yes' "$BOXEN_UFW_CONF" 2>/dev/null; then
    if [[ "$(incus network get "$BOXEN_NET" user.boxen.ufw 2>/dev/null)" == 1 ]]; then
      ok "ufw is on, and bxn added its rules for $BOXEN_NET"
    else
      bad "ufw is on, but bxn hasn't added its rules for $BOXEN_NET, so containers get no address" \
        "sudo ufw allow in on $BOXEN_NET to any port 67 proto udp; sudo ufw route allow in on $BOXEN_NET"
    fi
  fi

  # Two instances given one address: the second to start has no network.
  dups="$(for row in ${INSTANCES[@]+"${INSTANCES[@]}"}; do printf '%s\n' "$row"; done |
      awk -F'\t' '$3 != "-" {n[$3] = n[$3] (n[$3] == "" ? "" : ", ") $1; c[$3]++}
        END {for (a in c) if (c[a] > 1) print a "\t" n[a]}')"
  if [[ -n "$dups" ]]; then
    while IFS=$'\t' read -r ip c; do
      bad "$c share the address $ip; only one of them can be on the network" \
        "give one a free address: incus config device set <name> eth0 ipv4.address=<free address in $net>"
    done <<< "$dups"
  else
    ok "Every container has its own address"
  fi

  # Made by a bxn create that failed before it labelled them.
  for row in ${INSTANCES[@]+"${INSTANCES[@]}"}; do
    ip="$(inst_field "$row" 3)"
    in_subnet "$ip" "$net" || continue
    [[ "$(inst_field "$row" 4)" == boxen ]] && continue
    c="$(inst_field "$row" 1)"
    note "$c is on $BOXEN_NET but isn't labelled as bxn's, so bxn status, rm and short names treat it as another tool's (a create that failed partway?)" \
      "delete it: incus delete --force $c"
  done
}

# --- Egress ------------------------------------------------------------------

check_egress() {
  local egresses e st ctl row agent port listening known name eg tr acls a found
  # Egress containers whose proxy manager answered, and what it said: each
  # line is the egress container, a tab, then its status line.
  local answered="" ctl_all=""
  section "Egress"
  egresses="$(incus list user.boxen.role=egress --format csv --columns n 2>/dev/null)" || egresses=""
  if [[ -z "$egresses" ]]; then
    ok "No egress container yet; the first bxn create with an allowlist makes it"
  fi
  for e in $egresses; do
    st="$(incus list "^${e}$" --format csv --columns s 2>/dev/null)"
    if [[ "$st" != RUNNING ]]; then
      bad "$e is stopped, so allowlisted containers have no internet and bxn create can't lock new ones" "incus start $e"
      continue
    fi
    ok "$e is running"
    [[ "$(incus config get "$e" boot.autostart 2>/dev/null)" == true ]] ||
      note "$e doesn't start when the host boots, so allowlisted containers have no internet after a reboot" \
        "incus config set $e boot.autostart=true boot.autostart.priority=100"
    if [[ "$(incus config get "$e" user.boxen.egress.ready 2>/dev/null)" != 1 ]]; then
      note "$e's setup didn't finish" "the next bxn create with an allowlist finishes it"
      continue
    fi
    if ! ctl="$(egress_ctl "$e" status </dev/null 2>/dev/null)"; then
      bad "The proxy manager in $e doesn't answer" "incus restart $e, then bxn egress refresh --all"
      continue
    fi
    answered+="$e"$'\n'
    [[ -z "$ctl" ]] || ctl_all+="$(awk -v e="$e" 'NF {print e "\t" $0}' <<< "$ctl")"$'\n'
    # Proxies for containers that are gone: deleted with incus delete, not bxn rm.
    while IFS=$'\t' read -r agent port _ _ _ listening _; do
      [[ -n "$agent" ]] || continue
      known=0
      for row in ${INSTANCES[@]+"${INSTANCES[@]}"}; do
        [[ "$(inst_field "$row" 1)" == "$agent" && "$(inst_field "$row" 5)" == "$e" ]] && { known=1; break; }
      done
      [[ "$known" == 1 ]] && continue
      note "$e still runs a proxy (port $port) for $agent, which no longer uses it" \
        "incus exec $e -- $BOXEN_EGRESS_CTL remove $agent"
    done <<< "$ctl"
  done

  # Each allowlisted container: its egress container, proxy and any change
  # that didn't finish.
  for row in ${INSTANCES[@]+"${INSTANCES[@]}"}; do
    eg="$(inst_field "$row" 5)"
    [[ "$eg" != - ]] || continue
    name="$(inst_field "$row" 1)"
    tr="$(inst_field "$row" 6)"
    port="$(inst_field "$row" 7)"
    if [[ "$(inst_field "$row" 8)" == yes ]]; then
      note "$name's build was abandoned partway" "bxn rm $name, then create it again"
      continue
    fi
    if [[ "$tr" != - ]]; then
      bad "$name is partway through turning its allowlist on, so it stays stopped" "bxn egress refresh $name"
      continue
    fi
    if ! grep -qx "$eg" <<< "$egresses"; then
      bad "$name's proxy is in $eg, which doesn't exist, so $name has no internet"
      continue
    fi
    # Already reported above when it's stopped or doesn't answer.
    grep -qx "$eg" <<< "$answered" || continue
    found="$(awk -F'\t' -v e="$eg" -v a="$name" '$1 == e && $2 == a {sub(/^[^\t]*\t/, ""); print}' <<< "$ctl_all")"
    if [[ -z "$found" ]]; then
      bad "$eg has no proxy for $name, so $name has no internet" \
        "incus exec $eg -- $BOXEN_EGRESS_CTL add $name $port; then bxn egress refresh $name"
    elif [[ "$(inst_field "$row" 2)" == RUNNING && "$(cut -f6 <<< "$found")" != yes ]]; then
      bad "$name's proxy in $eg isn't listening, so $name has no internet" "bxn egress refresh $name"
    else
      ok "$name's proxy in $eg is in place"
    fi
  done

  # Rule sets bxn made for containers that are gone. They block nothing.
  acls="$(incus network acl list --format csv 2>/dev/null | cut -d, -f1)" || acls=""
  for a in $acls; do
    case "$a" in
      boxen-a-*)
        found=0
        for row in ${INSTANCES[@]+"${INSTANCES[@]}"}; do
          [[ "$(egress_agent_acl "$(inst_field "$row" 1)")" == "$a" ]] && { found=1; break; }
        done
        ;;
      "$BOXEN_EGRESS_DEFAULT" | "$BOXEN_EGRESS_DEFAULT"-*)
        found=0
        grep -qx "$a" <<< "$egresses" && found=1
        ;;
      *) continue ;;
    esac
    [[ "$found" == 1 ]] || note "Network rule set $a belongs to a container that's gone" "incus network acl delete $a"
  done
}

[[ $# -eq 0 ]] || case "$1" in -h | --help) usage 0 ;; *) usage 1 ;; esac

echo "bxn doctor: checking what would stop bxn creating or starting containers"
if check_incus; then
  check_lock
  if read_instances; then
    check_bridge
    check_egress
  fi
fi

echo ""
if (( FAILS > 0 )); then
  echo -e "${RED}$FAILS problem(s)${NC} would stop a create or start; ${WARNS} warning(s)."
  exit 1
fi
if (( WARNS > 0 )); then
  echo -e "Nothing blocks bxn; ${YELLOW}${WARNS} warning(s)${NC}."
else
  echo -e "${GREEN}All clear.${NC}"
fi
