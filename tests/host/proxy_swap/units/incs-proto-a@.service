[Unit]
Description=incs proxy prototype: agent a, generation %i

[Service]
Sockets=incs-proto-a.socket
Environment=EINHORN_MASTER_PID=1 EINHORN_FD_COUNT=1 EINHORN_FD_0=3 EINHORN_SOCK_PATH=/run/incs-proto-ack.sock
EnvironmentFile=-/etc/incs-proto/a/%i/env
ExecStart=/usr/local/libexec/incs-proto/incs-proxy-run a %i
TimeoutStopSec=3
DynamicUser=yes
ProtectSystem=strict
NoNewPrivileges=yes
