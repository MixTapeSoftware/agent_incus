#!/usr/bin/env bash
# tests/lib/fake_incus
# A stand-in for the `incus` CLI used by the shell tests. It keeps real state
# on disk so tests can assert outcomes (config keys, file contents) instead of
# only the calls that were made.
#
# State lives under $FAKE_INCUS_STATE:
#   calls.log                      one line per invocation (argv, space-joined)
#   exec.log                       one line per `exec`: "<instance> :: <command>"
#   exec-stdin/<n>                 stdin captured for the nth exec, when piped
#   instances/<name>/status        RUNNING | STOPPED
#   instances/<name>/ipv4          leased address
#   instances/<name>/config/<key>  one file per config key
#   instances/<name>/root/...      the instance filesystem
#   instances/<name>/root/etc/group   answers `getent group <name>`
#   instances/<name>/root/etc/id-G    answers `id -G <user>` (absent: exit 1)
#   instances/<name>/root/usr/bin/<tool>  answers `sh -c 'command -v <tool>'`
#   instances/<name>/profiles      profiles passed with -p at init/launch, one per line
#   instances/<name>/stopped/<unit>   a unit `systemctl stop` stopped (cleared at start)
#   images/<alias>/root/...        filesystem captured by `publish`
#   profiles/<name>/<key>          one file per profile config key
#   profiles/<name>/devices/<dev>/<key>  one file per profile device key
#   networks/<name>/<key>          one file per network config key
#   acls/<name>                    the YAML last given to `network acl edit`
#   gh.log                         arguments of each `gh` run inside an instance
#
# Knobs (env):
#   FAKE_INCUS_FAIL_EXEC   regex; an exec whose command matches exits 1
#   FAKE_INCUS_NEXT_IP     address handed to the next created instance
#   FAKE_INCUS_FAIL_CALL   regex; any invocation whose argv matches exits 1
#   FAKE_INCUS_VERSION     what `incus version` reports (default 6.19)
#   FAKE_INCUS_IMAGE_TYPE  the Type `incus image info` reports (default container)
#   FAKE_INCUS_FIREWALL    the firewall driver `incus info` reports (default nftables)
#   FAKE_INCUS_EXTENSIONS  API extensions `incus info` lists
#                          (default: network_bridge_acl_devices network_address_set)
set -uo pipefail

S="${FAKE_INCUS_STATE:?FAKE_INCUS_STATE must be set}"
mkdir -p "$S/instances" "$S/exec-stdin"
printf '%s\n' "$*" >> "$S/calls.log"

if [[ -n "${FAKE_INCUS_FAIL_CALL:-}" && "$*" =~ $FAKE_INCUS_FAIL_CALL ]]; then
  echo "Error: injected failure" >&2
  exit 1
fi

die() { echo "Error: $*" >&2; exit 1; }
inst_dir() { echo "$S/instances/$1"; }
need_inst() { [[ -d "$(inst_dir "$1")" ]] || die "Instance not found: $1"; }

# Split "<instance>/<path>" into the fake filesystem location.
fs_path() {
  local spec="$1" name path
  name="${spec%%/*}"
  path="/${spec#*/}"
  need_inst "$name"
  echo "$(inst_dir "$name")/root$path"
}

create_instance() {
  local name="$1" status="$2" d
  d="$(inst_dir "$name")"
  [[ -d "$d" ]] && die "Instance already exists: $name"
  mkdir -p "$d/config" "$d/root"
  echo "$status" > "$d/status"
  # A counter that only grows, so an address is never handed out twice, even
  # after an instance is deleted.
  local n=0
  [[ -f "$S/ip-counter" ]] && n="$(cat "$S/ip-counter")"
  n=$((n + 1))
  echo "$n" > "$S/ip-counter"
  # Last octet stays within 10-249; the third octet advances every 240.
  echo "${FAKE_INCUS_NEXT_IP:-10.99.$((n / 240)).$((10 + n % 240))}" > "$d/ipv4"
}

cmd="${1:-}"; shift || true
case "$cmd" in
  info)
    if [[ $# -eq 0 ]]; then
      # Server info: the API extensions, then the environment.
      echo "api_extensions:"
      for e in ${FAKE_INCUS_EXTENSIONS-network_bridge_acl_devices network_address_set}; do echo "- $e"; done
      echo "environment:"
      echo "  firewall: ${FAKE_INCUS_FIREWALL:-nftables}"
      echo "  server_version: \"${FAKE_INCUS_VERSION:-6.19}\""
      exit 0
    fi
    need_inst "${1:-}" 2>/dev/null || exit 1
    echo "Name: $1"
    ;;

  init|launch)
    # incus init <image> <name> [flags]
    name="${2:-}"
    [[ -n "$name" ]] || die "name required"
    profiles=(); devs=()
    shift 2
    while [[ $# -gt 0 ]]; do
      if [[ "$1" == "-p" || "$1" == "--profile" ]]; then
        [[ "$2" == "default" || -d "$S/profiles/$2" ]] || die "Profile not found: $2"
        profiles+=("$2")
        shift 2
      elif [[ "$1" == "-d" || "$1" == "--device" ]]; then
        devs+=("$2")
        shift 2
      else
        shift
      fi
    done
    if [[ "$cmd" == "launch" ]]; then create_instance "$name" RUNNING
    else create_instance "$name" STOPPED; fi
    printf '%s\n' ${profiles[@]+"${profiles[@]}"} > "$(inst_dir "$name")/profiles"
    # -d <device>,<key>=<value>: an instance device override at create.
    for d in ${devs[@]+"${devs[@]}"}; do
      kv="${d#*,}"
      printf '%s' "${kv#*=}" > "$(inst_dir "$name")/config/devices.${d%%,*}.${kv%%=*}"
      if [[ "$d" == eth0,ipv4.address=* ]]; then echo "${kv#*=}" > "$(inst_dir "$name")/ipv4"; fi
    done
    ;;

  profile)
    sub="${1:-}"; name="${2:-}"; shift 2 || true
    p="$S/profiles/$name"
    if [[ "$sub" == "device" ]]; then
      # incus profile device add|set|show <profile> [<device> ...]
      op="$name"; name="${1:-}"; p="$S/profiles/$name"; shift || true
      [[ -d "$p" ]] || die "Profile not found: $name"
      case "$op" in
        show)
          for dd in "$p/devices"/*/; do
            [[ -d "$dd" ]] || continue
            echo "$(basename "$dd"):"
            for f in "$dd"*; do echo "  $(basename "$f"): $(cat "$f")"; done
          done
          ;;
        add)
          dev="$1"; shift
          [[ -d "$p/devices/$dev" ]] && die "Device already exists: $dev"
          mkdir -p "$p/devices/$dev"; printf '%s' "$1" > "$p/devices/$dev/type"; shift
          for kv in "$@"; do printf '%s' "${kv#*=}" > "$p/devices/$dev/${kv%%=*}"; done
          ;;
        set)
          dev="$1"; shift
          [[ -d "$p/devices/$dev" ]] || die "Device doesn't exist: $dev"
          for kv in "$@"; do printf '%s' "${kv#*=}" > "$p/devices/$dev/${kv%%=*}"; done
          ;;
        *) die "unsupported profile device op: $op" ;;
      esac
      exit 0
    fi
    case "$sub" in
      show)   [[ -d "$p" ]] || die "Profile not found: $name" ;;
      create) [[ -d "$p" ]] && die "Profile already exists: $name"; mkdir -p "$p" ;;
      set)
        [[ -d "$p" ]] || die "Profile not found: $name"
        for kv in "$@"; do printf '%s' "${kv#*=}" > "$p/${kv%%=*}"; done
        ;;
      unset)
        [[ -d "$p" ]] || die "Profile not found: $name"
        [[ -f "$p/$1" ]] || die "Key not set: $1"
        rm -f "$p/$1"
        ;;
      *) die "unsupported profile subcommand: $sub" ;;
    esac
    ;;

  # Units come back up when the instance boots.
  start)   need_inst "$1"; echo RUNNING > "$(inst_dir "$1")/status"; rm -rf "$(inst_dir "$1")/stopped" ;;
  stop)    need_inst "$1"; echo STOPPED > "$(inst_dir "$1")/status" ;;
  restart) need_inst "$1"; echo RUNNING > "$(inst_dir "$1")/status"; rm -rf "$(inst_dir "$1")/stopped" ;;

  delete)
    name=""
    for a in "$@"; do [[ "$a" == -* ]] || name="$a"; done
    need_inst "$name"
    rm -rf "$(inst_dir "$name")"
    ;;

  image)
    [[ "$1" == info && -d "$S/images/$2" ]] || die "Image not found: ${2:-}"
    echo "Type: ${FAKE_INCUS_IMAGE_TYPE:-container}"
    ;;

  publish)
    # incus publish <name> --alias <alias>: snapshot the filesystem as it is now.
    name="$1"; alias=""
    while [[ $# -gt 0 ]]; do
      [[ "$1" == "--alias" ]] && alias="$2"
      shift
    done
    need_inst "$name"
    [[ "$(cat "$(inst_dir "$name")/status")" == "STOPPED" ]] || die "Instance must be stopped"
    mkdir -p "$S/images/$alias"
    cp -R "$(inst_dir "$name")/root" "$S/images/$alias/root"
    ;;

  config)
    sub="${1:-}"; shift || true
    case "$sub" in
      set)
        name="$1"; shift
        need_inst "$name"
        if [[ $# -eq 1 ]]; then key="${1%%=*}"; val="${1#*=}"
        else key="$1"; val="$2"; fi
        printf '%s' "$val" > "$(inst_dir "$name")/config/$key"
        ;;
      show)
        need_inst "$1"
        echo "config:"
        for f in "$(inst_dir "$1")/config"/*; do
          [[ -f "$f" ]] && echo "  $(basename "$f"): $(cat "$f")"
        done
        ;;
      get)
        need_inst "$1"
        f="$(inst_dir "$1")/config/$2"
        [[ -f "$f" ]] && cat "$f"
        echo
        ;;
      unset)
        need_inst "$1"
        rm -f "$(inst_dir "$1")/config/$2"
        ;;
      device)
        # incus config device override <name> <device> key=value
        # incus config device add <name> <device> <type> key=value...
        # incus config device remove <name> <device>
        op="$1"; name="$2"; dev="$3"; shift 3
        need_inst "$name"
        case "$op" in
          override)
            kv="${1:-}"
            printf '%s' "${kv#*=}" > "$(inst_dir "$name")/config/devices.$dev.${kv%%=*}"
            ;;
          add)
            [[ -f "$(inst_dir "$name")/config/devices.$dev.type" ]] && die "Device already exists: $dev"
            printf '%s' "$1" > "$(inst_dir "$name")/config/devices.$dev.type"; shift
            for kv in "$@"; do
              printf '%s' "${kv#*=}" > "$(inst_dir "$name")/config/devices.$dev.${kv%%=*}"
            done
            ;;
          remove)
            rm -f "$(inst_dir "$name")/config/devices.$dev."*
            ;;
          *) die "unsupported device op: $op" ;;
        esac
        ;;
      *) die "unsupported config subcommand: $sub" ;;
    esac
    ;;

  list)
    filters=(); columns="ns"
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --format)  shift 2 ;;
        --columns|-c) columns="$2"; shift 2 ;;
        -*)        shift ;;
        *)         filters+=("$1"); shift ;;
      esac
    done
    for d in "$S/instances"/*/; do
      [[ -d "$d" ]] || continue
      name="$(basename "$d")"
      status="$(cat "$d/status")"
      show=1
      for f in ${filters[@]+"${filters[@]}"}; do
        if [[ "$f" == *=* ]]; then
          key="${f%%=*}"; want="${f#*=}"
          if [[ "$key" == "status" ]]; then
            [[ "$(echo "$status" | tr 'A-Z' 'a-z')" == "$(echo "$want" | tr 'A-Z' 'a-z')" ]] || show=0
          else
            have=""
            [[ -f "$d/config/$key" ]] && have="$(cat "$d/config/$key")"
            # Incus matches these server side as a case-insensitive regex,
            # anchored unless the value has its own ^ or $
            # (internal/filter/match.go, DefaultParseRegexp). Names used here
            # contain no regex metacharacters, so equality covers it.
            [[ "$(echo "$have" | tr 'A-Z' 'a-z')" == "$(echo "$want" | tr 'A-Z' 'a-z')" ]] || show=0
          fi
        else
          [[ "$name" =~ $f ]] || show=0
        fi
      done
      [[ "$show" == "1" ]] || continue
      row=""
      for ((i=0; i<${#columns}; i++)); do
        case "${columns:$i:1}" in
          n) cell="$name" ;;
          s) cell="$status" ;;
          4) if [[ "$status" == "RUNNING" ]]; then cell="$(cat "$d/ipv4") (eth0)"; else cell=""; fi ;;
          *) cell="" ;;
        esac
        row+="${row:+,}$cell"
      done
      echo "$row"
    done
    ;;

  file)
    sub="${1:-}"; shift || true
    args=()
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --mode|--uid|--gid) shift 2 ;;
        --mode=*|--uid=*|--gid=*|-p|--create-dirs|-q|--quiet) shift ;;
        *) args+=("$1"); shift ;;
      esac
    done
    case "$sub" in
      push)
        src="${args[0]}"; dst="$(fs_path "${args[1]}")" || exit 1
        mkdir -p "$(dirname "$dst")"
        if [[ "$src" == "-" ]]; then cat > "$dst"; else cp "$src" "$dst"; fi
        ;;
      pull)
        src="$(fs_path "${args[0]}")" || exit 1
        [[ -f "$src" ]] || die "Not Found"
        if [[ "${args[1]}" == "-" ]]; then cat "$src"; else cp "$src" "${args[1]}"; fi
        ;;
      delete)
        dst="$(fs_path "${args[0]}")" || exit 1
        [[ -e "$dst" ]] || die "Not Found"
        rm -f "$dst"
        ;;
      *) die "unsupported file subcommand: $sub" ;;
    esac
    ;;

  exec)
    name="$1"; shift
    need_inst "$name"
    [[ "$(cat "$(inst_dir "$name")/status")" == "RUNNING" ]] || die "Instance is not running"
    while [[ $# -gt 0 && "$1" != "--" ]]; do shift; done
    shift || true
    command_line="$*"
    echo "$name :: $command_line" >> "$S/exec.log"
    n=$(wc -l < "$S/exec.log" | tr -d ' ')
    if [[ ! -t 0 ]]; then cat > "$S/exec-stdin/$n"; fi

    if [[ -n "${FAKE_INCUS_FAIL_EXEC:-}" && "$command_line" =~ $FAKE_INCUS_FAIL_EXEC ]]; then
      exit 1
    fi

    root="$(inst_dir "$name")/root"
    stub="$S/stub-bin"; mkdir -p "$stub"
    printf '#!/bin/sh\nexit 0\n' > "$stub/systemctl"
    printf '#!/bin/sh\necho "$*" >> "%s/gh.log"\nexit 0\n' "$S" > "$stub/gh"
    chmod +x "$stub/systemctl" "$stub/gh"

    # `su - <user> [-s <shell>] [-c <cmd>]`: run it for real with HOME inside
    # the fake filesystem, so commands that edit ~/ files have real effects.
    if [[ "${1:-}" == "su" ]]; then
      shift; su_user=""; su_cmd=""; has_cmd=0
      while [[ $# -gt 0 ]]; do
        case "$1" in
          -)  shift ;;
          -s) shift 2 ;;
          -c) su_cmd="$2"; has_cmd=1; shift 2 ;;
          *)  su_user="$1"; shift ;;
        esac
      done
      home="$root/home/$su_user"; mkdir -p "$home"
      stdin_file="$S/exec-stdin/$n"; [[ -f "$stdin_file" ]] || stdin_file=/dev/null
      if [[ "$has_cmd" == "1" ]]; then
        env -i HOME="$home" USER="$su_user" PATH="$stub:$PATH" sh -c "$su_cmd" < "$stdin_file"
      else
        env -i HOME="$home" USER="$su_user" PATH="$stub:$PATH" sh < "$stdin_file"
      fi
      exit $?
    fi

    case "$command_line" in
      "getent passwd "*)
        user="${command_line#getent passwd }"
        echo "$user:x:1000:1000::/home/$user:/usr/bin/zsh"
        ;;
      "getent group "*)
        grep "^${command_line#getent group }:" "$root/etc/group" 2>/dev/null || exit 2
        ;;
      "id -G "*)
        # The user's group IDs, primary first, as a test wrote them.
        cat "$root/etc/id-G" 2>/dev/null || exit 1
        ;;
      "systemctl stop "*)
        mkdir -p "$(inst_dir "$name")/stopped"
        touch "$(inst_dir "$name")/stopped/${command_line##* }"
        ;;
      "systemctl start "*) rm -f "$(inst_dir "$name")/stopped/${command_line##* }" ;;
      "systemctl is-active "*)
        if [[ -f "$(inst_dir "$name")/stopped/${command_line##* }" ]]; then echo inactive; exit 3; fi
        echo active
        ;;
      # File checks and archive moves, against the fake filesystem.
      "sh -c test -"[df]" "*" && echo yes || echo no")
        set -- ${command_line#sh -c test }
        if [[ ( "$1" == -d && -d "$root$2" ) || ( "$1" == -f && -f "$root$2" ) ]]; then echo yes; else echo no; fi
        ;;
      # A tool is installed when the fixture put it on a bin path.
      "sh -c command -v "*)
        tool="${command_line#sh -c command -v }"
        for d in /usr/local/bin /usr/bin /bin; do
          [[ -f "$root$d/$tool" ]] && { echo "$d/$tool"; exit 0; }
        done
        exit 1
        ;;
      "test -d "*) [[ -d "$root${command_line#test -d }" ]] ;;
      "test -f "*) [[ -f "$root${command_line#test -f }" ]] ;;
      "rm -rf /"*) rm -rf "$root${command_line#rm -rf }" ;;
      "ls -A /"*)  ls -A "$root${command_line#ls -A }" ;;
      "mkdir -p /"*) mkdir -p "$root${command_line#mkdir -p }" ;;
      "tar -C "*|"tar --no-same-owner -C "*)
        # tar [--no-same-owner] -C <dir> -cf - <name>   |   ... -C <dir> -xf -
        command_line="${command_line#tar }"; command_line="${command_line#--no-same-owner }"
        set -- ${command_line#-C }
        case "$2" in
          -cf) tar -C "$root$1" -cf - "$4" ;;
          -xf) stdin_file="$S/exec-stdin/$n"; [[ -f "$stdin_file" ]] || stdin_file=/dev/null
               mkdir -p "$root$1"; tar -C "$root$1" -xf - < "$stdin_file" ;;
          *)   die "fake_incus: unsupported tar: $command_line" ;;
        esac
        ;;
      *) : ;;
    esac
    ;;

  network)
    sub="${1:-}"; shift || true
    if [[ "$sub" == "acl" ]]; then
      op="${1:-}"; name="${2:-}"
      a="$S/acls/$name"
      case "$op" in
        show)   [[ -f "$a" ]] || die "Network ACL not found"; cat "$a" ;;
        create) [[ -f "$a" ]] && die "The network ACL already exists"; mkdir -p "$S/acls"; : > "$a" ;;
        edit)   [[ -f "$a" ]] || die "Network ACL not found"; cat > "$a" ;;
        delete) [[ -f "$a" ]] || die "Network ACL not found"; rm -f "$a" ;;
        *) die "unsupported network acl op: $op" ;;
      esac
      exit 0
    fi
    name="${1:-}"; shift || true
    n="$S/networks/$name"
    case "$sub" in
      create)
        [[ -d "$n" ]] && die "The network already exists"
        mkdir -p "$n"
        for kv in "$@"; do printf '%s' "${kv#*=}" > "$n/${kv%%=*}"; done
        ;;
      show) [[ -d "$n" ]] || die "Network not found" ;;
      get)
        [[ -d "$n" ]] || die "Network not found"
        [[ -f "$n/$1" ]] && cat "$n/$1"
        echo
        ;;
      set)
        [[ -d "$n" ]] || die "Network not found"
        for kv in "$@"; do printf '%s' "${kv#*=}" > "$n/${kv%%=*}"; done
        ;;
      list)
        # Called as `network list --format csv`, so $name holds a flag.
        for d in "$S/networks"/*/; do
          [[ -d "$d" ]] || continue
          echo "$(basename "$d"),bridge,YES,$(cat "$d/ipv4.address" 2>/dev/null),,,0,CREATED"
        done
        ;;
      list-leases)
        [[ -d "$n" ]] || die "Network not found"
        for d in "$S/instances"/*/; do
          f="$d/config/devices.eth0.ipv4.address"
          [[ -f "$f" ]] && echo "$(basename "$d"),00:16:3e:00:00:01,$(cat "$f"),STATIC,"
        done
        ;;
      *) die "unsupported network subcommand: $sub" ;;
    esac
    ;;

  version)
    echo "Client version: ${FAKE_INCUS_VERSION:-6.19}"
    echo "Server version: ${FAKE_INCUS_VERSION:-6.19}"
    ;;

  *) die "fake_incus: unsupported command: $cmd" ;;
esac
