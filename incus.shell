#!/bin/bash
set -euo pipefail

WITH_SUDO=0
CONTAINER=""
CMD_ARGS=()

# Flags are only recognized before the container name; everything after it
# belongs to the command.
while [[ $# -gt 0 ]]; do
  if [[ -n "$CONTAINER" ]]; then
    CMD_ARGS+=("$1")
  elif [[ "$1" == "--with-sudo" ]]; then
    WITH_SUDO=1
  else
    CONTAINER="$1"
  fi
  shift
done

CONTAINER="${CONTAINER:-${CLAUDE_CONTAINER:-}}"
if [[ -z "$CONTAINER" ]]; then
  echo "Usage: $(basename "$0") [--with-sudo] <container> [command...]"
  exit 1
fi
STATUS=$(incus list "^${CONTAINER}$" --format csv --columns s 2>/dev/null)
if [[ -z "$STATUS" ]]; then
  echo "Container not found: $CONTAINER" >&2
  exit 1
fi
if [[ "$STATUS" != "RUNNING" ]]; then
  echo "Starting $CONTAINER..."
  incus start "$CONTAINER"
  attempts=0
  while ! timeout 5 incus exec "$CONTAINER" -- true </dev/null &>/dev/null; do
    sleep 1
    attempts=$((attempts + 1))
    if [[ $attempts -ge 30 ]]; then
      echo "Timed out waiting for $CONTAINER to be ready" >&2
      exit 1
    fi
  done
fi

HOST_USER="$(id -un)"
HOST_UID="$(id -u)"
HOST_GID="$(id -g)"

# `incus exec --group` takes a single GID, so it cannot carry supplementary
# groups (docker, _sudo). Enter as root and let setpriv set the whole group
# list before dropping to the user. setpriv execs the shell directly, so incus
# still manages the PTY end-to-end (no su-style middleman that eats Ctrl+C).
USER_GIDS=$(incus exec "$CONTAINER" -- id -G "$HOST_USER" 2>/dev/null | tr ' ' ',' || true)
USER_GIDS="${USER_GIDS:-$HOST_GID}"
PRIMARY_GID="${USER_GIDS%%,*}"   # id -G lists the primary group first

if [[ "$WITH_SUDO" == "1" ]]; then
  SUDO_GID=$(incus exec "$CONTAINER" -- getent group _sudo 2>/dev/null | cut -d: -f3 || true)
  if [[ -z "$SUDO_GID" ]]; then
    echo "Error: _sudo group not found in container (was it built with a recent incus.init?)" >&2
    exit 1
  fi
  USER_GIDS+=",$SUDO_GID"
fi

RUN_AS=(setpriv --reuid="$HOST_UID" --regid="$PRIMARY_GID" --groups="$USER_GIDS" --inh-caps=-all --)

if [[ ${#CMD_ARGS[@]} -gt 0 ]]; then
  exec incus exec "$CONTAINER" \
    --cwd /workspace \
    --env "HOME=/home/$HOST_USER" \
    --env "USER=$HOST_USER" \
    -- "${RUN_AS[@]}" zsh -lic "${CMD_ARGS[*]}"
else
  exec incus exec "$CONTAINER" \
    --cwd /workspace \
    --env "HOME=/home/$HOST_USER" \
    --env "USER=$HOST_USER" \
    -- "${RUN_AS[@]}" zsh -li
fi
